@model HardwareManagementSystem.ViewModels.PagedResult<HardwareManagementSystem.Models.Branch>
@using HardwareManagementSystem.ViewModels

@{
    ViewData["Title"] = "Branches";
}

<div class="hb-card mb-4">

    <div class="hb-card-header">
        <div>
            <h2 class="hb-section-title">Branch Management</h2>
            <div class="hb-section-subtitle">
                Manage store branches � each branch has its own stock and transactions
            </div>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addBranchModal">
            <i class="bi bi-plus-circle me-1"></i>
            Add Branch
        </button>
    </div>

    <div class="hb-card-body">

        <!-- SEARCH -->
        <form method="get" asp-controller="Branches" asp-action="Index" class="mb-4">
            <div class="row g-3">
                <div class="col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="searchTerm" class="form-control border-start-0"
                               value="@Model.SearchTerm" placeholder="Search branch name or code..." />
                    </div>
                </div>
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <input type="hidden" name="pageNumber" value="1" />
                <div class="col-auto">
                    <button class="btn btn-primary" type="submit" data-no-disable="true">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </button>
                </div>
            </div>
        </form>

        <!-- TABLE -->
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Branch Name</th>
                        <th>Manager</th>
                        <th>Address</th>
                        <th>Contact</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th width="150">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var branch in Model.Items)
                        {
                            <tr>
                                <td><code class="text-primary fw-semibold">@branch.Code</code></td>
                                <td><strong>@branch.Name</strong></td>
                                <td class="small">@(branch.ManagerName ?? "�")</td>
                                <td class="text-muted small">@(branch.Address ?? "�")</td>
                                <td class="small">@(branch.ContactNumber ?? "�")</td>
                                <td>
                                    @if (branch.IsMainBranch)
                                    {
                                        <span class="badge badge-soft-primary">
                                            <i class="bi bi-star-fill me-1"></i>Main Branch
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-secondary">Branch</span>
                                    }
                                </td>
                                <td>
                                    @if (branch.IsActive)
                                    {
                                        <span class="badge badge-soft-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-danger">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <a asp-action="Details" asp-route-id="@branch.Id"
                                           class="btn btn-sm btn-outline-primary" title="View Stock">
                                            <i class="bi bi-box-seam"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-secondary" title="Edit"
                                                data-bs-toggle="modal" data-bs-target="#editBranchModal"
                                                data-id="@branch.Id"
                                                data-name="@branch.Name"
                                                data-code="@branch.Code"
                                                data-address="@branch.Address"
                                                data-contact="@branch.ContactNumber"
                                                data-manager="@branch.ManagerName"
                                                data-ismain="@branch.IsMainBranch.ToString().ToLower()"
                                                data-isactive="@branch.IsActive.ToString().ToLower()">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @if (branch.IsActive)
                                        {
                                            @if (!branch.IsMainBranch)
                                            {
                                                <button class="btn btn-sm btn-outline-info" title="Set as Main Branch"
                                                        onclick="confirmSetMain(@branch.Id, '@Html.Raw(branch.Name.Replace("'", "\\'"))')">
                                                    <i class="bi bi-star"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-warning" title="Deactivate Branch"
                                                        onclick="confirmDeactivateBranch(@branch.Id, '@Html.Raw(branch.Name.Replace("'", "\\'"))')">
                                                    <i class="bi bi-pause-circle"></i>
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-success" title="Activate Branch"
                                                    onclick="confirmActivateBranch(@branch.Id, '@Html.Raw(branch.Name.Replace("'", "\\'"))')">
                                                <i class="bi bi-play-circle"></i>
                                            </button>
                                        }
                                        @if (!branch.IsMainBranch)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" title="Delete"
                                                    onclick="confirmDeleteBranch(@branch.Id, '@Html.Raw(branch.Name.Replace("'", "\\'"))')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-building fs-1 d-block mb-2"></i>
                                No branches found. Add your first branch above.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Pagination", PaginationMeta.From(Model, "Branches", "Index",
            new Dictionary<string, string?> { ["searchTerm"] = Model.SearchTerm }))

    </div>
</div>

<!-- ADD BRANCH MODAL -->
<div class="modal fade" id="addBranchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold">Add Branch</h5>
                    <div class="text-muted small">Create a new store branch</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Branch Code <span class="text-danger">*</span></label>
                            <input type="text" name="code" class="form-control text-uppercase"
                                   placeholder="e.g. MAIN, BR01" maxlength="20" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Branch Name <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control"
                                   placeholder="e.g. Main Branch � Cebu City" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Address</label>
                            <input type="text" name="address" class="form-control"
                                   placeholder="Street, City, Province" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Contact Number</label>
                            <input type="text" name="contactNumber" class="form-control"
                                   placeholder="0917-000-0000" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Branch Manager</label>
                            <input type="text" name="managerName" class="form-control"
                                   placeholder="Manager's full name" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="isMainBranch"
                                       value="true" id="addIsMain" />
                                <label class="form-check-label fw-semibold" for="addIsMain">
                                    Set as Main Branch
                                    <span class="text-muted small fw-normal">(only one branch can be main at a time)</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>Add Branch
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT BRANCH MODAL -->
<div class="modal fade" id="editBranchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold">Edit Branch</h5>
                    <div class="text-muted small">Update branch details</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editBranchId" name="id" />
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Branch Code <span class="text-danger">*</span></label>
                            <input type="text" id="editBranchCode" name="code" class="form-control text-uppercase"
                                   maxlength="20" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Branch Name <span class="text-danger">*</span></label>
                            <input type="text" id="editBranchName" name="name" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Address</label>
                            <input type="text" id="editBranchAddress" name="address" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Contact Number</label>
                            <input type="text" id="editBranchContact" name="contactNumber" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Branch Manager</label>
                            <input type="text" id="editBranchManager" name="managerName" class="form-control"
                                   placeholder="Manager's full name" />
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="isMainBranch"
                                       value="true" id="editIsMain" />
                                <label class="form-check-label fw-semibold" for="editIsMain">Main Branch</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="isActive"
                                       value="true" id="editIsActive" />
                                <label class="form-check-label fw-semibold" for="editIsActive">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- DELETE FORM -->
<form id="deleteBranchForm" asp-action="Delete" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteBranchId" name="id" />
</form>

<!-- ACTIVATE BRANCH FORM -->
<form id="activateBranchForm" asp-action="ActivateBranch" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" id="activateBranchId" name="id" />
</form>

<!-- DEACTIVATE BRANCH FORM -->
<form id="deactivateBranchForm" asp-action="DeactivateBranch" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deactivateBranchId" name="id" />
</form>

<!-- SET MAIN BRANCH FORM -->
<form id="setMainBranchForm" asp-action="SetMainBranch" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" id="setMainBranchId" name="id" />
</form>

@section Scripts {
    <script>
        // Populate edit modal
        document.getElementById('editBranchModal').addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            document.getElementById('editBranchId').value = btn.dataset.id;
            document.getElementById('editBranchCode').value = btn.dataset.code;
            document.getElementById('editBranchName').value = btn.dataset.name;
            document.getElementById('editBranchAddress').value = btn.dataset.address || '';
            document.getElementById('editBranchContact').value = btn.dataset.contact || '';
            document.getElementById('editBranchManager').value = btn.dataset.manager || '';
            document.getElementById('editIsMain').checked = btn.dataset.ismain === 'true';
            document.getElementById('editIsActive').checked = btn.dataset.isactive === 'true';
        });

        function confirmDeleteBranch(id, name) {
            Swal.fire({
                title: 'Delete Branch?',
                html: `Are you sure you want to delete <strong>${name}</strong>?<br>
                       <small class="text-muted">Branches with transactions will be deactivated instead.</small>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel'
            }).then(result => {
                if (result.isConfirmed) {
                    document.getElementById('deleteBranchId').value = id;
                    document.getElementById('deleteBranchForm').requestSubmit();
                }
            });
        }

        function confirmActivateBranch(id, name) {
            Swal.fire({
                title: 'Activate Branch?',
                html: `Restore <strong>${name}</strong> to active status?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#16a34a',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Yes, Activate',
                cancelButtonText: 'Cancel'
            }).then(result => {
                if (result.isConfirmed) {
                    document.getElementById('activateBranchId').value = id;
                    document.getElementById('activateBranchForm').requestSubmit();
                }
            });
        }

        function confirmDeactivateBranch(id, name) {
            Swal.fire({
                title: 'Deactivate Branch?',
                html: `<strong>${name}</strong> will no longer be available for transactions.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d97706',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Yes, Deactivate',
                cancelButtonText: 'Cancel'
            }).then(result => {
                if (result.isConfirmed) {
                    document.getElementById('deactivateBranchId').value = id;
                    document.getElementById('deactivateBranchForm').requestSubmit();
                }
            });
        }

        function confirmSetMain(id, name) {
            Swal.fire({
                title: 'Set as Main Branch?',
                html: `<strong>${name}</strong> will become the main branch.<br>
                       <small class="text-muted">The current main branch will be demoted.</small>`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#2563eb',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Yes, Set as Main',
                cancelButtonText: 'Cancel'
            }).then(result => {
                if (result.isConfirmed) {
                    document.getElementById('setMainBranchId').value = id;
                    document.getElementById('setMainBranchForm').requestSubmit();
                }
            });
        }
    </script>
}
