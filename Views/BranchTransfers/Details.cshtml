@model HardwareManagementSystem.Models.BranchTransfer

@{
    ViewData["Title"] = $"Transfer {Model.TransferNumber}";
    var branchStocks = ViewBag.BranchStocks as Dictionary<int, decimal> ?? new();
}

<div class="hb-card mb-4">

    <div class="hb-card-header">
        <div>
            <h2 class="hb-section-title">
                Transfer <code>@Model.TransferNumber</code>
            </h2>
            <div class="hb-section-subtitle">
                @Model.FromBranch?.Name
                <i class="bi bi-arrow-right mx-2"></i>
                @Model.ToBranch?.Name
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="PrintSlip" asp-route-id="@Model.Id"
               class="btn btn-outline-secondary" target="_blank">
                <i class="bi bi-printer me-1"></i>Print Slip
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back
            </a>

            @if (Model.Status == "Pending")
            {
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-success"
                            onclick="confirmAction('Approve', '@Model.TransferNumber', this)">
                        <i class="bi bi-check-circle me-1"></i>Approve
                    </button>
                </form>
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-outline-danger"
                            onclick="confirmAction('Cancel', '@Model.TransferNumber', this)">
                        <i class="bi bi-x-circle me-1"></i>Cancel
                    </button>
                </form>
            }
            @if (Model.Status == "Approved")
            {
                <form asp-action="Complete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-primary"
                            onclick="confirmAction('Complete', '@Model.TransferNumber', this)">
                        <i class="bi bi-box-arrow-right me-1"></i>Complete Transfer
                    </button>
                </form>
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-outline-danger"
                            onclick="confirmAction('Cancel', '@Model.TransferNumber', this)">
                        <i class="bi bi-x-circle me-1"></i>Cancel
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="hb-card-body">

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="text-muted small fw-semibold text-uppercase mb-1">Status</div>
                @switch (Model.Status)
                {
                    case "Pending":
                        <span class="badge badge-soft-warning fs-6">Pending</span>
                        break;
                    case "Approved":
                        <span class="badge badge-soft-primary fs-6">Approved</span>
                        break;
                    case "Completed":
                        <span class="badge badge-soft-success fs-6">Completed</span>
                        break;
                    case "Cancelled":
                        <span class="badge badge-soft-danger fs-6">Cancelled</span>
                        break;
                }
            </div>
            <div class="col-md-3">
                <div class="text-muted small fw-semibold text-uppercase mb-1">From Branch</div>
                <strong>@Model.FromBranch?.Name</strong>
                <div class="text-muted small">@Model.FromBranch?.Code</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small fw-semibold text-uppercase mb-1">To Branch</div>
                <strong>@Model.ToBranch?.Name</strong>
                <div class="text-muted small">@Model.ToBranch?.Code</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small fw-semibold text-uppercase mb-1">Created</div>
                <strong>@Model.CreatedAtUtc.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</strong>
                <div class="text-muted small">by @Model.CreatedByUserName</div>
            </div>
            @if (Model.ApprovedAtUtc.HasValue)
            {
                <div class="col-md-3">
                    <div class="text-muted small fw-semibold text-uppercase mb-1">Approved</div>
                    <strong>@Model.ApprovedAtUtc.Value.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</strong>
                </div>
            }
            @if (Model.CompletedAtUtc.HasValue)
            {
                <div class="col-md-3">
                    <div class="text-muted small fw-semibold text-uppercase mb-1">Completed</div>
                    <strong>@Model.CompletedAtUtc.Value.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</strong>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="col-12">
                    <div class="text-muted small fw-semibold text-uppercase mb-1">Notes</div>
                    <p class="mb-0">@Model.Notes</p>
                </div>
            }
        </div>

        <h6 class="fw-bold mb-3"><i class="bi bi-list-ul me-1"></i>Transfer Items</h6>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Unit</th>
                        <th class="text-end">Transfer Qty</th>
                        @if (Model.Status != "Completed" && Model.Status != "Cancelled")
                        {
                            <th class="text-end">Current Source Stock</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ti in Model.BranchTransferItems)
                    {
                        var currentStock = branchStocks.TryGetValue(ti.ProductId, out var s) ? s : 0;
                        var hasEnough = currentStock >= ti.Quantity;
                        <tr class="@(!hasEnough && Model.Status != "Completed" && Model.Status != "Cancelled" ? "table-warning" : "")">
                            <td>
                                <strong>@ti.Product?.ItemName</strong>
                                <div class="text-muted small"><code>@ti.Product?.ItemCode</code></div>
                            </td>
                            <td class="small">@(ti.Product?.Unit?.ShortName ?? "�")</td>
                            <td class="text-end fw-semibold">@ti.Quantity.ToString("0.###")</td>
                            @if (Model.Status != "Completed" && Model.Status != "Cancelled")
                            {
                                <td class="text-end">
                                    <span class="@(hasEnough ? "text-success" : "text-danger fw-bold")">
                                        @currentStock.ToString("0.###")
                                    </span>
                                    @if (!hasEnough)
                                    {
                                        <span class="badge badge-soft-danger ms-1">Insufficient</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function confirmAction(action, transferNumber, btn) {
            const messages = {
                'Approve': { title: 'Approve Transfer?', text: `Approve transfer <strong>${transferNumber}</strong>? It will be ready to complete.`, icon: 'question', color: '#16a34a', btnText: 'Yes, Approve' },
                'Complete': { title: 'Complete Transfer?', text: `Complete transfer <strong>${transferNumber}</strong>? This will immediately move stock between branches.`, icon: 'warning', color: '#2563eb', btnText: 'Yes, Complete' },
                'Cancel': { title: 'Cancel Transfer?', text: `Cancel transfer <strong>${transferNumber}</strong>? This cannot be undone.`, icon: 'warning', color: '#dc2626', btnText: 'Yes, Cancel' }
            };
            const m = messages[action];
            Swal.fire({
                title: m.title,
                html: m.text,
                icon: m.icon,
                showCancelButton: true,
                confirmButtonColor: m.color,
                cancelButtonColor: '#6b7280',
                confirmButtonText: m.btnText,
                cancelButtonText: 'Cancel'
            }).then(result => {
                if (result.isConfirmed) btn.closest('form').requestSubmit();
            });
        }
    </script>
}
