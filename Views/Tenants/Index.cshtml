@using HardwareManagementSystem.Models
@model List<HardwareManagementSystem.Models.Tenant>
@{
    ViewData["Title"] = "Tenants";
}

<div class="page-header-row mb-4">
    <div>
        <h2 class="page-section-title">Tenants</h2>
        <p class="text-muted mb-0">Manage tenant organizations for the HardBuild POS platform.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="Tenants" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> New Tenant
        </a>
        @if (User.IsInRole("SuperAdmin"))
        {
            <form asp-action="UpgradeAllSchemas" method="post" class="d-inline" id="formUpgradeAllSchemas">
                @Html.AntiForgeryToken()
                <button type="button" class="btn btn-outline-warning" id="btnUpgradeAllSchemas">
                    <i class="bi bi-arrow-up-circle me-1"></i> Upgrade All DB Schemas
                </button>
            </form>
            <a asp-controller="SuperAdmin" asp-action="Dashboard" class="btn btn-outline-secondary">
                <i class="bi bi-speedometer2 me-1"></i> SA Dashboard
            </a>
        }
    </div>
</div>

@* Success/error toasts are handled by the layout's global SweetAlert toast system *@

<div class="hb-card">
    <div class="hb-card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Business Name</th>
                        <th>Owner</th>
                        <th>Plan</th>
                        <th>Status</th>
                        <th>Expires</th>
                        <th>Limits</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr class="@(t.Status == TenantStatus.Suspended ? "table-danger" : t.IsExpired ? "table-warning" : "")">
                            <td><span class="badge bg-secondary">@t.Code</span></td>
                            <td>
                                <div class="fw-semibold">@t.Name</div>
                                @if (!string.IsNullOrWhiteSpace(t.Email))
                                {
                                    <div class="text-muted small">@t.Email</div>
                                }
                            </td>
                            <td class="text-muted">@(t.OwnerName ?? "�")</td>
                            <td>
                                @if (t.SubscriptionPlan != null)
                                {
                                    <span class="badge badge-soft-primary">@t.SubscriptionPlan.Name</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Custom</span>
                                }
                            </td>
                            <td>
                                @switch (t.Status)
                                {
                                    case TenantStatus.Active:
                                        <span class="badge badge-soft-success">Active</span>
                                        break;
                                    case TenantStatus.Trial:
                                        <span class="badge badge-soft-info">Trial</span>
                                        break;
                                    case TenantStatus.Suspended:
                                        <span class="badge badge-soft-danger">Suspended</span>
                                        break;
                                    case TenantStatus.Expired:
                                        <span class="badge badge-soft-warning">Expired</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (t.ExpirationDate.HasValue)
                                {
                                    <span class="small @(t.IsExpired ? "text-danger fw-semibold" : "text-muted")">
                                        @t.ExpirationDate.Value.ToString("MMM dd, yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">�</span>
                                }
                            </td>
                            <td>
                                <div class="text-muted small">
                                    <i class="bi bi-building me-1"></i>@t.MaxBranches br &bull;
                                    <i class="bi bi-people me-1"></i>@t.MaxUsers usr &bull;
                                    <i class="bi bi-box-seam me-1"></i>@t.MaxProducts prod
                                </div>
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-action="Details" asp-route-id="@t.Id"
                                       class="btn btn-sm btn-outline-secondary" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@t.Id"
                                       class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (t.Status != TenantStatus.Suspended)
                                    {
                                        <form asp-action="Suspend" asp-route-id="@t.Id" method="post" class="d-inline tenant-action-form">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-sm btn-outline-warning" title="Suspend"
                                                    data-swal-title="Suspend Tenant?"
                                                    data-swal-text="All tenant users will be blocked from accessing the system."
                                                    data-swal-confirm="Yes, Suspend"
                                                    data-swal-cancel="No, Cancel"
                                                    data-swal-icon="warning">
                                                <i class="bi bi-pause-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Reactivate" asp-route-id="@t.Id" method="post" class="d-inline tenant-action-form">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-sm btn-outline-success" title="Reactivate"
                                                    data-swal-title="Reactivate Tenant?"
                                                    data-swal-text="Tenant users will regain access to the system."
                                                    data-swal-confirm="Yes, Reactivate"
                                                    data-swal-cancel="No, Cancel"
                                                    data-swal-icon="question">
                                                <i class="bi bi-play-circle"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No tenants found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var btnUpgrade = document.getElementById('btnUpgradeAllSchemas');
    if (btnUpgrade) {
        btnUpgrade.addEventListener('click', function () {
            Swal.fire({
                title: 'Upgrade All Tenant Database Schemas?',
                html: 'This will apply any pending EF Core migrations to every provisioned dedicated tenant database.<br><br>Safe to run even when schemas are already current.<br><br><strong>This may take a moment if there are many tenants.</strong>',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#fd7e14',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, Upgrade All',
                cancelButtonText: 'Cancel'
            }).then(function (r) {
                if (r.isConfirmed) document.getElementById('formUpgradeAllSchemas').submit();
            });
        });
    }

    document.querySelectorAll('.tenant-action-form button[data-swal-title]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var form  = this.closest('form');
            var title = this.dataset.swalTitle;
            var text  = this.dataset.swalText;
            var conf  = this.dataset.swalConfirm;
            var can   = this.dataset.swalCancel;
            var icon  = this.dataset.swalIcon;

            Swal.fire({
                title: title,
                html: text,
                icon: icon,
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: conf,
                cancelButtonText: can
            }).then(function (r) {
                if (r.isConfirmed) form.submit();
            });
        });
    });
})();
</script>
}
