@using HardwareManagementSystem.Models
@model HardwareManagementSystem.Models.Tenant
@{
    ViewData["Title"] = "Edit Tenant";
}

<div class="page-header-row mb-3">
    <div>
        <h2 class="page-section-title">Edit Tenant</h2>
        <p class="text-muted mb-0"><span class="badge bg-secondary">@Model.Code</span></p>
    </div>
    <a asp-controller="Tenants" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="confirm-submit">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="All" class="alert alert-danger"></div>

            <h6 class="fw-bold text-uppercase text-muted small mb-3">Business Info</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label fw-semibold">Business Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Code" class="form-label fw-semibold">Tenant Code <span class="text-danger">*</span></label>
                    <input asp-for="Code" class="form-control text-uppercase" maxlength="20" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="OwnerName" class="form-label fw-semibold">Owner Name</label>
                    <input asp-for="OwnerName" class="form-control" maxlength="150" />
                    <span asp-validation-for="OwnerName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold">Email</label>
                    <input asp-for="Email" class="form-control" type="email" maxlength="150" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label fw-semibold">Phone</label>
                    <input asp-for="Phone" class="form-control" maxlength="30" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Address" class="form-label fw-semibold">Address</label>
                    <input asp-for="Address" class="form-control" maxlength="250" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label fw-semibold">Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="2" maxlength="300"></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>
            </div>

            <h6 class="fw-bold text-uppercase text-muted small mb-3">Subscription & Limits</h6>
            <div class="row g-3">

                <!-- Plan Selection -->
                <div class="col-md-5">
                    <label asp-for="SubscriptionPlanId" class="form-label fw-semibold">Subscription Plan</label>
                    <select asp-for="SubscriptionPlanId" asp-items="ViewBag.Plans"
                            class="form-select" id="planSelect">
                        <option value="">— No Plan (Custom Limits) —</option>
                    </select>
                    <span asp-validation-for="SubscriptionPlanId" class="text-danger small"></span>
                </div>

                <!-- Status -->
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label fw-semibold">Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Trial">Trial</option>
                        <option value="Active">Active</option>
                        <option value="Suspended">Suspended</option>
                        <option value="Expired">Expired</option>
                    </select>
                </div>

                <!-- Expiration Date -->
                <div class="col-md-3">
                    <label asp-for="ExpirationDate" class="form-label fw-semibold">Expiration Date</label>
                    <input asp-for="ExpirationDate" class="form-control" type="date" />
                </div>

                <!-- Plan Info Banner -->
                <div class="col-12">
                    <div id="planInfoBanner" class="alert alert-info d-flex align-items-center gap-3 py-2 px-3 mb-0" style="display:none!important">
                        <i class="bi bi-patch-check-fill flex-shrink-0"></i>
                        <span>
                            <strong id="planInfoName"></strong>
                            &mdash; ₱<span id="planInfoPrice"></span>/mo
                            &bull; <span id="planInfoBranches"></span> branches
                            &bull; <span id="planInfoUsers"></span> users
                            &bull; <span id="planInfoProducts"></span> products
                        </span>
                    </div>
                    <div id="noPlanBanner" class="alert alert-secondary d-flex align-items-center gap-2 py-2 px-3 mb-0" style="display:none!important">
                        <i class="bi bi-info-circle flex-shrink-0"></i>
                        <span class="small">No plan selected — limits are manually configured.</span>
                    </div>
                </div>

                <!-- Limit fields — readonly when a plan is selected -->
                <div class="col-md-4">
                    <label asp-for="MaxBranches" class="form-label fw-semibold">
                        Max Branches
                        <span id="limitBadgeEdit" class="badge bg-info text-dark ms-1" style="display:none">From Plan</span>
                    </label>
                    <input asp-for="MaxBranches" id="maxBranchesInput" class="form-control" type="number" min="1" />
                </div>
                <div class="col-md-4">
                    <label asp-for="MaxUsers" class="form-label fw-semibold">Max Users</label>
                    <input asp-for="MaxUsers" id="maxUsersInput" class="form-control" type="number" min="1" />
                </div>
                <div class="col-md-4">
                    <label asp-for="MaxProducts" class="form-label fw-semibold">Max Products</label>
                    <input asp-for="MaxProducts" id="maxProductsInput" class="form-control" type="number" min="1" />
                </div>

                <!-- Active checkbox -->
                <div class="col-md-12 d-flex align-items-center">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active</label>
                    </div>
                </div>
            </div>

            <h6 class="fw-bold text-uppercase text-muted small mb-3 mt-4">Database Routing (Advanced)</h6>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="DatabaseMode" class="form-label fw-semibold">Database Mode</label>
                    <select asp-for="DatabaseMode" class="form-select">
                        <option value="Shared">Shared</option>
                        <option value="Dedicated">Dedicated</option>
                    </select>
                    <span class="text-muted small">Routing is not active yet (Phase 5.0B). Leave as Shared.</span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DatabaseName" class="form-label fw-semibold">Database Name</label>
                    <input asp-for="DatabaseName" class="form-control" maxlength="128"
                           placeholder="e.g. HardBuild_Tenant_@Model.Id" />
                    <span class="text-muted small">Logical name for a future dedicated database.</span>
                </div>
                <div class="col-12">
                    <div class="alert alert-secondary mb-0 py-2 small">
                        <i class="bi bi-shield-lock me-1"></i>
                        The connection string is managed backend-only and cannot be edited here.
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i> Save Changes
                </button>
                <a asp-controller="Tenants" asp-action="Details" asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
    (function () {
        /* ── Subscription Plan auto-populate ───────────────────── */
        var PLAN_DATA = {};
        var planList  = @Html.Raw(ViewBag.PlanDetailsJson as string ?? "[]");
        planList.forEach(function (p) { PLAN_DATA[p.id] = p; });

        var planSelect       = document.getElementById('planSelect');
        var maxBranchesInput = document.getElementById('maxBranchesInput');
        var maxUsersInput    = document.getElementById('maxUsersInput');
        var maxProductsInput = document.getElementById('maxProductsInput');
        var planInfoBanner   = document.getElementById('planInfoBanner');
        var noPlanBanner     = document.getElementById('noPlanBanner');
        var limitBadge       = document.getElementById('limitBadgeEdit');
        var planInfoName     = document.getElementById('planInfoName');
        var planInfoPrice    = document.getElementById('planInfoPrice');
        var planInfoBranches = document.getElementById('planInfoBranches');
        var planInfoUsers    = document.getElementById('planInfoUsers');
        var planInfoProducts = document.getElementById('planInfoProducts');

        function setLimitReadonly(isReadonly) {
            [maxBranchesInput, maxUsersInput, maxProductsInput].forEach(function (el) {
                if (isReadonly) {
                    el.setAttribute('readonly', '');
                    el.classList.add('bg-light');
                } else {
                    el.removeAttribute('readonly');
                    el.classList.remove('bg-light');
                }
            });
            limitBadge.style.display = isReadonly ? '' : 'none';
        }

        function applyPlan(planId) {
            var plan = PLAN_DATA[planId];
            if (!plan) { clearPlan(); return; }

            maxBranchesInput.value = plan.maxBranches;
            maxUsersInput.value    = plan.maxUsers;
            maxProductsInput.value = plan.maxProducts;
            setLimitReadonly(true);

            planInfoName.textContent     = plan.name;
            planInfoPrice.textContent    = Number(plan.monthlyPrice).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            planInfoBranches.textContent = plan.maxBranches;
            planInfoUsers.textContent    = plan.maxUsers;
            planInfoProducts.textContent = plan.maxProducts;

            planInfoBanner.style.removeProperty('display');
            noPlanBanner.style.display = 'none';
        }

        function clearPlan() {
            setLimitReadonly(false);
            planInfoBanner.style.display = 'none';
            noPlanBanner.style.removeProperty('display');
        }

        planSelect.addEventListener('change', function () {
            var val = this.value;
            if (val) { applyPlan(Number(val)); } else { clearPlan(); }
        });

        // Initialize on page load from model's existing plan selection
        if (planSelect.value) { applyPlan(Number(planSelect.value)); }
        else                  { clearPlan(); }
    })();
    </script>
}
