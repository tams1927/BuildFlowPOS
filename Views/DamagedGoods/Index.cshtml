@model HardwareManagementSystem.ViewModels.PagedResult<HardwareManagementSystem.Models.DamagedGoodsHeader>
@{
    ViewData["Title"] = "Damaged Goods";
}

<div class="page-header-row mb-4">
    <div>
        <h2 class="page-section-title">Damaged Goods</h2>
        <p class="text-muted mb-0">Track unsellable inventory separately from sellable stock.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Tag Damaged Stock</a>
</div>

<div class="hb-card">
    <div class="hb-card-body p-0">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Number</th>
                    <th>Date</th>
                    <th>Branch</th>
                    <th>Item</th>
                    <th>Base Qty</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model.Items)
                {
                    var d = h.Details.FirstOrDefault();
                    <tr>
                        <td class="fw-semibold">@h.DamageNumber</td>
                        <td class="small">@h.DamageDate.ToString("MMM dd, yyyy")</td>
                        <td class="small">@(h.Branch?.Name ?? "—")</td>
                        <td class="small">@(d?.Item?.ItemName ?? "—")</td>
                        <td>@((d?.BaseQuantity ?? 0).ToString("0.###"))</td>
                        <td class="small">@(d?.Reason ?? "—")</td>
                        <td><span class="badge badge-soft-secondary">@h.Status</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@h.Id" class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No damaged goods records yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
