@model HardwareManagementSystem.Models.SystemSetting

@{
    ViewData["Title"] = "Settings";
}

<div class="hb-card">

    <div class="hb-card-header">
        <div>
            <h2 class="hb-section-title">System Settings</h2>
            <div class="hb-section-subtitle">
                Configure business information, receipt settings, currency, and VAT
            </div>
        </div>
    </div>

    <div class="hb-card-body">

        <form asp-controller="Settings"
              asp-action="Update"
              method="post"
              id="settingsForm">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ThemeColor" id="themeColorInput" />

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Business Name</label>
                    <input asp-for="BusinessName" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Contact Number</label>
                    <input asp-for="ContactNumber" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Email</label>
                    <input asp-for="Email" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">TIN (Tax Identification Number)</label>
                    <input asp-for="TIN" class="form-control" placeholder="000-000-000-000" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">VAT Registration Number</label>
                    <input asp-for="VATRegNumber" class="form-control" placeholder="VAT Reg. No." />
                </div>

                <div class="col-12">
                    <h6 class="fw-bold text-primary mt-2">Currency</h6>
                    <p class="text-muted small mb-0">Used on dashboard, POS, receipts, reports, and PDF exports.</p>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Currency</label>
                    <select id="currencyPreset" class="form-select">
                        <option value="PHP|₱|Philippine Peso">PHP — Philippine Peso (₱)</option>
                        <option value="USD|$|US Dollar">USD — US Dollar ($)</option>
                        <option value="EUR|€|Euro">EUR — Euro (€)</option>
                        <option value="GBP|£|British Pound">GBP — British Pound (£)</option>
                        <option value="JPY|¥|Japanese Yen">JPY — Japanese Yen (¥)</option>
                        <option value="SGD|S$|Singapore Dollar">SGD — Singapore Dollar (S$)</option>
                        <option value="AED|د.إ|UAE Dirham">AED — UAE Dirham</option>
                        <option value="AUD|A$|Australian Dollar">AUD — Australian Dollar</option>
                        <option value="CAD|C$|Canadian Dollar">CAD — Canadian Dollar</option>
                        <option value="CUSTOM">Custom…</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold">Code</label>
                    <input asp-for="CurrencyCode" class="form-control" maxlength="3" required />
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold">Symbol</label>
                    <input asp-for="CurrencySymbol" id="currencySymbolInput" class="form-control" required />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Currency Name</label>
                    <input asp-for="CurrencyName" id="currencyNameInput" class="form-control" required />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Default VAT %</label>
                    <input asp-for="DefaultVatPercent"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control" />
                </div>
                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Tax Mode
                    </label>

                    <select asp-for="TaxMode"
                            class="form-select">

                        <option value="VAT">
                            VAT Registered
                        </option>

                        <option value="NONVAT">
                            Non-VAT / Percentage Tax
                        </option>

                        <option value="MANUAL">
                            Manual Tax Handling
                        </option>

                    </select>

                    <div class="form-text">
                        Controls VAT computation and tax reporting behavior.
                    </div>

                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Receipt Paper Size</label>
                    <select asp-for="ReceiptPaperSize" class="form-select">
                        <option value="80mm">80mm Thermal</option>
                        <option value="58mm">58mm Thermal</option>
                        <option value="A4">A4</option>
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Business Address</label>
                    <textarea asp-for="BusinessAddress" class="form-control" rows="3"></textarea>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Receipt Footer</label>
                    <textarea asp-for="ReceiptFooter"
                              class="form-control"
                              rows="3"
                              placeholder="Example: Thank you for purchasing!"></textarea>
                </div>

            </div>

            <hr class="my-4" />

            <div class="mb-3">
                <label class="form-label fw-semibold fs-6">Application Theme</label>
                <div class="text-muted small mb-3">Select a theme. It will apply immediately for all users after saving.</div>

                <div class="row g-3" id="themePickerRow">

                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="theme-card" data-theme="white-blue">

                            <div class="theme-preview"
                                 style="background:#f8fafc; border:2px solid #dbeafe;">

                                <div style="width:30%;
                        background:#ffffff;
                        height:100%;
                        border-right:1px solid #dbeafe;
                        display:flex;
                        flex-direction:column;
                        gap:5px;
                        padding:6px;">

                                    <div style="height:8px;
                            border-radius:4px;
                            background:#2563eb;"></div>

                                    <div style="height:6px;
                            border-radius:4px;
                            background:#dbeafe;"></div>

                                    <div style="height:6px;
                            border-radius:4px;
                            background:#dbeafe;"></div>

                                </div>

                                <div style="flex:1;
                        padding:8px;
                        display:flex;
                        flex-direction:column;
                        gap:5px;">

                                    <div style="height:10px;
                            border-radius:4px;
                            background:#e2e8f0;
                            width:80%;"></div>

                                    <div style="height:28px;
                            border-radius:6px;
                            background:#ffffff;
                            border:1px solid #dbeafe;"></div>

                                </div>

                            </div>

                            <div class="theme-label">

                                <span class="theme-dot"
                                      style="background:#2563eb;"></span>

                                White Blue

                            </div>

                        </div>
                    </div>

                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="theme-card" data-theme="dark-blue">
                            <div class="theme-preview" style="background:#0f172a; border:2px solid #334155;">
                                <div style="width:30%; background:#1e293b; height:100%; border-right:1px solid #334155; display:flex; flex-direction:column; gap:5px; padding:6px;">
                                    <div style="height:8px; border-radius:4px; background:#1e40af;"></div>
                                    <div style="height:6px; border-radius:4px; background:#334155;"></div>
                                    <div style="height:6px; border-radius:4px; background:#334155;"></div>
                                </div>
                                <div style="flex:1; padding:8px; display:flex; flex-direction:column; gap:5px;">
                                    <div style="height:10px; border-radius:4px; background:#1e293b; width:80%;"></div>
                                    <div style="height:28px; border-radius:6px; background:#1e293b;"></div>
                                </div>
                            </div>
                            <div class="theme-label">
                                <span class="theme-dot" style="background:#1e40af;"></span>
                                Dark Blue
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="theme-card" data-theme="emerald">
                            <div class="theme-preview" style="background:#0b1f18; border:2px solid #1f4d38;">
                                <div style="width:30%; background:#102820; height:100%; border-right:1px solid #1f4d38; display:flex; flex-direction:column; gap:5px; padding:6px;">
                                    <div style="height:8px; border-radius:4px; background:#065f46;"></div>
                                    <div style="height:6px; border-radius:4px; background:#1f4d38;"></div>
                                    <div style="height:6px; border-radius:4px; background:#1f4d38;"></div>
                                </div>
                                <div style="flex:1; padding:8px; display:flex; flex-direction:column; gap:5px;">
                                    <div style="height:10px; border-radius:4px; background:#102820; width:80%;"></div>
                                    <div style="height:28px; border-radius:6px; background:#102820;"></div>
                                </div>
                            </div>
                            <div class="theme-label">
                                <span class="theme-dot" style="background:#065f46;"></span>
                                Emerald
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="theme-card" data-theme="slate">
                            <div class="theme-preview" style="background:#0f172a; border:2px solid #334155;">
                                <div style="width:30%; background:#1e293b; height:100%; border-right:1px solid #334155; display:flex; flex-direction:column; gap:5px; padding:6px;">
                                    <div style="height:8px; border-radius:4px; background:#475569;"></div>
                                    <div style="height:6px; border-radius:4px; background:#334155;"></div>
                                    <div style="height:6px; border-radius:4px; background:#334155;"></div>
                                </div>
                                <div style="flex:1; padding:8px; display:flex; flex-direction:column; gap:5px;">
                                    <div style="height:10px; border-radius:4px; background:#1e293b; width:80%;"></div>
                                    <div style="height:28px; border-radius:6px; background:#1e293b;"></div>
                                </div>
                            </div>
                            <div class="theme-label">
                                <span class="theme-dot" style="background:#475569;"></span>
                                Slate Gray
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="theme-card" data-theme="gold">
                            <div class="theme-preview" style="background:#1c1507; border:2px solid #4d3b1a;">
                                <div style="width:30%; background:#271e0a; height:100%; border-right:1px solid #4d3b1a; display:flex; flex-direction:column; gap:5px; padding:6px;">
                                    <div style="height:8px; border-radius:4px; background:#92400e;"></div>
                                    <div style="height:6px; border-radius:4px; background:#4d3b1a;"></div>
                                    <div style="height:6px; border-radius:4px; background:#4d3b1a;"></div>
                                </div>
                                <div style="flex:1; padding:8px; display:flex; flex-direction:column; gap:5px;">
                                    <div style="height:10px; border-radius:4px; background:#271e0a; width:80%;"></div>
                                    <div style="height:28px; border-radius:6px; background:#271e0a;"></div>
                                </div>
                            </div>
                            <div class="theme-label">
                                <span class="theme-dot" style="background:#92400e;"></span>
                                Premium Gold
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="theme-card" data-theme="dark">
                            <div class="theme-preview" style="background:#09090b; border:2px solid #27272a;">
                                <div style="width:30%; background:#111113; height:100%; border-right:1px solid #27272a; display:flex; flex-direction:column; gap:5px; padding:6px;">
                                    <div style="height:8px; border-radius:4px; background:#6366f1;"></div>
                                    <div style="height:6px; border-radius:4px; background:#27272a;"></div>
                                    <div style="height:6px; border-radius:4px; background:#27272a;"></div>
                                </div>
                                <div style="flex:1; padding:8px; display:flex; flex-direction:column; gap:5px;">
                                    <div style="height:10px; border-radius:4px; background:#111113; width:80%;"></div>
                                    <div style="height:28px; border-radius:6px; background:#111113;"></div>
                                </div>
                            </div>
                            <div class="theme-label">
                                <span class="theme-dot" style="background:#6366f1;"></span>
                                Dark Mode
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button type="button" id="saveSettingsBtn" class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i>
                    Save Settings
                </button>
            </div>

        </form>

    </div>

</div>

<div class="hb-card mt-4">

    <div class="hb-card-header">
        <div>
            <h2 class="hb-section-title">Company Logo</h2>
            <div class="hb-section-subtitle">
                Upload your company logo. It appears on PDFs, quotations, delivery receipts, and printed documents.
            </div>
        </div>
    </div>

    <div class="hb-card-body">

        <div class="row g-4 align-items-center">

            <div class="col-md-4 text-center">
                @if (!string.IsNullOrWhiteSpace(Model.LogoPath))
                {
                    <img id="logoPreview"
                         src="@Model.LogoPath"
                         alt="Company Logo"
                         class="img-fluid rounded border"
                         style="max-height:140px; max-width:280px; object-fit:contain;" />
                }
                else
                {
                    <div id="logoPlaceholder"
                         class="border rounded d-flex align-items-center justify-content-center text-muted"
                         style="height:140px; width:280px; margin:auto; background:var(--hb-surface-2);">
                        <div class="text-center">
                            <i class="bi bi-image fs-1 d-block mb-1"></i>
                            <span class="small">No logo uploaded</span>
                        </div>
                    </div>
                    <img id="logoPreview"
                         src="#"
                         alt="Preview"
                         class="img-fluid rounded border d-none"
                         style="max-height:140px; max-width:280px; object-fit:contain;" />
                }
            </div>

            <div class="col-md-8">
                <form asp-controller="Settings"
                      asp-action="UploadLogo"
                      method="post"
                      enctype="multipart/form-data"
                      id="logoUploadForm">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select Image</label>
                        <input type="file"
                               name="logo"
                               id="logoFileInput"
                               accept="image/jpeg,image/png,image/gif,image/webp"
                               class="form-control"
                               required />
                        <div class="form-text">
                            Accepted: JPG, PNG, GIF, WebP &mdash; max 2 MB
                        </div>
                    </div>

                    <button type="button"
                            id="uploadLogoBtn"
                            class="btn btn-primary">
                        <i class="bi bi-cloud-upload me-1"></i>
                        Upload Logo
                    </button>

                    @if (!string.IsNullOrWhiteSpace(Model.LogoPath))
                    {
                        <span class="ms-3 text-muted small">
                            <i class="bi bi-check-circle-fill text-success me-1"></i>
                            Logo on file — uploading will replace it.
                        </span>
                    }

                </form>
            </div>

        </div>

    </div>

</div>

@{
    var dataProtection = ViewBag.DataProtection as HardwareManagementSystem.ViewModels.TenantDataProtectionVm;
}
@if (dataProtection != null)
{
<div class="hb-card mt-4">
    <div class="hb-card-header">
        <div>
            <h2 class="hb-section-title">Data Protection</h2>
            <div class="hb-section-subtitle">
                Backup status for your tenant. Restore is managed by platform administrators only.
            </div>
        </div>
    </div>
    <div class="hb-card-body">
        <div class="row g-3 align-items-center">
            <div class="col-md-8">
                @if (dataProtection.LastBackup != null)
                {
                    <div class="d-flex flex-wrap gap-3 align-items-center mb-2">
                        <span class="badge @(dataProtection.LastBackup.Status == HardwareManagementSystem.Models.BackupStatus.Success ? "badge-soft-success" : dataProtection.LastBackup.Status == HardwareManagementSystem.Models.BackupStatus.Failed ? "badge-soft-danger" : "badge-soft-warning")">
                            @dataProtection.LastBackup.Status
                        </span>
                        <span class="small text-muted">
                            Last backup:
                            <strong>@dataProtection.LastBackup.CompletedAtUtc?.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</strong>
                        </span>
                        <span class="small text-muted">Type: @dataProtection.LastBackup.BackupType</span>
                    </div>
                    @if (dataProtection.LastBackup.Status == HardwareManagementSystem.Models.BackupStatus.Failed && !string.IsNullOrWhiteSpace(dataProtection.LastBackup.ErrorMessage))
                    {
                        <div class="alert alert-danger small py-2">@dataProtection.LastBackup.ErrorMessage</div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">No backup recorded yet for your tenant scope.</p>
                }
                @if (!dataProtection.UsesDedicatedDatabase)
                {
                    <p class="text-muted small mt-2 mb-0">
                        Your tenant uses the shared platform database. Platform backup covers your operational data.
                    </p>
                }
            </div>
            <div class="col-md-4 text-md-end">
                @if (dataProtection.AllowTenantBackupRequest)
                {
                    <form asp-action="RequestBackup" method="post" id="requestBackupForm">
                        @Html.AntiForgeryToken()
                        <button type="button" class="btn btn-outline-primary" id="btnRequestBackup">
                            <i class="bi bi-hdd-stack me-1"></i> Request Backup
                        </button>
                    </form>
                }
                else
                {
                    <span class="text-muted small">Backup requests are disabled by platform policy.</span>
                }
            </div>
        </div>
    </div>
</div>
}

<div class="hb-card mt-4">

    <div class="hb-card-header">
        <div>
            <h2 class="hb-section-title">Receipt Preview</h2>
            <div class="hb-section-subtitle">
                Preview how business information will appear on receipts
            </div>
        </div>
    </div>

    <div class="hb-card-body">

        <div class="mx-auto text-center border rounded-4 p-4 bg-white text-dark"
             style="max-width:420px;">

            <h4 class="fw-bold mb-1">@Model.BusinessName</h4>

            <div class="text-muted small">
                @(Model.BusinessAddress ?? "Business address")
            </div>

            <div class="text-muted small">
                @(Model.ContactNumber ?? "Contact number")
            </div>

            <hr />

            <div class="d-flex justify-content-between">
                <span>Currency</span>
                <strong>@Model.CurrencySymbol</strong>
            </div>

            <div class="d-flex justify-content-between">
                <span>Tax Mode</span>

                <strong>
                    @if (Model.TaxMode == "VAT")
                    {
                        <span>VAT (@Model.DefaultVatPercent.ToString("0.##")%)</span>
                    }
                    else if (Model.TaxMode == "NONVAT")
                    {
                        <span>NON-VAT</span>
                    }
                    else
                    {
                        <span>MANUAL</span>
                    }
                </strong>
            </div>

            <hr />

            <div class="text-muted small">
                @(Model.ReceiptFooter ?? "Thank you for purchasing!")
            </div>

        </div>

    </div>

</div>

@section Scripts {
<style>
    .theme-card {
        cursor: pointer;
        border-radius: 14px;
        border: 2px solid var(--hb-border);
        overflow: hidden;
        transition: all 0.2s ease;
        background: var(--hb-surface-2);
    }

        .theme-card:hover {
            border-color: var(--hb-primary);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        }

        .theme-card.selected {
            border-color: var(--hb-primary);
            box-shadow: 0 0 0 3px var(--hb-primary-a30);
        }

    .theme-preview {
        height: 70px;
        display: flex;
        border-radius: 0;
    }

    .theme-label {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 10px;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--hb-text);
    }

    .theme-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }
</style>
<script>
    const currentTheme = '@Model.ThemeColor';
    const themeInput = document.getElementById('themeColorInput');
    const cards = document.querySelectorAll('.theme-card');

    function selectTheme(value) {
        themeInput.value = value;
        cards.forEach(c => {
            c.classList.toggle('selected', c.dataset.theme === value);
        });
    }

    cards.forEach(card => {
        card.addEventListener('click', function () {
            selectTheme(this.dataset.theme);
        });
    });

    selectTheme(currentTheme || 'dark-blue');

    document.getElementById('saveSettingsBtn').addEventListener('click', function () {
        const form = document.getElementById('settingsForm');
        const businessName = form.querySelector('[name="BusinessName"]').value.trim();
        const currency = form.querySelector('[name="CurrencySymbol"]').value.trim();
        const vat = parseFloat(form.querySelector('[name="DefaultVatPercent"]').value || 0);

        if (!businessName) {
            Swal.fire({ icon: 'warning', title: 'Required', text: 'Business name is required.', confirmButtonColor: '#1e40af' });
            return;
        }
        if (!currency) {
            Swal.fire({ icon: 'warning', title: 'Required', text: 'Currency symbol is required.', confirmButtonColor: '#1e40af' });
            return;
        }
        if (vat < 0) {
            Swal.fire({ icon: 'warning', title: 'Invalid VAT', text: 'VAT cannot be negative.', confirmButtonColor: '#1e40af' });
            return;
        }

        HbForm.confirmAndSubmit(form, {
            title: 'Save settings?',
            text: 'This will update system and receipt settings.',
            icon: 'question',
            confirmButtonText: 'Yes, save settings',
            cancelButtonText: 'No, cancel',
            confirmButtonColor: '#2563eb',
            cancelButtonColor: '#64748b'
        });
    });

    const currencyPreset = document.getElementById('currencyPreset');
    const currencyCode = document.querySelector('[name="CurrencyCode"]');
    const currencySymbol = document.getElementById('currencySymbolInput');
    const currencyName = document.getElementById('currencyNameInput');
    if (currencyPreset && currencyCode) {
        function syncPresetFromFields() {
            const key = `${currencyCode.value}|${currencySymbol?.value}|${currencyName?.value}`;
            let matched = false;
            for (const opt of currencyPreset.options) {
                if (opt.value === key) { currencyPreset.value = key; matched = true; break; }
            }
            if (!matched) currencyPreset.value = 'CUSTOM';
        }
        syncPresetFromFields();
        currencyPreset.addEventListener('change', function () {
            if (this.value === 'CUSTOM') return;
            const parts = this.value.split('|');
            if (parts.length >= 3) {
                currencyCode.value = parts[0];
                if (currencySymbol) currencySymbol.value = parts[1];
                if (currencyName) currencyName.value = parts[2];
            }
        });
    }

    // Logo preview
    const logoInput    = document.getElementById('logoFileInput');
    const logoPreview  = document.getElementById('logoPreview');
    const logoHolder   = document.getElementById('logoPlaceholder');

    if (logoInput) {
        logoInput.addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = e => {
                if (logoPreview) {
                    logoPreview.src = e.target.result;
                    logoPreview.classList.remove('d-none');
                }
                if (logoHolder) logoHolder.classList.add('d-none');
            };
            reader.readAsDataURL(file);
        });
    }

    // Logo upload confirmation
    const uploadLogoBtn = document.getElementById('uploadLogoBtn');
    if (uploadLogoBtn) {
        uploadLogoBtn.addEventListener('click', function () {
            const file = logoInput && logoInput.files[0];
            if (!file) {
                Swal.fire({ icon: 'warning', title: 'No file selected', text: 'Please choose an image file first.', confirmButtonColor: '#1e40af' });
                return;
            }
            const maxMb = 2;
            if (file.size > maxMb * 1024 * 1024) {
                Swal.fire({ icon: 'error', title: 'File too large', text: 'Maximum allowed size is 2 MB.', confirmButtonColor: '#1e40af' });
                return;
            }
            HbForm.confirmAndSubmit(document.getElementById('logoUploadForm'), {
                title: 'Upload logo?',
                text: 'This will replace the current company logo.',
                icon: 'question',
                confirmButtonText: 'Yes, upload',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#2563eb',
                cancelButtonColor: '#64748b'
            });
        });
    }

    const btnRequestBackup = document.getElementById('btnRequestBackup');
    if (btnRequestBackup) {
        btnRequestBackup.addEventListener('click', function () {
            Swal.fire({
                title: 'Request Backup?',
                text: 'A backup will be created immediately. Restore is managed by your platform administrator.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Request Backup',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#2563eb',
                cancelButtonColor: '#64748b'
            }).then(function (result) {
                if (result.isConfirmed) document.getElementById('requestBackupForm').submit();
            });
        });
    }
</script>
}