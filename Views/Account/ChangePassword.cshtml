@model HardwareManagementSystem.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    bool forced = ViewBag.ForcePasswordChange == true;
}

@if (forced)
{
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-3" role="alert">
        <i class="bi bi-shield-exclamation fs-5"></i>
        <div>
            <strong>Password reset required.</strong>
            Your password was reset by an administrator. You must set a new password before continuing.
        </div>
    </div>
}

<div class="row justify-content-center">

    <div class="col-xl-6 col-lg-8">

        <!-- HEADER -->
        <div class="hb-card mb-4">

            <div class="hb-card-body">

                <div class="d-flex align-items-center gap-3">

                    <div class="kpi-icon">
                        <i class="bi bi-shield-lock"></i>
                    </div>

                    <div>
                        <h2 class="hb-section-title mb-1">
                            Change Password
                        </h2>

                        <div class="hb-section-subtitle">
                            Secure your account by updating your password regularly
                        </div>
                    </div>

                </div>

            </div>

        </div>

        <!-- FORM -->
        <div class="hb-card">

            <div class="hb-card-header">

                <div>
                    <h2 class="hb-section-title">
                        Account Security
                    </h2>

                    <div class="hb-section-subtitle">
                        Enter your current password and choose a new secure password
                    </div>
                </div>

            </div>

            <div class="hb-card-body">

                <form asp-controller="Account"
                      asp-action="ChangePassword"
                      method="post"
                      class="confirm-submit">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger mb-4">
                    </div>

                    <!-- CURRENT PASSWORD -->
                    <div class="mb-4">

                        <label asp-for="CurrentPassword"
                               class="form-label fw-semibold">
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-lock"></i>
                            </span>

                            <input asp-for="CurrentPassword"
                                   class="form-control password-input"
                                   type="password"
                                   placeholder="Enter current password" />

                            <button class="btn btn-outline-secondary toggle-password"
                                    type="button">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="CurrentPassword"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- NEW PASSWORD -->
                    <div class="mb-4">

                        <label asp-for="NewPassword"
                               class="form-label fw-semibold">
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-key"></i>
                            </span>

                            <input asp-for="NewPassword"
                                   class="form-control password-input"
                                   type="password"
                                   placeholder="Enter new password" />

                            <button class="btn btn-outline-secondary toggle-password"
                                    type="button">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <div class="form-text">
                            Password should be at least 6 characters long.
                        </div>

                        <span asp-validation-for="NewPassword"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- CONFIRM PASSWORD -->
                    <div class="mb-4">

                        <label asp-for="ConfirmPassword"
                               class="form-label fw-semibold">
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-shield-check"></i>
                            </span>

                            <input asp-for="ConfirmPassword"
                                   class="form-control password-input"
                                   type="password"
                                   placeholder="Confirm new password" />

                            <button class="btn btn-outline-secondary toggle-password"
                                    type="button">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- BUTTON -->
                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-check-circle me-1"></i>

                            Update Password

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        // ============================================
        // SHOW / HIDE PASSWORD
        // ============================================

        document.querySelectorAll('.toggle-password')
            .forEach(button => {

                button.addEventListener('click', function () {

                    const input =
                        this.parentElement.querySelector('.password-input');

                    const icon =
                        this.querySelector('i');

                    if (input.type === 'password') {

                        input.type = 'text';

                        icon.classList.remove('bi-eye');
                        icon.classList.add('bi-eye-slash');

                    }
                    else {

                        input.type = 'password';

                        icon.classList.remove('bi-eye-slash');
                        icon.classList.add('bi-eye');

                    }

                });

            });

    </script>

    @if (TempData["SuccessMessage"] != null)
    {
        <script>

            Swal.fire({
                icon: 'success',
                title: 'Password Updated',
                text: '@TempData["SuccessMessage"]',
                confirmButtonColor: '#2563eb'
            });

        </script>
    }

}