@{
    ViewData["Title"] = "Subscription Expired";
    Layout = null;
    var tenantName = ViewBag.TenantName as string ?? "Your organization";
    var status = ViewBag.Status as string ?? "Expired";
    var message = ViewBag.Message as string ?? "Your subscription is no longer active.";
    var expiration = ViewBag.ExpirationDisplay as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Subscription Access — HardBuild POS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #0f1f3d 100%);
            font-family: "Segoe UI", sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .access-card {
            width: 100%;
            max-width: 520px;
            background: #1e293b;
            border-radius: 22px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
            padding: 48px 40px 40px;
            text-align: center;
        }
        .icon-circle {
            width: 72px; height: 72px; border-radius: 50%;
            background: rgba(239, 68, 68, 0.15);
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 24px; font-size: 2rem; color: #f87171;
        }
        .card-title { font-size: 1.5rem; font-weight: 800; color: #f1f5f9; margin-bottom: 8px; }
        .card-subtitle { color: #64748b; font-size: 0.9rem; margin-bottom: 20px; }
        .card-message { color: #94a3b8; font-size: 0.95rem; line-height: 1.6; margin-bottom: 24px; text-align: left; }
        .meta-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #334155; font-size: 0.88rem; }
        .meta-row:last-child { border-bottom: none; }
        .meta-label { color: #64748b; }
        .meta-value { color: #e2e8f0; font-weight: 600; }
        .btn-logout {
            width: 100%; padding: 12px; background: #ef4444; color: #fff;
            border: none; border-radius: 10px; font-weight: 600; margin-top: 28px;
        }
        .btn-logout:hover { background: #dc2626; color: #fff; }
        .support-note { margin-top: 20px; font-size: 0.82rem; color: #475569; }
    </style>
</head>
<body>
    <div class="access-card">
        <div class="icon-circle"><i class="bi bi-calendar-x"></i></div>
        <div class="card-title">Subscription Access Ended</div>
        <div class="card-subtitle">@tenantName</div>

        <div class="card-message mb-3">@message</div>

        <div class="text-start px-1">
            <div class="meta-row">
                <span class="meta-label">Status</span>
                <span class="meta-value">@status</span>
            </div>
            @if (!string.IsNullOrEmpty(expiration))
            {
                <div class="meta-row">
                    <span class="meta-label">Expiration date</span>
                    <span class="meta-value">@expiration</span>
                </div>
            }
        </div>

        <p class="support-note text-center mb-0">
            Contact your platform administrator or support to renew or extend your subscription.
        </p>

        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-logout">
                <i class="bi bi-box-arrow-right me-2"></i>Sign Out
            </button>
        </form>
        <a asp-controller="Account" asp-action="Login" class="d-block mt-3 small text-muted">Return to login</a>
    </div>
</body>
</html>
