@model HardwareManagementSystem.Models.PurchaseOrder
@using HardwareManagementSystem.Models

@{
    ViewData["Title"] = "New Purchase Order";
    var suppliers  = ViewBag.Suppliers  as List<Supplier>  ?? new();
    var items      = ViewBag.Items      as List<Item>       ?? new();
    var branches   = ViewBag.AllBranches as List<Branch>;
    var currBranch = ViewBag.CurrentBranch as Branch;
    var lowStock   = ViewBag.LowStockItems as List<Item>;
    bool isLowStockMode = lowStock != null;
    var currency = ViewBag.CurrencySymbol as string ?? "₱";
}

<div class="hb-card">
    <div class="hb-card-header">
        <div>
            <h2 class="hb-section-title">
                <i class="bi bi-file-earmark-plus me-2"></i>New Purchase Order
            </h2>
            <div class="hb-section-subtitle">
                @if (isLowStockMode)
                {
                    <span class="badge badge-soft-warning me-1"><i class="bi bi-lightbulb me-1"></i>Pre-loaded from low-stock items</span>
                }
                Create a purchase order for your supplier
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>

    <div class="hb-card-body">
        <form asp-controller="PurchaseOrders" asp-action="Create" method="post" id="createPoForm"
              class="confirm-submit" data-hb-custom-confirm="true"
              data-hb-confirm-title="Create Purchase Order?"
              data-hb-confirm-text="This will create a new Draft PO. You can edit it before sending to the supplier."
              data-hb-confirm-button="Yes, create PO">
            @Html.AntiForgeryToken()

            <div class="row g-3 mb-4">

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Supplier <span class="text-danger">*</span></label>
                    <select name="supplierId" class="form-select" required>
                        <option value="">— Select Supplier —</option>
                        @foreach (var s in suppliers)
                        {
                            <option value="@s.Id"
                                    data-contact="@s.ContactNumber"
                                    data-email="@s.Email"
                                    data-address="@s.Address">
                                @s.SupplierName
                            </option>
                        }
                    </select>
                    <div id="supplierInfoBlock" class="mt-2 small text-muted d-none">
                        <div id="supplierContact"></div>
                        <div id="supplierEmail"></div>
                        <div id="supplierAddress"></div>
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold">PO Date <span class="text-danger">*</span></label>
                    <input type="date" name="poDate" class="form-control"
                           value="@Model.PODate.ToString("yyyy-MM-dd")" required />
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold">Expected Delivery</label>
                    <input type="date" name="expectedDeliveryDate" class="form-control" />
                </div>

                @if (branches != null)
                {
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Branch</label>
                        <select name="branchId" class="form-select">
                            <option value="">— Global —</option>
                            @foreach (var b in branches)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </div>
                }
                else if (currBranch != null)
                {
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Branch</label>
                        <input class="form-control" value="@currBranch.Name" readonly />
                    </div>
                }

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Notes</label>
                    <input type="text" name="notes" class="form-control" placeholder="Optional notes..." />
                </div>

            </div>

            <!-- ── Line Items ──────────────────────────────────────── -->
            <h5 class="fw-semibold mb-3">
                <i class="bi bi-list-ul me-2"></i>Order Items
            </h5>

            <p class="form-text mb-2">
                Enter supplier cost <strong>per ordered unit</strong> (e.g. @currency 1,000 per sack). Line total = quantity × cost per unit.
            </p>
            <div class="table-responsive mb-3">
                <table class="table table-bordered" id="poItemsTable">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width:250px">Item</th>
                            <th style="width:110px">Qty Ordered</th>
                            <th style="width:150px">Cost / Ordered Unit</th>
                            <th style="width:130px">Total Cost</th>
                            <th style="width:50px"></th>
                        </tr>
                    </thead>
                    <tbody id="poItemsBody">
                        @if (isLowStockMode && lowStock!.Any())
                        {
                            foreach (var ls in lowStock!)
                            {
                                <tr class="po-item-row">
                                    <td>
                                        <select name="itemIds" class="form-select form-select-sm item-select" required>
                                            <option value="">— Select Item —</option>
                                            @foreach (var it in items)
                                            {
                                                <option value="@it.Id"
                                                        data-cost="@it.CostPrice"
                                                        selected="@(it.Id == ls.Id)">
                                                    @it.ItemName (@it.ItemCode)
                                                </option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" name="quantities" class="form-control form-control-sm qty-input"
                                               value="@Math.Max(ls.ReorderLevel - ls.CurrentStock, 1)" min="0.001" step="0.001" required />
                                    </td>
                                    <td>
                                        <input type="number" name="unitCosts" class="form-control form-control-sm cost-input"
                                               value="@ls.CostPrice" min="0" step="0.01" />
                                    </td>
                                    <td class="total-cell fw-semibold"></td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-danger remove-row-btn">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr class="po-item-row">
                                <td>
                                    <select name="itemIds" class="form-select form-select-sm item-select" required>
                                        <option value="">— Select Item —</option>
                                        @foreach (var it in items)
                                        {
                                            <option value="@it.Id" data-cost="@it.CostPrice">
                                                @it.ItemName (@it.ItemCode)
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="number" name="quantities" class="form-control form-control-sm qty-input"
                                           value="1" min="0.001" step="0.001" required />
                                </td>
                                <td>
                                    <input type="number" name="unitCosts" class="form-control form-control-sm cost-input"
                                           value="0" min="0" step="0.01" />
                                </td>
                                <td class="total-cell fw-semibold"></td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-danger remove-row-btn">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light">
                            <td colspan="3" class="text-end fw-semibold">Total Amount:</td>
                            <td class="fw-bold" id="grandTotal">@currency 0.00</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <button type="button" id="addRowBtn" class="btn btn-outline-secondary btn-sm mb-4">
                <i class="bi bi-plus-circle me-1"></i>Add Item
            </button>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i>Create Purchase Order
                </button>
                <a asp-action="Index" class="btn btn-light">Cancel</a>
            </div>

        </form>
    </div>
</div>

<!-- Item row template -->
<template id="rowTemplate">
    <tr class="po-item-row">
        <td>
            <select name="itemIds" class="form-select form-select-sm item-select" required>
                <option value="">— Select Item —</option>
                @foreach (var it in items)
                {
                    <option value="@it.Id" data-cost="@it.CostPrice">
                        @it.ItemName (@it.ItemCode)
                    </option>
                }
            </select>
        </td>
        <td>
            <input type="number" name="quantities" class="form-control form-control-sm qty-input"
                   value="1" min="0.001" step="0.001" required />
        </td>
        <td>
            <input type="number" name="unitCosts" class="form-control form-control-sm cost-input"
                   value="0" min="0" step="0.01" />
        </td>
        <td class="total-cell fw-semibold"></td>
        <td>
            <button type="button" class="btn btn-sm btn-outline-danger remove-row-btn">
                <i class="bi bi-x"></i>
            </button>
        </td>
    </tr>
</template>

@section Scripts {
<script>
    const currencySymbol = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currency));

    // Supplier info on select
    document.querySelector('[name="supplierId"]')?.addEventListener('change', function () {
        const opt = this.options[this.selectedIndex];
        const block = document.getElementById('supplierInfoBlock');
        if (opt.value) {
            document.getElementById('supplierContact').textContent = opt.dataset.contact ? 'Tel: ' + opt.dataset.contact : '';
            document.getElementById('supplierEmail').textContent   = opt.dataset.email   ? 'Email: ' + opt.dataset.email : '';
            document.getElementById('supplierAddress').textContent = opt.dataset.address ? opt.dataset.address : '';
            block.classList.remove('d-none');
        } else {
            block.classList.add('d-none');
        }
    });

    // Auto-fill unit cost when item selected
    document.addEventListener('change', function (e) {
        if (e.target.classList.contains('item-select')) {
            const row = e.target.closest('tr');
            const cost = e.target.options[e.target.selectedIndex]?.dataset?.cost || 0;
            row.querySelector('.cost-input').value = parseFloat(cost).toFixed(2);
            recalcRow(row);
        }
    });

    document.addEventListener('input', function (e) {
        if (e.target.classList.contains('qty-input') || e.target.classList.contains('cost-input')) {
            recalcRow(e.target.closest('tr'));
        }
    });

    function recalcRow(row) {
        const qty  = parseFloat(row.querySelector('.qty-input').value)  || 0;
        const cost = parseFloat(row.querySelector('.cost-input').value) || 0;
        const total = qty * cost;
        row.querySelector('.total-cell').textContent = currencySymbol + total.toFixed(2);
        recalcGrandTotal();
    }

    function recalcGrandTotal() {
        let grand = 0;
        document.querySelectorAll('.po-item-row').forEach(row => {
            const qty  = parseFloat(row.querySelector('.qty-input')?.value)  || 0;
            const cost = parseFloat(row.querySelector('.cost-input')?.value) || 0;
            grand += qty * cost;
        });
        document.getElementById('grandTotal').textContent = currencySymbol + grand.toFixed(2);
    }

    // Add row
    document.getElementById('addRowBtn').addEventListener('click', function () {
        const tmpl = document.getElementById('rowTemplate').content.cloneNode(true);
        document.getElementById('poItemsBody').appendChild(tmpl);
        recalcGrandTotal();
    });

    // Remove row
    document.addEventListener('click', function (e) {
        if (e.target.closest('.remove-row-btn')) {
            const rows = document.querySelectorAll('.po-item-row');
            if (rows.length <= 1) { return; } // keep at least 1
            e.target.closest('tr').remove();
            recalcGrandTotal();
        }
    });

    // Submit confirmation
    document.getElementById('createPoForm').addEventListener('submit', function (e) {
        const form = this;
        if (HbForm.isConfirmed(form)) {
            return;
        }

        e.preventDefault();

        const supplier = form.querySelector('[name="supplierId"]').value;
        if (!supplier) {
            Swal.fire({ icon: 'warning', title: 'Supplier required', text: 'Please select a supplier.', confirmButtonColor: '#1e40af' });
            return;
        }

        HbForm.confirmAndSubmit(form);
    });

    // Initial calc
    document.querySelectorAll('.po-item-row').forEach(row => recalcRow(row));
</script>
}
