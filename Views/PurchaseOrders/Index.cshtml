@model HardwareManagementSystem.ViewModels.PagedResult<HardwareManagementSystem.Models.PurchaseOrder>
@using HardwareManagementSystem.ViewModels
@using HardwareManagementSystem.Models

@{
    ViewData["Title"] = "Purchase Orders";
    var suppliers = ViewBag.Suppliers as List<Supplier> ?? new();
    var items     = ViewBag.Items     as List<Item>     ?? new();
    var branches  = ViewBag.AllBranches as List<Branch>;
    var currBranch = ViewBag.CurrentBranch as Branch;
    var statusFilter = ViewBag.StatusFilter as string;
}

<div class="row g-3 mb-4">
    <div class="col-xl col-md-4">
        <div class="kpi-card">
            <div class="kpi-icon"><i class="bi bi-file-earmark-text"></i></div>
            <div class="kpi-label">Draft</div>
            <div class="kpi-value">@ViewBag.DraftCount</div>
            <div class="kpi-trend">Pending review</div>
        </div>
    </div>
    <div class="col-xl col-md-4">
        <div class="kpi-card">
            <div class="kpi-icon"><i class="bi bi-send"></i></div>
            <div class="kpi-label">Sent</div>
            <div class="kpi-value">@ViewBag.SentCount</div>
            <div class="kpi-trend">Awaiting delivery</div>
        </div>
    </div>
    <div class="col-xl col-md-4">
        <div class="kpi-card">
            <div class="kpi-icon"><i class="bi bi-hourglass-split"></i></div>
            <div class="kpi-label">Partially Received</div>
            <div class="kpi-value">@ViewBag.PartiallyReceivedCount</div>
            <div class="kpi-trend">Incomplete delivery</div>
        </div>
    </div>
    <div class="col-xl col-md-4">
        <div class="kpi-card">
            <div class="kpi-icon"><i class="bi bi-check-circle"></i></div>
            <div class="kpi-label">Received</div>
            <div class="kpi-value">@ViewBag.ReceivedCount</div>
            <div class="kpi-trend">Fully received</div>
        </div>
    </div>
    <div class="col-xl col-md-4">
        <div class="kpi-card">
            <div class="kpi-icon"><i class="bi bi-x-circle"></i></div>
            <div class="kpi-label">Cancelled</div>
            <div class="kpi-value">@ViewBag.CancelledCount</div>
            <div class="kpi-trend">Void orders</div>
        </div>
    </div>
</div>

<div class="hb-card">

    <div class="hb-card-header">
        <div>
            <h2 class="hb-section-title">Purchase Orders</h2>
            <div class="hb-section-subtitle">Manage supplier purchase orders and receiving</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="PurchaseOrders" asp-action="GenerateFromLowStock"
               class="btn btn-outline-warning btn-sm" title="Generate PO from low-stock items">
                <i class="bi bi-lightbulb me-1"></i>Low-Stock PO
            </a>
            <a asp-controller="PurchaseOrders" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>New Purchase Order
            </a>
        </div>
    </div>

    <div class="hb-card-body">

        <form method="get" asp-controller="PurchaseOrders" asp-action="Index">
            <div class="row g-3 mb-4">
                <div class="col-lg-4">
                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input type="text" name="searchTerm" class="form-control"
                               value="@Model.SearchTerm" placeholder="Search PO number, supplier..." />
                    </div>
                </div>
                <div class="col-lg-3">
                    <select name="statusFilter" class="form-select">
                        <option value="">All Status</option>
                        @foreach (var s in new[] { "Draft","Sent","PartiallyReceived","Received","Cancelled" })
                        {
                            <option value="@s" selected="@(statusFilter == s)">@s</option>
                        }
                    </select>
                </div>
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <input type="hidden" name="pageNumber" value="1" />
                <div class="col-lg-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" type="submit" data-no-disable="true">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </button>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>PO Number</th>
                        <th>PO Date</th>
                        <th>Supplier</th>
                        <th>Branch</th>
                        <th>Items</th>
                        <th>Expected Delivery</th>
                        <th>Status</th>
                        <th width="130">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var po in Model.Items)
                        {
                            var statusBadge = po.Status switch
                            {
                                "Draft"             => "badge-soft-secondary",
                                "Sent"              => "badge-soft-primary",
                                "PartiallyReceived" => "badge-soft-warning",
                                "Received"          => "badge-soft-success",
                                "Cancelled"         => "badge-soft-danger",
                                _                   => "badge-soft-secondary"
                            };
                            <tr>
                                <td><strong class="text-primary">@po.PONumber</strong></td>
                                <td>@po.PODate.ToString("MMM dd, yyyy")</td>
                                <td>@(po.Supplier?.SupplierName ?? "—")</td>
                                <td class="small text-muted">@(po.Branch?.Name ?? "Global")</td>
                                <td class="small">@po.Items.Count item(s)</td>
                                <td class="small text-muted">
                                    @(po.ExpectedDeliveryDate.HasValue ? po.ExpectedDeliveryDate.Value.ToString("MMM dd, yyyy") : "—")
                                </td>
                                <td><span class="badge @statusBadge">@po.Status</span></td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@po.Id"
                                           class="btn btn-sm btn-outline-primary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (po.IsEditable)
                                        {
                                            <a asp-action="Edit" asp-route-id="@po.Id"
                                               class="btn btn-sm btn-outline-secondary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-file-earmark-text fs-1 d-block mb-2"></i>
                                No purchase orders found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Pagination", PaginationMeta.From(Model, "PurchaseOrders", "Index",
            new Dictionary<string, string?> { ["searchTerm"] = Model.SearchTerm, ["statusFilter"] = statusFilter }))

    </div>
</div>
