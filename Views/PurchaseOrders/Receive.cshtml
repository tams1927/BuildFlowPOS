@model HardwareManagementSystem.Models.PurchaseOrder
@using HardwareManagementSystem.Models

@{
    ViewData["Title"] = $"Receive Delivery — {Model.PONumber}";
    var currency = ViewBag.CurrencySymbol as string ?? "\u20B1";
}

<div class="hb-card">
    <div class="hb-card-header">
        <div>
            <h2 class="hb-section-title">
                <i class="bi bi-truck me-2"></i>Receive Delivery — @Model.PONumber
            </h2>
            <div class="hb-section-subtitle">
                Record supplier delivery against this purchase order. Accepted quantities increase inventory automatically.
                @if (Model.Status == "PartiallyReceived")
                {
                    <span class="badge badge-soft-warning ms-1">Partial — remaining items still open</span>
                }
            </div>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to PO
        </a>
    </div>

    <div class="hb-card-body">
        <div class="alert alert-light border mb-4 small">
            <div class="row g-2">
                <div class="col-md-4"><strong>Supplier:</strong> @(Model.Supplier?.SupplierName ?? "-")</div>
                <div class="col-md-4"><strong>Branch:</strong> @(Model.Branch?.Name ?? "-")</div>
                <div class="col-md-4"><strong>PO Date:</strong> @Model.PODate.ToString("MMM dd, yyyy")</div>
            </div>
        </div>

        <form asp-controller="PurchaseOrders" asp-action="Receive" asp-route-id="@Model.Id"
              method="post" id="receiveForm" class="confirm-submit" data-hb-custom-confirm="true"
              data-hb-confirm-title="Receive supplier delivery?"
              data-hb-confirm-html="This will increase inventory and create the supplier receipt/payable record."
              data-hb-confirm-button="Yes, receive delivery"
              data-hb-confirm-color="#16a34a">
            @Html.AntiForgeryToken()

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Delivery / Invoice Reference</label>
                    <input type="text" name="invoiceNumber" class="form-control" placeholder="Supplier invoice or delivery note number" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Remarks</label>
                    <input type="text" name="remarks" class="form-control" placeholder="Optional delivery notes" />
                </div>
            </div>

            <div class="table-responsive mb-4">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th class="text-end">Ordered</th>
                            <th class="text-end">Previously Received</th>
                            <th class="text-end text-warning">Remaining</th>
                            <th class="text-end">Cost / Unit</th>
                            <th class="text-end">Base Preview</th>
                            <th style="width:120px">Accept Now</th>
                            <th style="width:120px">Damaged</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pi in Model.Items.OrderBy(i => i.Id))
                        {
                            var factor = pi.ConversionQuantity > 0 ? pi.ConversionQuantity : 1m;
                            var receivedOrdered = factor > 0 ? pi.QuantityReceived / factor : pi.QuantityReceived;
                            var remaining = pi.QuantityRemaining;
                            var complete = remaining <= 0;
                            var unitLabel = pi.OrderedUnit?.ShortName ?? pi.Item?.Unit?.ShortName ?? "unit";
                            <tr class="@(complete ? "table-success" : "")" data-factor="@factor">
                                <td>
                                    <input type="hidden" name="poItemIds" value="@pi.Id" />
                                    <strong>@(pi.Item?.ItemName ?? $"Item #{pi.ItemId}")</strong>
                                    <div class="small text-muted">@(pi.Item?.ItemCode) — @unitLabel</div>
                                </td>
                                <td class="text-end">@pi.Quantity.ToString("0.###")</td>
                                <td class="text-end">
                                    @if (receivedOrdered > 0)
                                    { <span class="text-success">@receivedOrdered.ToString("0.###")</span> }
                                    else { <span class="text-muted">0</span> }
                                </td>
                                <td class="text-end">
                                    @if (complete)
                                    { <span class="badge badge-soft-success">Complete</span> }
                                    else
                                    { <span class="fw-semibold text-warning">@remaining.ToString("0.###")</span> }
                                </td>
                                <td class="text-end small">
                                    @currency@((pi.CostPerOrderedUnit > 0 ? pi.CostPerOrderedUnit : pi.UnitCost * factor).ToString("N2"))
                                </td>
                                <td class="text-end small text-muted base-preview" data-row="@pi.Id">—</td>
                                <td>
                                    @if (complete)
                                    {
                                        <input type="number" name="receivedQtys" class="form-control form-control-sm receive-input"
                                               value="0" min="0" readonly />
                                    }
                                    else
                                    {
                                        <input type="number" name="receivedQtys"
                                               class="form-control form-control-sm receive-input qty-accept"
                                               value="@remaining.ToString("0.###")"
                                               min="0" max="@remaining.ToString("0.###")" step="0.001"
                                               data-remaining="@remaining.ToString("0.###")" />
                                    }
                                </td>
                                <td>
                                    <input type="number" name="damagedQtys"
                                           class="form-control form-control-sm qty-damaged"
                                           value="0" min="0" step="0.001"
                                           @(complete ? "readonly" : "") />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-truck me-1"></i>Receive Delivery
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function updateBasePreview(row) {
        const accept = parseFloat(row.querySelector('.qty-accept')?.value || 0);
        const factor = parseFloat(row.dataset.factor || 1);
        const preview = row.querySelector('.base-preview');
        if (preview && accept > 0) {
            preview.textContent = (accept * factor).toFixed(3) + ' base';
        } else if (preview) {
            preview.textContent = '—';
        }
    }

    document.querySelectorAll('tr[data-factor]').forEach(row => {
        row.querySelector('.qty-accept')?.addEventListener('input', () => updateBasePreview(row));
        row.querySelector('.qty-damaged')?.addEventListener('input', () => updateBasePreview(row));
        updateBasePreview(row);
    });

    document.getElementById('receiveForm').addEventListener('submit', function (e) {
        const form = this;
        if (HbForm.isConfirmed(form)) return;

        e.preventDefault();

        let valid = true;
        form.querySelectorAll('tr[data-factor]').forEach(row => {
            const accept = parseFloat(row.querySelector('.qty-accept')?.value || 0);
            const damaged = parseFloat(row.querySelector('.qty-damaged')?.value || 0);
            const remaining = parseFloat(row.querySelector('.qty-accept')?.dataset.remaining || 0);
            if (accept + damaged > remaining + 0.0001) {
                valid = false;
            }
        });

        if (!valid) {
            Swal.fire({ icon: 'error', title: 'Over-receipt', text: 'Accepted + damaged cannot exceed remaining quantity.', confirmButtonColor: '#1e40af' });
            return;
        }

        const hasQty = Array.from(form.querySelectorAll('.receive-input, .qty-damaged'))
            .some(inp => parseFloat(inp.value) > 0);

        if (!hasQty) {
            Swal.fire({ icon: 'warning', title: 'No quantities', text: 'Enter at least one accepted or damaged quantity.', confirmButtonColor: '#1e40af' });
            return;
        }

        HbForm.confirmAndSubmit(form);
    });
</script>
}
