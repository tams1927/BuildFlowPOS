@model HardwareManagementSystem.ViewModels.PagedResult<HardwareManagementSystem.Models.StockInHeader>
@using HardwareManagementSystem.ViewModels

@{
    ViewData["Title"] = "Stock In";

    var suppliers = ViewBag.Suppliers as List<HardwareManagementSystem.Models.Supplier>;
    var items = ViewBag.Items as List<HardwareManagementSystem.Models.Item>;
}

<div class="row g-3 mb-4">

    <div class="col-xl-4 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-box-arrow-in-down"></i>
            </div>

            <div class="kpi-label">Total Stock In</div>

            <div class="kpi-value">@Model.TotalRecords</div>

            <div class="kpi-trend">
                Received inventory transactions
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-cash-stack"></i>
            </div>

            <div class="kpi-label">Total Inventory Cost</div>

            <div class="kpi-value">
                ₱@Model.Items.Sum(h => h.TotalCost).ToString("N2")
            </div>

            <div class="kpi-trend">
                Stock-in purchase value
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-12">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-box-seam"></i>
            </div>

            <div class="kpi-label">Total Quantity Received</div>

            <div class="kpi-value">
                @Model.Items.Sum(h => h.StockInDetails.Sum(d => d.Quantity)).ToString("0.###")
            </div>

            <div class="kpi-trend">
                Total units/items received
            </div>
        </div>
    </div>

</div>

<div class="hb-card">

    <div class="hb-card-header">

        <div>
            <h2 class="hb-section-title">
                Stock In Management
            </h2>

            <div class="hb-section-subtitle">
                Receive inventory deliveries and update item stocks
            </div>
        </div>

        <div class="d-flex gap-2">

            <button class="btn btn-outline-primary">
                <i class="bi bi-download me-1"></i>
                Export
            </button>

            <button class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#addStockInModal">

                <i class="bi bi-plus-circle me-1"></i>
                New Stock In

            </button>

        </div>

    </div>

    <div class="hb-card-body">

        <form method="get" asp-controller="StockIn" asp-action="Index">
        <div class="row g-3 mb-4">

            <div class="col-lg-5">
                <label class="form-label fw-semibold">Search Stock In</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           name="searchTerm"
                           class="form-control border-start-0"
                           value="@Model.SearchTerm"
                           placeholder="Search supplier, item, invoice..." />
                </div>
            </div>

            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <input type="hidden" name="pageNumber" value="1" />

            <div class="col-lg-2 d-flex align-items-end">
                <button class="btn btn-primary w-100" type="submit">
                    <i class="bi bi-funnel me-1"></i>
                    Filter
                </button>
            </div>

        </div>
        </form>

        <div class="table-responsive">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Stock In #</th>
                        <th>Date</th>
                        <th>Supplier</th>
                        <th>Invoice</th>
                        <th>Item</th>
                        <th>Quantity</th>
                        <th>Total Cost</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Items.Any())
                    {
                        foreach (var header in Model.Items)
                        {
                            var detail = header.StockInDetails.FirstOrDefault();

                            <tr class="stockin-row"
                                data-supplier="@(header.Supplier?.SupplierName.ToLower() ?? "")">

                                <td>
                                    <strong>
                                        @header.StockInNumber
                                    </strong>
                                </td>

                                <td>
                                    @header.DateReceived.ToString("MMM dd, yyyy")
                                </td>

                                <td>
                                    @(header.Supplier?.SupplierName ?? "N/A")
                                </td>

                                <td>
                                    @(header.InvoiceNumber ?? "-")
                                </td>

                                <td>
                                    @(detail?.Item?.ItemName ?? "N/A")

                                    <div class="text-muted small">
                                        @(detail?.Item?.Unit?.ShortName ?? "")
                                    </div>
                                </td>

                                <td>
                                    @detail?.Quantity.ToString("0.###")
                                </td>

                                <td>
                                    ₱@header.TotalCost.ToString("N2")
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center py-5">

                                <div class="text-muted">

                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>

                                    No stock-in records found.

                                </div>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        @await Html.PartialAsync("_Pagination", PaginationMeta.From(Model, "StockIn", "Index", new Dictionary<string, string?> { ["searchTerm"] = Model.SearchTerm }))

    </div>

</div>

<div class="modal fade"
     id="addStockInModal"
     tabindex="-1"
     aria-labelledby="addStockInModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-xl">

        <div class="modal-content border-0 shadow-lg rounded-4">

            <div class="modal-header border-0 pb-0">

                <div>

                    <h5 class="modal-title fw-bold"
                        id="addStockInModalLabel">

                        New Stock In

                    </h5>

                    <div class="text-muted small">
                        Receive inventory and update item stock automatically
                    </div>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form asp-controller="StockIn"
                  asp-action="Create"
                  method="post"
                  class="confirm-submit">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-md-4">

                            <label class="form-label fw-semibold">
                                Supplier
                            </label>

                            <select name="supplierId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select Supplier
                                </option>

                                @if (suppliers != null)
                                {
                                    foreach (var supplier in suppliers)
                                    {
                                        <option value="@supplier.Id">
                                            @supplier.SupplierName
                                        </option>
                                    }
                                }

                            </select>

                        </div>

                        <div class="col-md-4">

                            <label class="form-label fw-semibold">
                                Invoice Number
                            </label>

                            <input type="text"
                                   name="invoiceNumber"
                                   class="form-control"
                                   placeholder="Optional invoice #" />

                        </div>

                        <div class="col-md-4">

                            <label class="form-label fw-semibold">
                                Date Received
                            </label>

                            <input type="date"
                                   name="dateReceived"
                                   class="form-control"
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                   required />

                        </div>

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Inventory Item
                            </label>

                            <select id="stockInItemSelect"
                                    name="itemId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select Item
                                </option>

                                @if (items != null)
                                {
                                    foreach (var item in items)
                                    {
                                        <option value="@item.Id"
                                                data-unit="@(item.Unit?.ShortName ?? "")"
                                                data-stock="@item.CurrentStock">

                                            @item.ItemCode - @item.ItemName

                                        </option>
                                    }
                                }

                            </select>

                        </div>

                        <div class="col-md-3">

                            <label class="form-label fw-semibold">
                                Quantity
                            </label>

                            <input type="number"
                                   step="0.001"
                                   min="0.001"
                                   name="quantity"
                                   class="form-control"
                                   value="1"
                                   required />

                        </div>

                        <div class="col-md-3">

                            <label class="form-label fw-semibold">
                                Unit Cost
                            </label>

                            <input type="number"
                                   step="0.01"
                                   min="0"
                                   name="unitCost"
                                   class="form-control"
                                   value="0"
                                   required />

                        </div>

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Unit
                            </label>

                            <input type="text"
                                   id="stockInUnitDisplay"
                                   class="form-control"
                                   readonly />

                        </div>

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Current Stock
                            </label>

                            <input type="text"
                                   id="stockInCurrentStockDisplay"
                                   class="form-control"
                                   readonly />

                        </div>

                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                Remarks
                            </label>

                            <textarea name="remarks"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Optional remarks..."></textarea>

                        </div>

                    </div>

                </div>

                <div class="modal-footer border-0 pt-0">

                    <button type="button"
                            class="btn btn-outline-primary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle me-1"></i>
                        Save Stock In

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.querySelectorAll('.confirm-submit').forEach(form => {

            form.addEventListener('submit', function (e) {

                e.preventDefault();

                const quantityVal = parseFloat(form.querySelector('[name="quantity"]')?.value || 0);
                const unitCostVal = parseFloat(form.querySelector('[name="unitCost"]')?.value || 0);

                if (quantityVal <= 0) {
                    Swal.fire({ icon: 'warning', title: 'Invalid Quantity', text: 'Quantity must be greater than zero.', confirmButtonColor: '#1e40af' });
                    form.querySelector('[name="quantity"]').focus();
                    return;
                }
                if (unitCostVal < 0) {
                    Swal.fire({ icon: 'warning', title: 'Invalid Unit Cost', text: 'Unit cost cannot be negative.', confirmButtonColor: '#1e40af' });
                    form.querySelector('[name="unitCost"]').focus();
                    return;
                }

                Swal.fire({
                    title: 'Save stock in?',
                    text: 'This will increase inventory stock.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, save it',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#2563eb',
                    cancelButtonColor: '#64748b'
                }).then((result) => {

                    if (result.isConfirmed) {
                        form.submit();
                    }

                });

            });

        });

        const stockInItemSelect =
            document.getElementById('stockInItemSelect');

        const stockInUnitDisplay =
            document.getElementById('stockInUnitDisplay');

        const stockInCurrentStockDisplay =
            document.getElementById('stockInCurrentStockDisplay');

        if (stockInItemSelect) {

            stockInItemSelect.addEventListener('change', function () {

                const selected =
                    this.options[this.selectedIndex];

                stockInUnitDisplay.value =
                    selected.getAttribute('data-unit') || '';

                stockInCurrentStockDisplay.value =
                    selected.getAttribute('data-stock') || '0';

            });

        }

        const stockInSearchInput =
            document.getElementById('stockInSearchInput');

        const stockInSupplierFilter =
            document.getElementById('stockInSupplierFilter');

        const stockInRows =
            document.querySelectorAll('.stockin-row');

        function filterStockIn() {

            const searchValue =
                stockInSearchInput.value.toLowerCase();

            const supplierValue =
                stockInSupplierFilter.value.toLowerCase();

            stockInRows.forEach(row => {

                const rowText =
                    row.innerText.toLowerCase();

                const rowSupplier =
                    row.getAttribute('data-supplier');

                const matchesSearch =
                    rowText.includes(searchValue);

                const matchesSupplier =
                    supplierValue === 'all' ||
                    rowSupplier === supplierValue;

                row.style.display =
                    matchesSearch && matchesSupplier
                        ? ''
                        : 'none';

            });

        }

        stockInSearchInput.addEventListener(
            'input',
            filterStockIn
        );

        stockInSupplierFilter.addEventListener(
            'change',
            filterStockIn
        );

    </script>

}