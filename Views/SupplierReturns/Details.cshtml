@model HardwareManagementSystem.Models.SupplierReturnHeader
@{
    ViewData["Title"] = $"Return {Model.ReturnNumber}";
    var detail = Model.Details.FirstOrDefault();
}

<div class="page-header-row mb-4">
    <div>
        <h2 class="page-section-title">@Model.ReturnNumber <span class="badge badge-soft-secondary ms-2">@Model.Status</span></h2>
        <p class="text-muted mb-0">@Model.Supplier?.SupplierName · @Model.ReturnDate.ToString("MMMM dd, yyyy")</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>

<div class="hb-card mb-4">
    <div class="hb-card-body">
        @if (detail != null)
        {
            <div class="row g-2">
                <div class="col-md-4"><strong>Item:</strong> @(detail.Item?.ItemName)</div>
                <div class="col-md-2"><strong>Qty:</strong> @detail.Quantity.ToString("0.###")</div>
                <div class="col-md-2"><strong>Base:</strong> @detail.BaseQuantity.ToString("0.###")</div>
                <div class="col-md-2"><strong>Reason:</strong> @detail.Reason</div>
            </div>
        }
        @if (Model.LinkedDamagedGoods != null)
        {
            <div class="small mt-2">
                Linked damage:
                <a asp-controller="DamagedGoods" asp-action="Details" asp-route-id="@Model.LinkedDamagedGoodsId">@Model.LinkedDamagedGoods.DamageNumber</a>
            </div>
        }
    </div>
</div>

@if (Model.Status is "Pending" or "Sent")
{
    <div class="d-flex flex-wrap gap-2">
        @if (Model.Status == "Pending")
        {
            <form asp-action="MarkSent" method="post" class="d-inline confirm-submit"
                  data-hb-confirm-title="Mark as sent?"
                  data-hb-confirm-text="Goods marked as sent to supplier."
                  data-hb-confirm-button="Yes, continue">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-primary">Mark Sent</button>
            </form>
            <form asp-action="Cancel" method="post" class="d-inline confirm-submit"
                  data-hb-confirm-title="Cancel return?"
                  data-hb-confirm-text="Stock effects will be reversed where applicable."
                  data-hb-confirm-icon="warning"
                  data-hb-confirm-button="Yes, continue"
                  data-hb-confirm-color="#dc2626">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-secondary">Cancel</button>
            </form>
        }
        <form asp-action="MarkCredited" method="post" class="d-inline confirm-submit"
              data-hb-confirm-title="Mark as credited?"
              data-hb-confirm-text="Damaged stock will be cleared when linked."
              data-hb-confirm-button="Yes, continue"
              data-hb-confirm-color="#16a34a">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-success">Mark Credited</button>
        </form>
        <form asp-action="MarkReplaced" method="post" class="d-inline confirm-submit"
              data-hb-confirm-title="Mark as replaced?"
              data-hb-confirm-text="Replacement stock will be added to sellable inventory."
              data-hb-confirm-button="Yes, continue"
              data-hb-confirm-color="#16a34a">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-success">Mark Replaced</button>
        </form>
    </div>
}
