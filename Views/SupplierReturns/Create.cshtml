@{
    ViewData["Title"] = "New Supplier Return";
    var suppliers = ViewBag.Suppliers as List<HardwareManagementSystem.Models.Supplier>;
    var items = ViewBag.Items as List<HardwareManagementSystem.Models.Item>;
    var units = ViewBag.Units as List<HardwareManagementSystem.Models.Unit>;
    var branches = ViewBag.Branches as List<HardwareManagementSystem.Models.Branch>;
    var currentBranch = ViewBag.CurrentBranch as HardwareManagementSystem.Models.Branch;
    var reasons = ViewBag.Reasons as string[] ?? Array.Empty<string>();
    var linkedDamage = ViewBag.LinkedDamage as HardwareManagementSystem.Models.DamagedGoodsHeader;
}

<div class="hb-card">
    <div class="hb-card-header">
        <h2 class="hb-section-title">New Supplier Return</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
    </div>
    <div class="hb-card-body">
        @if (linkedDamage != null)
        {
            <div class="alert alert-info small">Linked to damage record @linkedDamage.DamageNumber — use Return to Supplier on the damage details page.</div>
        }
        <form asp-action="Create" method="post" class="confirm-submit"
              data-hb-confirm-title="Create supplier return?"
              data-hb-confirm-text="This will record items returned to the supplier."
              data-hb-confirm-button="Yes, create">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Supplier</label>
                    <select name="supplierId" class="form-select" required>
                        <option value="">Select supplier</option>
                        @foreach (var s in suppliers ?? new List<HardwareManagementSystem.Models.Supplier>())
                        {
                            <option value="@s.Id">@s.SupplierName</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Branch</label>
                    <select name="branchId" class="form-select">
                        @if (currentBranch != null) { <option value="@currentBranch.Id" selected>@currentBranch.Name</option> }
                        @foreach (var b in branches ?? new List<HardwareManagementSystem.Models.Branch>())
                        {
                            if (currentBranch?.Id != b.Id) { <option value="@b.Id">@b.Name</option> }
                        }
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Item</label>
                    <select name="itemId" id="itemId" class="form-select" required>
                        <option value="">Select item</option>
                        @foreach (var i in items ?? new List<HardwareManagementSystem.Models.Item>())
                        {
                            <option value="@i.Id" data-unit="@i.BaseUnitId">@i.ItemCode — @i.ItemName</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Unit</label>
                    <select name="unitId" id="unitId" class="form-select" required>
                        @foreach (var u in units ?? new List<HardwareManagementSystem.Models.Unit>())
                        {
                            <option value="@u.Id">@u.UnitName</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Quantity</label>
                    <input type="number" name="quantity" step="0.001" min="0.001" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Reason</label>
                    <select name="reason" class="form-select" required>
                        @foreach (var r in reasons) { <option value="@r">@r</option> }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Notes</label>
                    <textarea name="notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Create Return</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
document.getElementById('itemId')?.addEventListener('change', function () {
    const unitId = this.selectedOptions[0]?.dataset.unit;
    if (unitId) document.getElementById('unitId').value = unitId;
});
</script>
}
