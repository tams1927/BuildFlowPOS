@model HardwareManagementSystem.Models.DeliveryReceipt
@{
    ViewData["Title"] = $"DR {Model.DRNumber}";
    var badge = Model.Status switch {
        "Pending"   => "badge-soft-warning",
        "Delivered" => "badge-soft-success",
        "Cancelled" => "badge-soft-danger",
        _           => "badge-soft-secondary"
    };
}

<div class="page-header-row mb-4">
    <div>
        <h2 class="page-section-title">
            DR <span class="text-primary">@Model.DRNumber</span>
            <span class="badge @badge ms-2">@Model.Status</span>
        </h2>
        <p class="text-muted mb-0">
            @Model.DeliveryDate.ToString("MMMM dd, yyyy")
            @if (Model.Branch != null)
            {
                <span class="ms-2 badge badge-soft-secondary">@Model.Branch.Name</span>
            }
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.Status == "Pending")
        {
            <form asp-action="MarkDelivered" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check2-circle me-1"></i> Mark Delivered
                </button>
            </form>
            <form asp-action="Cancel" method="post" class="d-inline" id="formCancelDr">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="button" class="btn btn-outline-danger" id="btnCancelDr">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </button>
            </form>
        }
        <a asp-action="Print" asp-route-id="@Model.Id"
           class="btn btn-outline-secondary" target="_blank">
            <i class="bi bi-printer me-1"></i> Print
        </a>
        <a asp-action="DownloadPdf" asp-route-id="@Model.Id"
           class="btn btn-outline-secondary">
            <i class="bi bi-file-earmark-pdf me-1"></i> PDF
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="fw-bold text-uppercase text-muted small mb-2">Customer / Consignee</h6>
                <div class="fw-semibold fs-5">@(Model.Customer?.CustomerName ?? "Walk-in")</div>
                @if (!string.IsNullOrWhiteSpace(Model.DeliveryAddress))
                {
                    <div class="text-muted small mt-1"><i class="bi bi-geo-alt me-1"></i>@Model.DeliveryAddress</div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="fw-bold text-uppercase text-muted small mb-2">Delivery Details</h6>
                <table class="table table-sm table-borderless mb-0">
                    <tr><td class="text-muted small">Driver</td><td class="fw-semibold">@(Model.DriverName ?? "—")</td></tr>
                    <tr><td class="text-muted small">Status</td><td><span class="badge @badge">@Model.Status</span></td></tr>
                    @if (Model.DeliveredAtUtc.HasValue)
                    {
                        <tr><td class="text-muted small">Delivered</td><td>@Model.DeliveredAtUtc.Value.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</td></tr>
                    }
                    @if (Model.SalesHeader != null)
                    {
                        <tr>
                            <td class="text-muted small">Linked Sale</td>
                            <td>
                                <a asp-controller="Sales" asp-action="Index"
                                   class="badge badge-soft-primary text-decoration-none">
                                    @Model.SalesHeader.SalesNumber
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <tr><td class="text-muted small">Notes</td><td>@Model.Notes</td></tr>
                    }
                </table>
            </div>
        </div>
    </div>
</div>

<div class="hb-card mb-4">
    <div class="hb-card-body p-0">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Description</th>
                    <th class="text-end">Quantity</th>
                    <th>Unit</th>
                </tr>
            </thead>
            <tbody>
                @{int n = 1;}
                @foreach (var line in Model.Items.OrderBy(i => i.SortOrder))
                {
                    <tr>
                        <td class="text-muted small">@(n++)</td>
                        <td>
                            <div class="fw-semibold">@line.Description</div>
                            @if (line.Item != null)
                            {
                                <div class="text-muted small">SKU: @line.Item.ItemCode</div>
                            }
                        </td>
                        <td class="text-end fw-semibold">@line.Quantity.ToString("0.###")</td>
                        <td>@(line.Unit ?? line.Item?.Unit?.ShortName ?? "—")</td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-3">No items listed.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var btn = document.getElementById('btnCancelDr');
    if (btn) {
        btn.addEventListener('click', function () {
            Swal.fire({
                title: 'Cancel DR?',
                text: 'This delivery receipt will be cancelled.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, cancel',
                cancelButtonText: 'No'
            }).then(function (r) {
                if (r.isConfirmed) document.getElementById('formCancelDr').submit();
            });
        });
    }
})();
</script>
}
