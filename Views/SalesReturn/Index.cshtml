@model HardwareManagementSystem.ViewModels.PagedResult<HardwareManagementSystem.Models.SalesReturnHeader>
@using HardwareManagementSystem.ViewModels

@{
    ViewData["Title"] = "Sales Return";
}

<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon"><i class="bi bi-arrow-return-left"></i></div>
            <div class="kpi-label">Total Returns</div>
            <div class="kpi-value">@Model.TotalRecords</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon"><i class="bi bi-calendar-check"></i></div>
            <div class="kpi-label">Today's Returns</div>
            <div class="kpi-value">@Model.Items.Count(r => r.ReturnDate.Date == DateTime.Today)</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon"><i class="bi bi-cash-stack"></i></div>
            <div class="kpi-label">Total Refund</div>
            <div class="kpi-value">₱@Model.Items.Sum(r => r.RefundAmount).ToString("N2")</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon"><i class="bi bi-wallet2"></i></div>
            <div class="kpi-label">Today's Refund</div>
            <div class="kpi-value">₱@Model.Items.Where(r => r.ReturnDate.Date == DateTime.Today).Sum(r => r.RefundAmount).ToString("N2")</div>
        </div>
    </div>

</div>

<div class="hb-card">

    <div class="hb-card-header">
        <div>
            <h2 class="hb-section-title">Sales Returns</h2>
            <div class="hb-section-subtitle">Customer item return and refund history</div>
        </div>
        <a asp-controller="SalesReturn" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            New Return
        </a>
    </div>

    <div class="hb-card-body">

        <form method="get" asp-controller="SalesReturn" asp-action="Index" class="row g-3 mb-4">
            <div class="col-lg-6">
                <label class="form-label fw-semibold">Search Return</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           name="searchTerm"
                           class="form-control border-start-0"
                           value="@Model.SearchTerm"
                           placeholder="Return #, receipt #, reason, processed by..." />
                </div>
            </div>
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <input type="hidden" name="pageNumber" value="1" />
            <div class="col-lg-2 d-flex align-items-end">
                <button class="btn btn-primary w-100" type="submit" data-no-disable="true">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Return #</th>
                        <th>Receipt #</th>
                        <th>Items Returned</th>
                        <th>Refund Amount</th>
                        <th>Reason</th>
                        <th>Date</th>
                        <th>Processed By</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var ret in Model.Items)
                        {
                            <tr>
                                <td><strong>@ret.ReturnNumber</strong></td>
                                <td>@(ret.SalesHeader?.SalesNumber ?? "-")</td>
                                <td>
                                    @foreach (var detail in ret.SalesReturnDetails)
                                    {
                                        <div class="small">
                                            <strong>@(detail.Item?.ItemName ?? "N/A")</strong>
                                            <span class="text-muted">
                                                × @detail.QuantityReturned.ToString("0.###")
                                                @(detail.Item?.Unit?.ShortName ?? "")
                                            </span>
                                            @if (detail.RestoreToInventory)
                                            {
                                                <span class="badge badge-soft-success ms-1">Restocked</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td><strong>₱@ret.RefundAmount.ToString("N2")</strong></td>
                                <td>
                                    <span class="text-muted small">
                                        @(ret.Reason?.Length > 50 ? ret.Reason[..50] + "…" : ret.Reason ?? "-")
                                    </span>
                                </td>
                                <td>
                                    @ret.ReturnDate.ToString("MMM dd, yyyy")
                                    <div class="text-muted small">@ret.ReturnDate.ToString("hh:mm tt")</div>
                                </td>
                                <td>@(ret.CreatedBy ?? "-")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No sales returns found.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Pagination", PaginationMeta.From(Model, "SalesReturn", "Index", new Dictionary<string, string?> { ["searchTerm"] = Model.SearchTerm }))

    </div>

</div>