@model HardwareManagementSystem.ViewModels.PagedResult<HardwareManagementSystem.Models.CustomerLedger>
@using HardwareManagementSystem.ViewModels

@{
    ViewData["Title"] = "Customer Collections";

    var customers = ViewBag.Customers as List<HardwareManagementSystem.Models.Customer>;
    int? selectedCustomerId = ViewBag.SelectedCustomerId as int?;

    var selectedCustomer = customers?.FirstOrDefault(c => c.Id == selectedCustomerId);

    var currentBalance = (decimal)(ViewBag.CurrentBalance ?? 0m);
    var totalCharges = (decimal)(ViewBag.TotalCharges ?? 0m);
    var totalPayments = (decimal)(ViewBag.TotalPayments ?? 0m);
}

<div class="row g-3 mb-4">

    <div class="col-xl-4 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-person-lines-fill"></i>
            </div>

            <div class="kpi-label">
                Selected Customer
            </div>

            <div class="kpi-value">
                @(selectedCustomer?.CustomerName ?? "None")
            </div>

            <div class="kpi-trend">
                Customer account ledger
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-journal-plus"></i>
            </div>

            <div class="kpi-label">
                Total Charges
            </div>

            <div class="kpi-value">
                ₱@totalCharges.ToString("N2")
            </div>

            <div class="kpi-trend">
                Debit transactions
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-12">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-wallet2"></i>
            </div>

            <div class="kpi-label">
                Outstanding Balance
            </div>

            <div class="kpi-value">
                ₱@currentBalance.ToString("N2")
            </div>

            <div class="kpi-trend">
                Amount still collectible
            </div>
        </div>
    </div>

</div>

<div class="hb-card mb-4">

    <div class="hb-card-header">

        <div>
            <h2 class="hb-section-title">
                Customer Collections
            </h2>

            <div class="hb-section-subtitle">
                Track credit sales, customer payments, and running balances
            </div>
        </div>

        @if (selectedCustomerId.HasValue && currentBalance > 0)
        {
            <button class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#collectPaymentModal">

                <i class="bi bi-cash-coin me-1"></i>
                Collect Payment

            </button>
        }

    </div>

    <div class="hb-card-body">

        <form asp-controller="CustomerCollections"
              asp-action="Index"
              method="get"
              class="row g-3 mb-4">

            <div class="col-lg-10">

                <label class="form-label fw-semibold">
                    Customer
                </label>

                <select name="customerId"
                        class="form-select"
                        required>

                    <option value="">
                        Select Customer
                    </option>

                    @if (customers != null)
                    {
                        foreach (var customer in customers)
                        {
                            <option value="@customer.Id"
                                    selected="@(selectedCustomerId == customer.Id)">
                                @customer.CustomerName
                            </option>
                        }
                    }

                </select>

            </div>

            <div class="col-lg-2 d-flex align-items-end">

                <button type="submit"
                        class="btn btn-primary w-100">

                    <i class="bi bi-search me-1"></i>
                    View

                </button>

            </div>

            <input type="hidden" name="pageNumber" value="1" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />

        </form>

        @if (!selectedCustomerId.HasValue)
        {
            <div class="text-center text-muted py-5">

                <i class="bi bi-person-vcard fs-1 d-block mb-2"></i>

                Select a customer to view ledger and collections.

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Reference</th>
                            <th>Debit</th>
                            <th>Credit</th>
                            <th>Balance</th>
                            <th>Remarks</th>
                            <th>Created By</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Items.Any())
                        {
                            foreach (var row in Model.Items)
                            {
                                <tr>

                                    <td>
                                        @row.TransactionDate.ToString("MMM dd, yyyy")
                                        <div class="text-muted small">
                                            @row.TransactionDate.ToString("hh:mm tt")
                                        </div>
                                    </td>

                                    <td>
                                        @if (row.TransactionType == "CHARGE")
                                        {
                                            <span class="badge badge-soft-warning">
                                                Charge
                                            </span>
                                        }
                                        else if (row.TransactionType == "PAYMENT")
                                        {
                                            <span class="badge badge-soft-success">
                                                Payment
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-soft-primary">
                                                @row.TransactionType
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <strong>@row.ReferenceNumber</strong>
                                    </td>

                                    <td>
                                        ₱@row.DebitAmount.ToString("N2")
                                    </td>

                                    <td>
                                        ₱@row.CreditAmount.ToString("N2")
                                    </td>

                                    <td>
                                        <strong>
                                            ₱@row.RunningBalance.ToString("N2")
                                        </strong>
                                    </td>

                                    <td>
                                        @(row.Remarks ?? "-")
                                    </td>

                                    <td>
                                        @(row.CreatedBy ?? "-")
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center py-5">

                                    <div class="text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                        No ledger transactions found.
                                    </div>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @await Html.PartialAsync(
                "_Pagination",
                PaginationMeta.From(
                    Model,
                    "CustomerCollections",
                    "Index",
                    new Dictionary<string, string?>
                    {
                        ["customerId"] = selectedCustomerId?.ToString()
                    }))
        }

    </div>

</div>

@if (selectedCustomerId.HasValue && selectedCustomer != null)
{
    <div class="modal fade"
         id="collectPaymentModal"
         tabindex="-1">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow-lg rounded-4">

                <form asp-controller="CustomerCollections"
                      asp-action="CollectPayment"
                      method="post"
                      class="confirm-collection-form">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="customerId"
                           value="@selectedCustomerId" />

                    <div class="modal-header border-0 pb-0">

                        <div>
                            <h5 class="modal-title fw-bold">
                                Collect Payment
                            </h5>

                            <div class="text-muted small">
                                Customer: @selectedCustomer.CustomerName
                            </div>
                        </div>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>

                    <div class="modal-body">

                        <div class="alert alert-info">
                            Outstanding Balance:
                            <strong>
                                ₱@currentBalance.ToString("N2")
                            </strong>
                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Payment Amount
                            </label>

                            <input type="number"
                                   step="0.01"
                                   min="0.01"
                                   max="@currentBalance"
                                   name="paymentAmount"
                                   id="paymentAmount"
                                   class="form-control"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Payment Method
                            </label>

                            <select name="paymentMethod"
                                    id="collectionPaymentMethod"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select Payment Method
                                </option>

                                <option value="Cash">
                                    Cash
                                </option>

                                <option value="GCash">
                                    GCash
                                </option>

                                <option value="Bank Transfer">
                                    Bank Transfer
                                </option>

                            </select>

                        </div>

                        <div class="mb-3 d-none"
                             id="collectionReferenceContainer">

                            <label class="form-label fw-semibold">
                                Reference Number
                            </label>

                            <input type="text"
                                   name="referenceNumber"
                                   id="collectionReferenceNumber"
                                   class="form-control"
                                   placeholder="GCash / bank reference number" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Remarks
                            </label>

                            <textarea name="remarks"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Optional payment remarks"></textarea>

                        </div>

                    </div>

                    <div class="modal-footer border-0 pt-0">

                        <button type="button"
                                class="btn btn-outline-primary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-check-circle me-1"></i>
                            Save Payment

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const paymentMethod = document.getElementById('collectionPaymentMethod');
            const referenceContainer = document.getElementById('collectionReferenceContainer');
            const referenceNumber = document.getElementById('collectionReferenceNumber');

            paymentMethod?.addEventListener('change', function () {

                if (this.value === 'GCash' || this.value === 'Bank Transfer') {
                    referenceContainer.classList.remove('d-none');
                    referenceNumber.required = true;
                }
                else {
                    referenceContainer.classList.add('d-none');
                    referenceNumber.required = false;
                    referenceNumber.value = '';
                }

            });

            document.querySelectorAll('.confirm-collection-form')
                .forEach(form => {

                    form.addEventListener('submit', function (e) {

                        e.preventDefault();

                        const paymentInput =
                            document.getElementById('paymentAmount');

                        const amount =
                            parseFloat(paymentInput?.value || 0);

                        const max =
                            parseFloat(paymentInput?.getAttribute('max') || 0);

                        if (amount <= 0) {

                            Swal.fire({
                                icon: 'warning',
                                title: 'Invalid payment',
                                text: 'Payment amount must be greater than zero.'
                            });

                            paymentInput?.focus();

                            return;
                        }

                        if (amount > max) {

                            Swal.fire({
                                icon: 'warning',
                                title: 'Payment too high',
                                text: 'Payment cannot exceed outstanding balance.'
                            });

                            paymentInput?.focus();

                            return;
                        }

                        if (!paymentMethod?.value) {

                            Swal.fire({
                                icon: 'warning',
                                title: 'Payment method required',
                                text: 'Please select a payment method.'
                            });

                            paymentMethod?.focus();

                            return;
                        }

                        if ((paymentMethod.value === 'GCash' ||
                             paymentMethod.value === 'Bank Transfer') &&
                            !referenceNumber?.value?.trim()) {

                            Swal.fire({
                                icon: 'warning',
                                title: 'Reference required',
                                text: 'Reference number is required for this payment method.'
                            });

                            referenceNumber?.focus();

                            return;
                        }

                        Swal.fire({
                            title: 'Save payment?',
                            text: 'This will update the customer balance.',
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonText: 'Yes, save payment',
                            cancelButtonText: 'Cancel',
                            confirmButtonColor: '#2563eb',
                            cancelButtonColor: '#64748b'
                        }).then((result) => {

                            if (result.isConfirmed) {
                                form.submit();
                            }

                        });

                    });

                });

        });
    </script>
}