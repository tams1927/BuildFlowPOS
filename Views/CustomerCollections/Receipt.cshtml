@model HardwareManagementSystem.Models.CustomerLedger

@{
    Layout = "_Layout";

    ViewData["Title"] = "Collection Receipt";
}

<div class="row justify-content-center">

    <div class="col-xl-7">

        <div class="hb-card">

            <div class="hb-card-header">

                <div>
                    <h2 class="hb-section-title">
                        Collection Receipt
                    </h2>

                    <div class="hb-section-subtitle">
                        Customer payment acknowledgment
                    </div>
                </div>

                <div class="d-flex gap-2">

                    <button type="button"
                            class="btn btn-outline-primary"
                            onclick="window.print()">

                        <i class="bi bi-printer me-1"></i>
                        Print

                    </button>

                    <a asp-controller="CustomerCollections"
                       asp-action="Index"
                       asp-route-customerId="@Model.CustomerId"
                       class="btn btn-primary">

                        <i class="bi bi-arrow-left me-1"></i>
                        Back

                    </a>

                </div>

            </div>

            <div class="hb-card-body receipt-print-area">

                <div class="text-center mb-4">

                    <h3 class="fw-bold mb-1">
                        Hardware Supply POS
                    </h3>

                    <div class="text-muted">
                        Customer Collection Receipt
                    </div>

                </div>

                <hr />

                <div class="row g-4 mb-4">

                    <div class="col-md-6">

                        <div class="receipt-label">
                            Receipt Number
                        </div>

                        <div class="receipt-value">
                            @Model.ReferenceNumber
                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="receipt-label">
                            Date & Time
                        </div>

                        <div class="receipt-value">
                            @Model.TransactionDate.ToString("MMM dd, yyyy hh:mm tt")
                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="receipt-label">
                            Customer
                        </div>

                        <div class="receipt-value">
                            @(Model.Customer?.CustomerName ?? "N/A")
                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="receipt-label">
                            Collected By
                        </div>

                        <div class="receipt-value">
                            @(Model.CreatedBy ?? "N/A")
                        </div>

                    </div>

                </div>

                <table class="table table-bordered align-middle mb-4">

                    <tbody>

                        <tr>
                            <th width="40%">
                                Payment Method
                            </th>

                            <td>
                                @(Model.PaymentMethod ?? "N/A")
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Reference Number
                            </th>

                            <td>
                                @(string.IsNullOrWhiteSpace(Model.PaymentReferenceNumber)
                                                                ? "-"
                                                                : Model.PaymentReferenceNumber)
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Previous Balance
                            </th>

                            <td>
                                ₱@Model.BalanceBefore.ToString("N2")
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Payment Amount
                            </th>

                            <td class="fw-bold text-success">
                                ₱@Model.CreditAmount.ToString("N2")
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Remaining Balance
                            </th>

                            <td class="fw-bold text-danger">
                                ₱@Model.RunningBalance.ToString("N2")
                            </td>
                        </tr>

                    </tbody>

                </table>

                <div class="mb-4">

                    <div class="receipt-label mb-2">
                        Remarks
                    </div>

                    <div class="border rounded-3 p-3 bg-light">
                        @(string.IsNullOrWhiteSpace(Model.Remarks)
                                                ? "No remarks."
                                                : Model.Remarks)
                    </div>

                </div>

                <div class="row mt-5">

                    <div class="col-6 text-center">

                        <div class="border-top pt-2">
                            Customer Signature
                        </div>

                    </div>

                    <div class="col-6 text-center">

                        <div class="border-top pt-2">
                            Authorized Signature
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Styles {

    <style>

        .receipt-label {
            font-size: 0.85rem;
            color: #64748b;
            font-weight: 600;
            margin-bottom: 0.25rem;
        }

        .receipt-value {
            font-size: 1rem;
            font-weight: 700;
        }

        @@media print {

            body * {
                visibility: hidden;
            }

            .receipt-print-area,
            .receipt-print-area * {
                visibility: visible;
            }

            .receipt-print-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }

            .btn,
            .sidebar,
            .navbar,
            footer {
                display: none !important;
            }
        }

    </style>

}