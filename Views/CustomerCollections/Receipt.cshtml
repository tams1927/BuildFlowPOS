@model HardwareManagementSystem.Models.CustomerLedger
@{
    Layout = "~/Views/Shared/_PrintDoc.cshtml";
    ViewBag.PrintDocTitle  = "COLLECTION RECEIPT";
    ViewBag.PrintDocNumber = Model.ReferenceNumber ?? $"COL-{Model.Id:D6}";
    ViewBag.PrintDocDate   = Model.TransactionDate.ToString("MMMM dd, yyyy");

    var settings = ViewBag.PrintSettings as HardwareManagementSystem.Models.SystemSetting;
    var currency = settings?.CurrencySymbol ?? "₱";
}

@section DocActions {
    <button onclick="window.print()" class="btn-print">
        &#128438; Print / Save PDF
    </button>
    <a href="@Url.Action("Index", "CustomerCollections", new { customerId = Model.CustomerId })"
       class="btn-secondary-print">
        &#x2190; Back
    </a>
}

<!-- Customer + Receipt Info -->
<div class="doc-info-grid">
    <div>
        <div class="info-label">Customer</div>
        <div class="info-value">@(Model.Customer?.CustomerName ?? "N/A")</div>
        @if (!string.IsNullOrWhiteSpace(Model.Customer?.ContactNumber))
        {
            <div class="info-value muted">@Model.Customer.ContactNumber</div>
        }
    </div>
    <div>
        <div class="info-label">Date & Time</div>
        <div class="info-value">@Model.TransactionDate.ToString("MMMM dd, yyyy")</div>
        <div class="info-value muted">@Model.TransactionDate.ToString("hh:mm tt")</div>
    </div>
    <div>
        <div class="info-label">Collected By</div>
        <div class="info-value muted">@(Model.CreatedBy ?? "—")</div>
    </div>
    <div>
        <div class="info-label">Payment Method</div>
        <div class="info-value">@(Model.PaymentMethod ?? "—")</div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.PaymentReferenceNumber))
    {
        <div>
            <div class="info-label">Reference No.</div>
            <div class="info-value muted">@Model.PaymentReferenceNumber</div>
        </div>
    }
</div>

<!-- Payment Summary -->
<div class="doc-section-title">Payment Summary</div>

<table class="doc-table">
    <thead>
        <tr>
            <th>Description</th>
            <th class="text-right" style="width:150px">Amount</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Previous Balance</td>
            <td class="text-right">@currency@Model.BalanceBefore.ToString("N2")</td>
        </tr>
        <tr>
            <td><strong>Payment Received</strong></td>
            <td class="text-right" style="color:#065f46;font-weight:700;font-size:13px;">
                @currency@Model.CreditAmount.ToString("N2")
            </td>
        </tr>
    </tbody>
    <tfoot>
        <tr>
            <td class="text-right"><strong>Remaining Balance</strong></td>
            <td class="text-right"
                style="font-size:13px;color:@(Model.RunningBalance <= 0 ? "#065f46" : "#991b1b");">
                @(Model.RunningBalance <= 0 ? "FULLY PAID" : $"{currency}{Model.RunningBalance:N2}")
            </td>
        </tr>
    </tfoot>
</table>

@if (!string.IsNullOrWhiteSpace(Model.Remarks))
{
    <p style="font-size:11px;color:#666;margin-bottom:16px;">
        <span style="font-weight:600;color:#888;text-transform:uppercase;font-size:9px;">Remarks: </span>
        @Model.Remarks
    </p>
}

<!-- Signature area -->
<div class="sig-row two-col">
    <div class="sig-box">
        <div class="sig-name"></div>
        <div class="sig-label">Customer Signature</div>
    </div>
    <div class="sig-box">
        <div class="sig-name"></div>
        <div class="sig-label">Authorized / Collected By</div>
    </div>
</div>
