@model HardwareManagementSystem.ViewModels.PagedResult<HardwareManagementSystem.Models.AuditTrail>
@using HardwareManagementSystem.ViewModels

@{
    ViewData["Title"] = "Audit Trail";

    var moduleFilter = ViewBag.ModuleFilter as string;
    var actionFilter = ViewBag.ActionFilter as string;
}

<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-clock-history"></i>
            </div>
            <div class="kpi-label">Total Logs</div>
            <div class="kpi-value">@Model.TotalRecords</div>
            <div class="kpi-trend">Recent system activity</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-cart-check"></i>
            </div>
            <div class="kpi-label">POS Logs</div>
            <div class="kpi-value">@Model.Items.Count(l => l.ModuleName == "POS")</div>
            <div class="kpi-trend">Sales activities</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-percent"></i>
            </div>
            <div class="kpi-label">Discount Logs</div>
            <div class="kpi-value">@Model.Items.Count(l => l.ActionName == "DISCOUNT APPLIED")</div>
            <div class="kpi-trend">Discount monitoring</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-person-gear"></i>
            </div>
            <div class="kpi-label">User Logs</div>
            <div class="kpi-value">@Model.Items.Count(l => l.ModuleName == "Users")</div>
            <div class="kpi-trend">Account activities</div>
        </div>
    </div>

</div>

<div class="hb-card">

    <div class="hb-card-header">
        <div>
            <h2 class="hb-section-title">Audit Trail</h2>
            <div class="hb-section-subtitle">
                Track important system actions, cashier activities, discounts, and administrative changes
            </div>
        </div>
    </div>

    <div class="hb-card-body">

        <form method="get"
      asp-controller="AuditTrail"
      asp-action="Index">

    <div class="row g-3 mb-4">

        <div class="col-lg-4">

            <label class="form-label fw-semibold">
                Search Logs
            </label>

            <div class="input-group">

                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search"></i>
                </span>

                <input type="text"
                       name="searchTerm"
                       class="form-control border-start-0"
                       value="@Model.SearchTerm"
                       placeholder="Search user, module, action, description..." />

            </div>

        </div>

        <div class="col-lg-3">

            <label class="form-label fw-semibold">
                Module
            </label>

            <select name="moduleFilter"
                    class="form-select">

                <option value="">All Modules</option>

                <option value="POS"
                        selected="@(moduleFilter == "POS")">

                    POS

                </option>

                <option value="Inventory"
                        selected="@(moduleFilter == "Inventory")">

                    Inventory

                </option>

                <option value="StockIn"
                        selected="@(moduleFilter == "StockIn")">

                    StockIn

                </option>

                <option value="Users"
                        selected="@(moduleFilter == "Users")">

                    Users

                </option>

                <option value="Settings"
                        selected="@(moduleFilter == "Settings")">

                    Settings

                </option>

                <option value="RolePermissions"
                        selected="@(moduleFilter == "RolePermissions")">

                    RolePermissions

                </option>

                <option value="Sales"
                        selected="@(moduleFilter == "Sales")">

                    Sales

                </option>

                <option value="StockAdjustment"
                        selected="@(moduleFilter == "StockAdjustment")">

                    StockAdjustment

                </option>

                <option value="SalesReturn"
                        selected="@(moduleFilter == "SalesReturn")">

                    SalesReturn

                </option>

            </select>

        </div>

        <div class="col-lg-3">

            <label class="form-label fw-semibold">
                Action
            </label>

            <select name="actionFilter"
                    class="form-select">

                <option value="">All Actions</option>

                <option value="SALE"
                        selected="@(actionFilter == "SALE")">

                    Sale

                </option>

                <option value="DISCOUNT"
                        selected="@(actionFilter == "DISCOUNT")">

                    Discount

                </option>

                <option value="CREATED"
                        selected="@(actionFilter == "CREATED")">

                    Created

                </option>

                <option value="UPDATED"
                        selected="@(actionFilter == "UPDATED")">

                    Updated

                </option>

                <option value="DEACTIVATED"
                        selected="@(actionFilter == "DEACTIVATED")">

                    Deactivated

                </option>

            </select>

        </div>

        <input type="hidden"
               name="pageSize"
               value="@Model.PageSize" />

        <input type="hidden"
               name="pageNumber"
               value="1" />

        <div class="col-lg-2 d-flex align-items-end">

            <button class="btn btn-primary w-100"
                    type="submit">

                <i class="bi bi-funnel me-1"></i>

                Filter

            </button>

        </div>

    </div>

</form>

        <div class="table-responsive">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Date/Time</th>
                        <th>User</th>
                        <th>Module</th>
                        <th>Action</th>
                        <th>Description</th>
                        <th>Reference</th>
                        <th>Browser</th>
                        <th>OS</th>
                        <th>Device</th>
                        <th>IP Address</th>
                    </tr>
                </thead>

                <tbody>

            @if (Model.Items.Any())
            {
                foreach (var log in Model.Items)
                {
                    <tr class="audit-row"
                        data-module="@log.ModuleName.ToLower()"
                        data-action="@log.ActionName.ToLower()">

                        <td>
                            @log.CreatedAt.ToString("MMM dd, yyyy")

                            <div class="text-muted small">
                                @log.CreatedAt.ToString("hh:mm tt")
                            </div>
                        </td>

                        <td>
                            <strong>@(log.UserName ?? "Unknown")</strong>

                            <div class="text-muted small">
                                @(log.UserId ?? "No ID")
                            </div>
                        </td>

                        <td>
                            <span class="badge badge-soft-primary">
                                @log.ModuleName
                            </span>
                        </td>

                        <td>

                            @if (log.ActionName.Contains("DISCOUNT"))
                            {
                                <span class="badge badge-soft-warning">
                                    @log.ActionName
                                </span>
                            }
                            else if (log.ActionName.Contains("SALE"))
                            {
                                <span class="badge badge-soft-success">
                                    @log.ActionName
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-soft-primary">
                                    @log.ActionName
                                </span>
                            }

                        </td>

                        <td>
                            @log.Description
                        </td>

                        <td>

                            @if (!string.IsNullOrWhiteSpace(log.ReferenceType))
                            {
                                <div>
                                    <strong>@log.ReferenceType</strong>
                                </div>

                                <div class="text-muted small">
                                    @log.ReferenceId
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">
                                    N/A
                                </span>
                            }

                        </td>

                        <!-- BROWSER -->
                        <td>

                            <span class="badge badge-soft-primary">

                                <i class="bi bi-browser-chrome me-1"></i>

                                @(log.Browser ?? "Unknown")

                            </span>

                        </td>

                        <!-- OPERATING SYSTEM -->
                        <td>

                            @if (log.OperatingSystem == "Windows")
                            {
                                <span class="badge badge-soft-primary">
                                    <i class="bi bi-windows me-1"></i>
                                    Windows
                                </span>
                            }
                            else if (log.OperatingSystem == "Android")
                            {
                                <span class="badge badge-soft-success">
                                    <i class="bi bi-android2 me-1"></i>
                                    Android
                                </span>
                            }
                            else if (log.OperatingSystem == "iPhone")
                            {
                                <span class="badge badge-soft-dark">
                                    <i class="bi bi-apple me-1"></i>
                                    iPhone
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-soft-secondary">
                                    @(log.OperatingSystem ?? "Unknown")
                                </span>
                            }

                        </td>

                        <!-- DEVICE -->
                        <td>

                            @if (log.DeviceType == "Mobile")
                            {
                                <span class="badge badge-soft-warning">

                                    <i class="bi bi-phone me-1"></i>

                                    Mobile

                                </span>
                            }
                            else
                            {
                                <span class="badge badge-soft-success">

                                    <i class="bi bi-pc-display me-1"></i>

                                    Desktop

                                </span>
                            }

                        </td>

                        <!-- IP -->
                        <td>

                            <span class="text-muted small">
                                @(log.IpAddress ?? "N/A")
                            </span>

                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>

                    <td colspan="10"
                        class="text-center py-5">

                        <div class="text-muted">

                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>

                            No audit logs found.

                        </div>

                    </td>

                </tr>
            }

        </tbody>

            </table>

        </div>

        @await Html.PartialAsync("_Pagination", PaginationMeta.From(Model, "AuditTrail", "Index", new Dictionary<string, string?> { ["searchTerm"] = Model.SearchTerm, ["moduleFilter"] = moduleFilter, ["actionFilter"] = actionFilter }))

    </div>

</div>

@section Scripts {
}