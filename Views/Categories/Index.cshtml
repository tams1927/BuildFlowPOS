@model HardwareManagementSystem.ViewModels.PagedResult<HardwareManagementSystem.Models.Category>
@using HardwareManagementSystem.ViewModels

@{
    ViewData["Title"] = "Categories";
    var statusFilter = ViewBag.StatusFilter as string;
}

<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-tags"></i>
            </div>

            <div class="kpi-label">
                Total Categories
            </div>

            <div class="kpi-value">
                @Model.TotalRecords
            </div>

            <div class="kpi-trend">
                Organized inventory structure
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-box-seam"></i>
            </div>

            <div class="kpi-label">
                Inactive Categories
            </div>

            <div class="kpi-value">
                @Model.Items.Count(c => !c.IsActive)
            </div>

            <div class="kpi-trend">
                Disabled inventory groups
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-tools"></i>
            </div>

            <div class="kpi-label">
                Category Status
            </div>

            <div class="kpi-value">
                @(Model.Items.Any(c => c.IsActive) ? "Active" : "Empty")
            </div>

            <div class="kpi-trend">
                Inventory grouping health
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-bar-chart"></i>
            </div>

            <div class="kpi-label">
                Active Categories
            </div>

            <div class="kpi-value">
                @Model.Items.Count(c => c.IsActive)
            </div>

            <div class="kpi-trend">
                Currently in use
            </div>
        </div>
    </div>

</div>

<div class="hb-card">

    <div class="hb-card-header">

        <div>
            <h2 class="hb-section-title">
                Item Categories
            </h2>

            <div class="hb-section-subtitle">
                Manage hardware and construction supply categories
            </div>
        </div>

        <div class="d-flex gap-2">

            <button class="btn btn-outline-primary">
                <i class="bi bi-download me-1"></i>
                Export
            </button>

            <button class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#addCategoryModal">
                <i class="bi bi-plus-circle me-1"></i>
                Add Category
            </button>

        </div>

    </div>

    <div class="hb-card-body">

        <!-- FILTER -->

        <form method="get" asp-controller="Categories" asp-action="Index">
        <div class="row g-3 mb-4">

            <div class="col-lg-5">
                <label class="form-label fw-semibold">Search Category</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           name="searchTerm"
                           class="form-control border-start-0"
                           value="@Model.SearchTerm"
                           placeholder="Search category..." />
                </div>
            </div>

            <div class="col-lg-3">
                <label class="form-label fw-semibold">Status</label>
                <select name="statusFilter" class="form-select">
                    <option value="">All Status</option>
                    <option value="active" selected="@(statusFilter == "active")">Active</option>
                    <option value="inactive" selected="@(statusFilter == "inactive")">Inactive</option>
                </select>
            </div>

            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <input type="hidden" name="pageNumber" value="1" />

            <div class="col-lg-2 d-flex align-items-end">
                <button class="btn btn-primary w-100" type="submit" data-no-disable="true">
                    <i class="bi bi-funnel me-1"></i>
                    Filter
                </button>
            </div>

        </div>
        </form>

        <!-- TABLE -->

        <div class="table-responsive">

            <table class="table align-middle">

                <thead>

                    <tr>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th width="150">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model.Items.Any())
                    {
                        foreach (var category in Model.Items)
                        {
                            <tr class="category-row" data-status="@(category.IsActive ? "active" : "inactive")">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="kpi-icon mb-0" style="width:40px;height:40px;">
                                            <i class="bi bi-tags"></i>
                                        </div>

                                        <div>
                                            <strong>@category.CategoryName</strong>
                                            <div class="text-muted small">
                                                CAT-@category.Id.ToString("0000")
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @(category.Description ?? "No description")
                                </td>

                                <td>
                                    @if (category.IsActive)
                                    {
                                        <span class="badge badge-soft-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-warning">Inactive</span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex gap-1">

                                        <button class="btn btn-sm btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editCategoryModal"
                                                data-id="@category.Id"
                                                data-name="@category.CategoryName"
                                                data-description="@category.Description"
                                                data-active="@category.IsActive.ToString().ToLower()">
                                            <i class="bi bi-pencil"></i>
                                        </button>

                                        <form asp-controller="Categories"
                                              asp-action="Deactivate"
                                              method="post"
                                              class="confirm-deactivate d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@category.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    @(category.IsActive ? "" : "disabled")>
                                                <i class="bi bi-trash"></i>
                                            </button>

                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No categories found.
                                </div>
                            </td>
                        </tr>
                    }


                </tbody>

            </table>

        </div>

        @await Html.PartialAsync("_Pagination", PaginationMeta.From(Model, "Categories", "Index", new Dictionary<string, string?> { ["searchTerm"] = Model.SearchTerm, ["statusFilter"] = statusFilter }))

    </div>

</div>

<!-- ADD CATEGORY MODAL -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">

            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold" id="addCategoryModalLabel">
                        Add Category
                    </h5>
                    <div class="text-muted small">
                        Create a new hardware item category
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <form asp-controller="Categories" asp-action="Create" method="post" class="confirm-submit">
                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Category Name
                        </label>

                        <input type="text"
                               name="categoryName"
                               class="form-control"
                               placeholder="Example: Steel & Rebar"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Description
                        </label>

                        <textarea name="description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Optional description..."></textarea>
                    </div>

                </div>

                <div class="modal-footer border-0 pt-0">

                    <button type="button"
                            class="btn btn-outline-primary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i>
                        Save Category
                    </button>

                </div>
            </form>

        </div>
    </div>
</div>

<!-- EDIT CATEGORY MODAL (similar structure to Add Category Modal, with pre-filled values and update action) -->
    <div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">

                <div class="modal-header border-0 pb-0">

                    <div>
                        <h5 class="modal-title fw-bold" id="editCategoryModalLabel">
                            Edit Category
                        </h5>

                        <div class="text-muted small">
                            Update category information
                        </div>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <form asp-controller="Categories"
                      asp-action="Edit"
                      method="post"
                      class="confirm-submit">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="editCategoryId"
                           name="id" />

                    <div class="modal-body">

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Category Name
                            </label>

                            <input type="text"
                                   id="editCategoryName"
                                   name="categoryName"
                                   class="form-control"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea id="editCategoryDescription"
                                      name="description"
                                      class="form-control"
                                      rows="3"></textarea>

                        </div>

                        <div class="form-check form-switch">

                            <input class="form-check-input"
                                   type="checkbox"
                                   id="editCategoryActive"
                                   name="isActive"
                                   value="true" />

                            <label class="form-check-label">
                                Active Category
                            </label>

                        </div>

                    </div>

                    <div class="modal-footer border-0 pt-0">

                        <button type="button"
                                class="btn btn-outline-primary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-check-circle me-1"></i>
                            Update Category

                        </button>

                    </div>

                </form>

            

            </div>
        </div>
    </div>

@section Scripts {
    <script>
        document.querySelectorAll('.confirm-submit').forEach(form => {
            form.addEventListener('submit', function (e) {
                e.preventDefault();

                Swal.fire({
                    title: 'Save changes?',
                    text: 'Please confirm before saving this record.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, save it',
                    cancelButtonText: 'No, cancel',
                    confirmButtonColor: '#2563eb',
                    cancelButtonColor: '#64748b'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.requestSubmit();
                    }
                });
            });
        });

        document.querySelectorAll('.confirm-deactivate').forEach(form => {
            form.addEventListener('submit', function (e) {
                e.preventDefault();

                Swal.fire({
                    title: 'Deactivate this category?',
                    text: 'This category will no longer be available for new items.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, deactivate',
                    cancelButtonText: 'No, cancel',
                    confirmButtonColor: '#dc2626',
                    cancelButtonColor: '#64748b'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.requestSubmit();
                    }
                });
            });
        });

        const editCategoryModal = document.getElementById('editCategoryModal');

        if (editCategoryModal) {
            editCategoryModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;

                const id = button.getAttribute('data-id');
                const name = button.getAttribute('data-name');
                const description = button.getAttribute('data-description');
                const active = button.getAttribute('data-active') === 'true';

                document.getElementById('editCategoryId').value = id;
                document.getElementById('editCategoryName').value = name;
                document.getElementById('editCategoryDescription').value = description || '';
                document.getElementById('editCategoryActive').checked = active;
            });
        }

        const categorySearchInput = document.getElementById('categorySearchInput');
        const categoryStatusFilter = document.getElementById('categoryStatusFilter');
        const categoryRows = document.querySelectorAll('.category-row');

        function filterCategories() {
            const searchValue = categorySearchInput.value.toLowerCase();
            const statusValue = categoryStatusFilter.value.toLowerCase();

            categoryRows.forEach(row => {
                const rowText = row.innerText.toLowerCase();
                const rowStatus = row.getAttribute('data-status');

                const matchesSearch = rowText.includes(searchValue);
                const matchesStatus = statusValue === 'all' || rowStatus === statusValue;

                row.style.display = matchesSearch && matchesStatus ? '' : 'none';
            });
        }

        categorySearchInput.addEventListener('input', filterCategories);
        categoryStatusFilter.addEventListener('change', filterCategories);
    </script>
}