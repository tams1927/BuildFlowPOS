@model HardwareManagementSystem.ViewModels.SupplierPaymentViewModel

@{
    ViewData["Title"] = "Supplier Payment";
}

<div class="row justify-content-center">

    <div class="col-xl-7 col-lg-9">

        <!-- HEADER -->
        <div class="hb-card mb-4">

            <div class="hb-card-body">

                <div class="d-flex align-items-center gap-3">

                    <div class="kpi-icon">
                        <i class="bi bi-cash-coin"></i>
                    </div>

                    <div>
                        <h2 class="hb-section-title mb-1">
                            Supplier Payment
                        </h2>

                        <div class="hb-section-subtitle">
                            Record payment for supplier payable invoice
                        </div>
                    </div>

                </div>

            </div>

        </div>

        <!-- PAYMENT FORM -->
        <div class="hb-card">

            <div class="hb-card-header">

                <div>
                    <h2 class="hb-section-title">
                        Payment Information
                    </h2>

                    <div class="hb-section-subtitle">
                        Update supplier payable balance and payment status
                    </div>
                </div>

            </div>

            <div class="hb-card-body">

                <form asp-controller="SupplierPayments"
                      asp-action="Pay"
                      method="post"
                      class="confirm-submit">

                    @Html.AntiForgeryToken()

                    <input asp-for="StockInId" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger mb-4">
                    </div>

                    <!-- DETAILS -->
                    <div class="row g-3 mb-4">

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Stock-In Number
                            </label>

                            <input class="form-control"
                                   value="@Model.StockInNumber"
                                   readonly />

                        </div>

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Supplier
                            </label>

                            <input class="form-control"
                                   value="@Model.SupplierName"
                                   readonly />

                        </div>

                        <div class="col-md-4">

                            <label class="form-label fw-semibold">
                                Total Cost
                            </label>

                            <input class="form-control fw-bold"
                                   value="@Model.TotalCost.ToString("N2")"
                                   readonly />

                        </div>

                        <div class="col-md-4">

                            <label class="form-label fw-semibold">
                                Amount Paid
                            </label>

                            <input class="form-control text-success fw-bold"
                                   value="@Model.AmountPaid.ToString("N2")"
                                   readonly />

                        </div>

                        <div class="col-md-4">

                            <label class="form-label fw-semibold">
                                Balance Due
                            </label>

                            <input class="form-control text-warning fw-bold"
                                   value="@Model.BalanceDue.ToString("N2")"
                                   readonly />

                        </div>

                    </div>

                    <!-- PAYMENT -->
                    <div class="row g-3">

                        <div class="col-md-6">

                            <label asp-for="PaymentAmount"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    ₱
                                </span>

                                <input asp-for="PaymentAmount"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       min="0.01" />

                            </div>

                            <span asp-validation-for="PaymentAmount"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="PaymentMethod"
                                   class="form-label fw-semibold">
                            </label>

                            <select asp-for="PaymentMethod"
                                    class="form-select"
                                    id="paymentMethod">

                                <option value="">
                                    -- Select Payment Method --
                                </option>

                                <option value="Cash">
                                    Cash
                                </option>

                                <option value="GCash">
                                    GCash
                                </option>

                                <option value="Bank Transfer">
                                    Bank Transfer
                                </option>

                                <option value="Check">
                                    Check
                                </option>

                            </select>

                            <span asp-validation-for="PaymentMethod"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- REFERENCE -->
                        <div class="col-md-12"
                             id="referenceContainer"
                             style="display:none;">

                            <label asp-for="PaymentReferenceNumber"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="PaymentReferenceNumber"
                                   class="form-control"
                                   placeholder="Enter reference / check number" />

                        </div>

                        <!-- REMARKS -->
                        <div class="col-md-12">

                            <label asp-for="Remarks"
                                   class="form-label fw-semibold">
                            </label>

                            <textarea asp-for="Remarks"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Optional remarks">
                            </textarea>

                        </div>

                    </div>

                    <!-- ACTIONS -->
                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <a asp-controller="Reports"
                           asp-action="SupplierPayables"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left me-1"></i>

                            Back

                        </a>

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-check-circle me-1"></i>

                            Post Payment

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const paymentMethod =
            document.getElementById('paymentMethod');

        const referenceContainer =
            document.getElementById('referenceContainer');

        function toggleReferenceField() {

            const method = paymentMethod.value;

            if (method === 'GCash' ||
                method === 'Bank Transfer' ||
                method === 'Check') {

                referenceContainer.style.display = 'block';

            }
            else {

                referenceContainer.style.display = 'none';

            }

        }

        paymentMethod.addEventListener(
            'change',
            toggleReferenceField);

        toggleReferenceField();

    </script>

}