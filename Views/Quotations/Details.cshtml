@using HardwareManagementSystem.Models
@model HardwareManagementSystem.Models.Quotation
@{
    ViewData["Title"] = $"Quotation {Model.QuotationNo}";
    var currency = ViewBag.CurrencySymbol as string ?? "₱";
    var statusBadge = Model.Status switch {
        "Draft"     => "badge-soft-secondary",
        "Sent"      => "badge-soft-info",
        "Accepted"  => "badge-soft-success",
        "Expired"   => "badge-soft-warning",
        "Voided"    => "badge-soft-danger",
        "Converted" => "badge-soft-primary",
        _           => "badge-soft-secondary"
    };
}

<div class="page-header-row mb-4">
    <div>
        <h2 class="page-section-title">
            Quotation <span class="text-primary">@Model.QuotationNo</span>
            <span class="badge @statusBadge ms-2">@Model.Status</span>
        </h2>
        <p class="text-muted mb-0">
            @Model.QuotationDate.ToString("MMMM dd, yyyy")
            @if (Model.ValidUntil.HasValue)
            {
                <span class="ms-2">· Valid until <strong>@Model.ValidUntil.Value.ToString("MMM dd, yyyy")</strong></span>
            }
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.Status == "Draft")
        {
            <form asp-action="UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="Sent" />
                <button type="submit" class="btn btn-info text-white">
                    <i class="bi bi-send me-1"></i> Mark as Sent
                </button>
            </form>
        }
        @if (Model.Status == "Sent")
        {
            <form asp-action="UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="Accepted" />
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check2-circle me-1"></i> Accept
                </button>
            </form>
        }
        @if (Model.Status == "Accepted" && !Model.ConvertedToSaleId.HasValue)
        {
            <form asp-action="ConvertToSale" method="post"
                  onsubmit="return confirm('Convert this quotation to a sale? Stock will be deducted.')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-cart-check me-1"></i> Convert to Sale
                </button>
            </form>
        }
        @if (Model.Status != "Voided" && Model.Status != "Accepted" && Model.Status != "Converted")
        {
            <form asp-action="UpdateStatus" method="post"
                  onsubmit="return confirm('Void this quotation?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="Voided" />
                <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-x-circle me-1"></i> Void
                </button>
            </form>
        }
        @if (Model.ConvertedToSaleId.HasValue)
        {
            <a asp-controller="Sales" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-receipt me-1"></i> View Sale
            </a>
        }
        <a asp-action="Print" asp-route-id="@Model.Id"
           class="btn btn-outline-secondary" target="_blank">
            <i class="bi bi-printer me-1"></i> Print
        </a>
        <a asp-action="DownloadPdf" asp-route-id="@Model.Id"
           class="btn btn-outline-secondary">
            <i class="bi bi-file-earmark-pdf me-1"></i> PDF
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="fw-bold text-uppercase text-muted small mb-2">Customer</h6>
                <div class="fw-semibold fs-5">
                    @(Model.Customer?.CustomerName ?? Model.CustomerName ?? "Walk-in Customer")
                </div>
                @if (Model.Customer?.ContactNumber != null)
                {
                    <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@Model.Customer.ContactNumber</div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="fw-bold text-uppercase text-muted small mb-2">Details</h6>
                <table class="table table-sm table-borderless mb-0">
                    <tr><td class="text-muted small">Branch</td><td class="fw-semibold">@(Model.Branch?.Name ?? "All Branches")</td></tr>
                    <tr><td class="text-muted small">Created</td><td>@Model.CreatedAtUtc.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</td></tr>
                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <tr><td class="text-muted small">Notes</td><td>@Model.Notes</td></tr>
                    }
                </table>
            </div>
        </div>
    </div>
</div>

<!-- LINE ITEMS -->
<div class="hb-card mb-4">
    <div class="hb-card-body p-0">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Description</th>
                    <th class="text-end">Qty</th>
                    <th class="text-end">Unit Price</th>
                    <th class="text-end">Disc %</th>
                    <th class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @{int lineNo = 1;}
                @foreach (var item in Model.Items.OrderBy(i => i.SortOrder))
                {
                    <tr>
                        <td class="text-muted small">@(lineNo++)</td>
                        <td>
                            <div class="fw-semibold">@item.Description</div>
                            @if (item.Item != null)
                            {
                                <div class="text-muted small">SKU: @item.Item.ItemCode</div>
                            }
                        </td>
                        <td class="text-end">@item.Quantity.ToString("N4").TrimEnd('0').TrimEnd('.')</td>
                        <td class="text-end">@currency@item.UnitPrice.ToString("N2")</td>
                        <td class="text-end">@(item.DiscountPercent > 0 ? $"{item.DiscountPercent:N2}%" : "—")</td>
                        <td class="text-end fw-semibold">@currency@item.Subtotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light">
                    <td colspan="5" class="text-end fw-bold pe-3">TOTAL</td>
                    <td class="text-end fw-bold fs-5 text-primary">@currency@Model.TotalAmount.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
