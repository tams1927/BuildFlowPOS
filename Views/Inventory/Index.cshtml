@model HardwareManagementSystem.ViewModels.PagedResult<HardwareManagementSystem.Models.Item>
@using HardwareManagementSystem.ViewModels

@{
    ViewData["Title"] = "Inventory";

    var categories = ViewBag.Categories as List<HardwareManagementSystem.Models.Category>;
    var branches = ViewBag.Branches as List<HardwareManagementSystem.Models.Branch> ?? new();
    var selectedBranch = ViewBag.SelectedBranch as HardwareManagementSystem.Models.Branch;
    var branchStockMap = ViewBag.BranchStockMap as Dictionary<int, decimal>;
    var branchDamagedMap = ViewBag.BranchDamagedMap as Dictionary<int, decimal>;
    var categoryFilter = ViewBag.CategoryFilter as string;
    var stockFilter = ViewBag.StockFilter as string;
    int? branchIdFilter = ViewBag.BranchIdFilter as int?;

    decimal GetBranchStock(int itemId) =>
        branchStockMap != null && branchStockMap.TryGetValue(itemId, out var q) ? q : 0;

    decimal GetDamagedForItem(HardwareManagementSystem.Models.Item item) =>
        branchDamagedMap != null && branchDamagedMap.TryGetValue(item.Id, out var d) ? d : item.DamagedStock;
}

<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-box-seam"></i>
            </div>
            <div class="kpi-label">Total Items</div>
            <div class="kpi-value">@Model.TotalRecords</div>
            <div class="kpi-trend">Inventory records</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="kpi-label">Active Items</div>
            <div class="kpi-value">@(ViewBag.TotalActive ?? 0)</div>
            <div class="kpi-trend">Available for POS</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div class="kpi-label">Low Stock</div>
            <div class="kpi-value">@(ViewBag.TotalLowStock ?? 0)</div>
            <div class="kpi-trend text-warning">Needs restocking</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-x-circle"></i>
            </div>
            <div class="kpi-label">Out of Stock</div>
            <div class="kpi-value">@(ViewBag.TotalOutOfStock ?? 0)</div>
            <div class="kpi-trend text-danger">Critical inventory</div>
        </div>
    </div>

</div>

<div class="hb-card mb-4">

    <div class="hb-card-header">
        <div>
            <h2 class="hb-section-title">Inventory Dashboard</h2>
            <div class="hb-section-subtitle">
                Monitor stock levels for
                <strong>@(selectedBranch?.Name ?? "all branches")</strong>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-box-seam me-1"></i>
                Manage Products
            </a>
            <a asp-controller="StockIn" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-arrow-down-circle me-1"></i>
                Stock In
            </a>
        </div>
    </div>

    <div class="hb-card-body">

        <form method="get" asp-controller="Inventory" asp-action="Index">
            <div class="row g-3 mb-4">

                <div class="col-lg-3">
                    <label class="form-label fw-semibold">Search Item</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               name="searchTerm"
                               class="form-control border-start-0"
                               value="@Model.SearchTerm"
                               placeholder="Search item name, code, category..." />
                    </div>
                </div>

                @if (branches.Count > 1)
                {
                    <div class="col-lg-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-building me-1"></i>Branch
                        </label>
                        <select name="branchId" class="form-select">
                            @foreach (var b in branches)
                            {
                                <option value="@b.Id" selected="@(branchIdFilter == b.Id)">@b.Name</option>
                            }
                        </select>
                    </div>
                }

                <div class="col-lg-2">
                    <label class="form-label fw-semibold">Category</label>
                    <select name="categoryFilter" class="form-select">
                        <option value="">All Categories</option>
                        @if (categories != null)
                        {
                            foreach (var cat in categories)
                            {
                                <option value="@cat.CategoryName" selected="@(categoryFilter == cat.CategoryName)">@cat.CategoryName</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-lg-2">
                    <label class="form-label fw-semibold">Stock Status</label>
                    <select name="stockFilter" class="form-select">
                        <option value="">All Status</option>
                        <option value="low" selected="@(stockFilter == "low")">Low Stock</option>
                        <option value="out" selected="@(stockFilter == "out")">Out of Stock</option>
                    </select>
                </div>

                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <input type="hidden" name="pageNumber" value="1" />

                <div class="col-lg-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" type="submit" data-no-disable="true">
                        <i class="bi bi-funnel me-1"></i>
                        Filter
                    </button>
                </div>

            </div>
        </form>

        <div class="table-responsive">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Item Code</th>
                        <th>Item Name</th>
                        <th>Category</th>
                        <th>Unit</th>
                        <th>Sellable</th>
                        <th>Damaged</th>
                        <th>Physical</th>
                        <th>Reorder Lvl</th>
                        <th>Stock Value</th>
                        <th>Status</th>
                        <th width="100">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            // Use branch-specific stock when available; fall back to global CurrentStock (LEGACY)
                            var displayStock = branchStockMap != null
                                ? GetBranchStock(item.Id)
                                : item.CurrentStock;
                            var damagedStock = GetDamagedForItem(item);
                            var physicalStock = displayStock + damagedStock;

                            var stockValue = displayStock * item.CostPrice;

                            <tr>
                                <td><code class="text-primary fw-semibold">@item.ItemCode</code></td>

                                <td>
                                    <strong>@item.ItemName</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="text-muted small">@item.Description</div>
                                    }
                                </td>

                                <td>@(item.Category?.CategoryName ?? "—")</td>

                                <td>@(item.Unit?.ShortName ?? "—")</td>

                                <td>
                                    <strong class="@(displayStock <= 0 ? "text-danger" : displayStock <= item.ReorderLevel ? "text-warning" : "")">
                                        @displayStock.ToString("0.###")
                                    </strong>
                                </td>
                                <td class="text-muted">@damagedStock.ToString("0.###")</td>
                                <td>@physicalStock.ToString("0.###")</td>

                                <td class="text-muted">@item.ReorderLevel.ToString("0.###")</td>

                                <td>₱@stockValue.ToString("N2")</td>

                                <td>
                                    @if (item.Status == "Inactive")
                                    {
                                        <span class="badge badge-soft-secondary">Inactive</span>
                                    }
                                    else if (displayStock <= 0)
                                    {
                                        <span class="badge badge-soft-danger">Out of Stock</span>
                                    }
                                    else if (displayStock <= item.ReorderLevel)
                                    {
                                        <span class="badge badge-soft-warning">Low Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-success">In Stock</span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex gap-1">

                                        <a asp-controller="StockIn"
                                           asp-action="Index"
                                           asp-route-searchTerm="@item.ItemName"
                                           class="btn btn-sm btn-outline-primary"
                                           title="View Stock In history">
                                            <i class="bi bi-clock-history"></i>
                                        </a>

                                        <a asp-controller="StockAdjustment"
                                           asp-action="Index"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Stock Adjustment">
                                            <i class="bi bi-sliders"></i>
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No inventory items found.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

        @await Html.PartialAsync("_Pagination", PaginationMeta.From(Model, "Inventory", "Index",
            new Dictionary<string, string?>
            {
                ["searchTerm"] = Model.SearchTerm,
                ["categoryFilter"] = categoryFilter,
                ["stockFilter"] = stockFilter,
                ["branchId"] = branchIdFilter?.ToString()
            }))

    </div>

</div>
