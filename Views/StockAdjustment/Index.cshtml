@model HardwareManagementSystem.ViewModels.PagedResult<HardwareManagementSystem.Models.StockAdjustmentHeader>
@using HardwareManagementSystem.ViewModels

@{
    ViewData["Title"] = "Stock Adjustment";

    var typeFilter = ViewBag.TypeFilter as string;
}

<div class="row g-3 mb-4">

    <div class="col-xl-4 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-sliders"></i>
            </div>
            <div class="kpi-label">Total Adjustments</div>
            <div class="kpi-value">@Model.TotalRecords</div>
            <div class="kpi-trend">Manual stock corrections</div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-arrow-up-circle"></i>
            </div>
            <div class="kpi-label">Stock Increase</div>
            <div class="kpi-value">@Model.Items.Count(a => a.AdjustmentType == "Increase")</div>
            <div class="kpi-trend">Added adjustments</div>
        </div>
    </div>

    <div class="col-xl-4 col-md-12">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-arrow-down-circle"></i>
            </div>
            <div class="kpi-label">Stock Decrease</div>
            <div class="kpi-value">@Model.Items.Count(a => a.AdjustmentType == "Decrease")</div>
            <div class="kpi-trend">Deducted adjustments</div>
        </div>
    </div>

</div>

<div class="hb-card">

    <div class="hb-card-header">

        <div>
            <h2 class="hb-section-title">Stock Adjustment History</h2>
            <div class="hb-section-subtitle">
                Manual stock corrections for damaged, missing, recount, or initial stock fixes
            </div>
        </div>

        <a asp-controller="StockAdjustment"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            New Adjustment
        </a>

    </div>

    <div class="hb-card-body">

        <form method="get" asp-controller="StockAdjustment" asp-action="Index">
        <div class="row g-3 mb-4">

            <div class="col-lg-5">
                <label class="form-label fw-semibold">Search Adjustment</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           name="searchTerm"
                           class="form-control border-start-0"
                           value="@Model.SearchTerm"
                           placeholder="Search number, item, reason, user..." />
                </div>
            </div>

            <div class="col-lg-3">
                <label class="form-label fw-semibold">Type</label>
                <select name="typeFilter" class="form-select">
                    <option value="">All Types</option>
                    <option value="Increase" selected="@(typeFilter == "Increase")">Increase</option>
                    <option value="Decrease" selected="@(typeFilter == "Decrease")">Decrease</option>
                </select>
            </div>

            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <input type="hidden" name="pageNumber" value="1" />

            <div class="col-lg-2 d-flex align-items-end">
                <button class="btn btn-primary w-100" type="submit" data-no-disable="true"> 
                    <i class="bi bi-funnel me-1"></i>
                    Filter
                </button>
            </div>

        </div>
        </form>

        <div class="table-responsive">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Adjustment #</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Branch</th>
                        <th>Item</th>
                        <th>Qty</th>
                        <th>Before</th>
                        <th>After</th>
                        <th>Reason</th>
                        <th>Created By</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var adjustment in Model.Items)
                        {
                            var detail = adjustment.StockAdjustmentDetails.FirstOrDefault();

                            <tr class="adjustment-row"
                                data-type="@adjustment.AdjustmentType.ToLower()">

                                <td>
                                    <strong>@adjustment.AdjustmentNumber</strong>
                                </td>

                                <td>
                                    @adjustment.AdjustmentDate.ToString("MMM dd, yyyy")
                                    <div class="text-muted small">
                                        @adjustment.AdjustmentDate.ToString("hh:mm tt")
                                    </div>
                                </td>

                                <td>
                                    @if (adjustment.AdjustmentType == "Increase")
                                    {
                                        <span class="badge badge-soft-success">Increase</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-warning">Decrease</span>
                                    }
                                </td>

                                <td>
                                    @if (adjustment.Branch != null)
                                    {
                                        <span class="badge badge-soft-secondary">
                                            <i class="bi bi-building me-1"></i>@adjustment.Branch.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>

                                <td>
                                    <strong>@(detail?.Item?.ItemName ?? "N/A")</strong>
                                    <div class="text-muted small">
                                        @(detail?.Item?.ItemCode ?? "")
                                    </div>
                                </td>

                                <td>
                                    @detail?.Quantity.ToString("0.###")
                                </td>

                                <td>
                                    @detail?.StockBefore.ToString("0.###")
                                </td>

                                <td>
                                    <strong>@detail?.StockAfter.ToString("0.###")</strong>
                                </td>

                                <td>
                                    @(adjustment.Reason ?? "-")
                                </td>

                                <td>
                                    @(adjustment.CreatedBy ?? "Unknown")
                                </td>

                                <td>
                                    <a asp-action="PrintSlip" asp-route-id="@adjustment.Id"
                                       target="_blank" class="btn btn-sm btn-outline-secondary"
                                       title="Print Slip">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No stock adjustments found.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

        @await Html.PartialAsync("_Pagination", PaginationMeta.From(Model, "StockAdjustment", "Index", new Dictionary<string, string?> { ["searchTerm"] = Model.SearchTerm, ["typeFilter"] = typeFilter }))

    </div>

</div>

@section Scripts {
}