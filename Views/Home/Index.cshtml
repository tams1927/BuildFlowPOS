@{
    ViewData["Title"] = "Dashboard";

    decimal todaySales = ViewBag.TodaySales ?? 0;
    decimal monthlySales = ViewBag.MonthlySales ?? 0;
    decimal inventoryValue = ViewBag.InventoryValue ?? 0;
    decimal todayExpenses = ViewBag.TodayExpenses ?? 0;
    decimal totalReceivables = ViewBag.TotalReceivables ?? 0;
    decimal totalPayables = ViewBag.TotalPayables ?? 0;

    int todayTransactions = ViewBag.TodayTransactions ?? 0;
    int lowStockCount = ViewBag.LowStockCount ?? 0;
    int outOfStockCount = ViewBag.OutOfStockCount ?? 0;
    int totalItems = ViewBag.TotalItems ?? 0;
    int pendingTransfers = ViewBag.PendingTransfers ?? 0;

    int pendingPOCount           = ViewBag.PendingPOCount           ?? 0;
    int sentPOCount              = ViewBag.SentPOCount              ?? 0;
    int partiallyReceivedPOCount = ViewBag.PartiallyReceivedPOCount ?? 0;
    int criticalStockCount       = ViewBag.CriticalStockCount       ?? 0;
    int reorderStockCount        = ViewBag.ReorderStockCount        ?? 0;
    int overdueARCount           = ViewBag.OverdueARCount           ?? 0;
    decimal overdueAPAmount      = ViewBag.OverdueAPAmount          ?? 0m;

    decimal totalInventoryValue  = ViewBag.TotalInventoryValue      ?? 0m;
    int fastMovingCount          = ViewBag.FastMovingCount          ?? 0;
    int slowMovingCount          = ViewBag.SlowMovingCount          ?? 0;
    int deadStockCount           = ViewBag.DeadStockCount           ?? 0;
    int overstockCount           = ViewBag.OverstockCount           ?? 0;

    var healthScore = ViewBag.InventoryHealthScore as HardwareManagementSystem.ViewModels.InventoryHealthScore;
    var top10Fast     = ViewBag.Top10FastMoving as dynamic ?? new List<dynamic>();
    var top10LowStock = ViewBag.Top10LowStock   as dynamic ?? new List<dynamic>();
    var top10HighValue = ViewBag.Top10HighValue  as dynamic ?? new List<dynamic>();

    var recentSales = ViewBag.RecentSales as List<HardwareManagementSystem.Models.SalesHeader>;
    var lowStockItems = ViewBag.LowStockItems as List<HardwareManagementSystem.Models.Item>;
    var currentBranch = ViewBag.CurrentBranch as HardwareManagementSystem.Models.Branch;
    var subUsage = ViewBag.SubscriptionUsage as HardwareManagementSystem.Services.TenantUsageSummary;
}

@if (currentBranch != null)
{
    <div class="alert alert-info border-0 rounded-3 py-2 px-3 mb-4 d-flex align-items-center gap-2 small">
        <i class="bi bi-building fs-5"></i>
        <span>Showing data for <strong>@currentBranch.Name</strong>. Use the branch selector in the top bar to switch branches.</span>
    </div>
}

@if (User.IsInRole("TenantAdmin") && subUsage != null)
{
    <div class="hb-card mb-4">
        <div class="hb-card-header">
            <div>
                <h2 class="hb-section-title">
                    <i class="bi bi-layers me-2"></i>Subscription Usage
                </h2>
                <div class="hb-section-subtitle">
                    Plan: <strong>@subUsage.PlanName</strong>
                    &nbsp;�&nbsp;
                    Status:&nbsp;
                    @if (subUsage.Status.ToString() == "Active")
                    {
                        <span class="badge badge-soft-success">Active</span>
                    }
                    else if (subUsage.Status.ToString() == "Suspended")
                    {
                        <span class="badge badge-soft-warning">Suspended</span>
                    }
                    else
                    {
                        <span class="badge badge-soft-danger">@subUsage.Status</span>
                    }
                    @if (subUsage.ExpirationDate.HasValue)
                    {
                        <span class="ms-2 text-muted small">
                            &nbsp;�&nbsp; Expires: @subUsage.ExpirationDate.Value.ToString("MMM dd, yyyy")
                        </span>
                    }
                </div>
            </div>
        </div>
        <div class="hb-card-body">
            <div class="row g-4">

                <div class="col-md-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small fw-semibold">Branches</span>
                        <span class="small text-muted">@subUsage.Branches / @(subUsage.MaxBranches == 0 ? "8" : subUsage.MaxBranches.ToString())</span>
                    </div>
                    <div class="progress" style="height:8px;">
                        <div class="progress-bar @(subUsage.BranchPct >= 90 ? "bg-danger" : subUsage.BranchPct >= 70 ? "bg-warning" : "bg-success")"
                             role="progressbar"
                             style="width:@subUsage.BranchPct%"
                             aria-valuenow="@subUsage.BranchPct"
                             aria-valuemin="0"
                             aria-valuemax="100"></div>
                    </div>
                    <div class="text-muted small mt-1">@subUsage.BranchPct% used</div>
                </div>

                <div class="col-md-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small fw-semibold">Users</span>
                        <span class="small text-muted">@subUsage.Users / @(subUsage.MaxUsers == 0 ? "8" : subUsage.MaxUsers.ToString())</span>
                    </div>
                    <div class="progress" style="height:8px;">
                        <div class="progress-bar @(subUsage.UserPct >= 90 ? "bg-danger" : subUsage.UserPct >= 70 ? "bg-warning" : "bg-success")"
                             role="progressbar"
                             style="width:@subUsage.UserPct%"
                             aria-valuenow="@subUsage.UserPct"
                             aria-valuemin="0"
                             aria-valuemax="100"></div>
                    </div>
                    <div class="text-muted small mt-1">@subUsage.UserPct% used</div>
                </div>

                <div class="col-md-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small fw-semibold">Products</span>
                        <span class="small text-muted">@subUsage.Products / @(subUsage.MaxProducts == 0 ? "8" : subUsage.MaxProducts.ToString())</span>
                    </div>
                    <div class="progress" style="height:8px;">
                        <div class="progress-bar @(subUsage.ProductPct >= 90 ? "bg-danger" : subUsage.ProductPct >= 70 ? "bg-warning" : "bg-success")"
                             role="progressbar"
                             style="width:@subUsage.ProductPct%"
                             aria-valuenow="@subUsage.ProductPct"
                             aria-valuemin="0"
                             aria-valuemax="100"></div>
                    </div>
                    <div class="text-muted small mt-1">@subUsage.ProductPct% used</div>
                </div>

            </div>
        </div>
    </div>
}

<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div class="kpi-label">Today's Sales</div>
            <div class="kpi-value">@(ViewBag.CurrencySymbol)@todaySales.ToString("N2")</div>
            <div class="kpi-trend">Completed sales today</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
            <div class="kpi-label">Monthly Sales</div>
            <div class="kpi-value">@(ViewBag.CurrencySymbol)@monthlySales.ToString("N2")</div>
            <div class="kpi-trend">Current month revenue</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-receipt"></i>
            </div>
            <div class="kpi-label">Transactions</div>
            <div class="kpi-value">@todayTransactions</div>
            <div class="kpi-trend">Today completed POS</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-box-seam"></i>
            </div>
            <div class="kpi-label">Inventory Value</div>
            <div class="kpi-value">@(ViewBag.CurrencySymbol)@inventoryValue.ToString("N2")</div>
            <div class="kpi-trend">Current stock valuation</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-wallet2"></i>
            </div>
            <div class="kpi-label">Today's Expenses</div>
            <div class="kpi-value">@(ViewBag.CurrencySymbol)@todayExpenses.ToString("N2")</div>
            <div class="kpi-trend">Expenses recorded today</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <a asp-controller="Reports" asp-action="CustomerBalance" class="text-decoration-none">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(249,115,22,.12);color:#f97316;">
                    <i class="bi bi-people"></i>
                </div>
                <div class="kpi-label">Receivables</div>
                <div class="kpi-value @(totalReceivables > 0 ? "text-warning" : "")">@(ViewBag.CurrencySymbol)@totalReceivables.ToString("N2")</div>
                <div class="kpi-trend">Outstanding customer balances � View ?</div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-md-6">
        <a asp-controller="Reports" asp-action="SupplierPayables" class="text-decoration-none">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(239,68,68,.12);color:#ef4444;">
                    <i class="bi bi-truck"></i>
                </div>
                <div class="kpi-label">Payables</div>
                <div class="kpi-value @(totalPayables > 0 ? "text-danger" : "")">@(ViewBag.CurrencySymbol)@totalPayables.ToString("N2")</div>
                <div class="kpi-trend">Unpaid supplier balance due � View ?</div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-md-6">
        <a asp-controller="Reports" asp-action="CustomerAging" class="text-decoration-none">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(234,179,8,.12);color:#ca8a04;">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div class="kpi-label">Overdue Receivables</div>
                <div class="kpi-value @(overdueARCount > 0 ? "text-warning" : "")">@overdueARCount Cust.</div>
                <div class="kpi-trend">30+ days unpaid � AR Aging ?</div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-md-6">
        <a asp-controller="Reports" asp-action="SupplierAging" class="text-decoration-none">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(239,68,68,.12);color:#dc2626;">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div class="kpi-label">Overdue Payables</div>
                <div class="kpi-value @(overdueAPAmount > 0 ? "text-danger" : "")">@(ViewBag.CurrencySymbol)@overdueAPAmount.ToString("N2")</div>
                <div class="kpi-trend">30+ days unpaid � AP Aging ?</div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(99,102,241,.12);color:#6366f1;">
                <i class="bi bi-arrow-left-right"></i>
            </div>
            <div class="kpi-label">Pending Transfers</div>
            <div class="kpi-value">@pendingTransfers</div>
            <div class="kpi-trend">Pending/Approved branch transfers</div>
        </div>
    </div>

</div>

<!-- Purchase Order KPI Row -->
<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">
        <a asp-controller="PurchaseOrders" asp-action="Index" asp-route-statusFilter="Draft" class="text-decoration-none">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(100,116,139,.12);color:#64748b;">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
                <div class="kpi-label">Draft POs</div>
                <div class="kpi-value">@pendingPOCount</div>
                <div class="kpi-trend">Awaiting review &amp; send � View ?</div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-md-6">
        <a asp-controller="PurchaseOrders" asp-action="Index" asp-route-statusFilter="Sent" class="text-decoration-none">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(37,99,235,.12);color:#2563eb;">
                    <i class="bi bi-send"></i>
                </div>
                <div class="kpi-label">Sent POs</div>
                <div class="kpi-value">@sentPOCount</div>
                <div class="kpi-trend">Awaiting delivery � View ?</div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-md-6">
        <a asp-controller="PurchaseOrders" asp-action="Index" asp-route-statusFilter="PartiallyReceived" class="text-decoration-none">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(245,158,11,.12);color:#d97706;">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div class="kpi-label">Partially Received</div>
                <div class="kpi-value">@partiallyReceivedPOCount</div>
                <div class="kpi-trend">Incomplete delivery � View ?</div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-md-6">
        <a asp-controller="PurchaseOrders" asp-action="GenerateFromLowStock" class="text-decoration-none">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(239,68,68,.12);color:#ef4444;">
                    <i class="bi bi-exclamation-diamond"></i>
                </div>
                <div class="kpi-label">Critical / Low Stock</div>
                <div class="kpi-value">@(criticalStockCount + reorderStockCount)</div>
                <div class="kpi-trend">Generate reorder PO ?</div>
            </div>
        </a>
    </div>

</div>

<div class="row g-3 mb-4">

    <div class="col-xl-4 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-box"></i>
            </div>
            <div class="kpi-label">Total Items</div>
            <div class="kpi-value">@totalItems</div>
            <div class="kpi-trend">Active inventory records</div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div class="kpi-label">Low Stock</div>
            <div class="kpi-value">@lowStockCount</div>
            <div class="kpi-trend text-warning">Needs restocking</div>
        </div>
    </div>

    <div class="col-xl-4 col-md-12">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-x-circle"></i>
            </div>
            <div class="kpi-label">Out of Stock</div>
            <div class="kpi-value">@outOfStockCount</div>
            <div class="kpi-trend text-danger">Critical inventory</div>
        </div>
    </div>

</div>

<div class="row g-3">

    <div class="col-xl-7">

        <div class="hb-card h-100">

            <div class="hb-card-header">
                <div>
                    <h2 class="hb-section-title">Recent Sales</h2>
                    <div class="hb-section-subtitle">
                        Latest completed POS transactions
                    </div>
                </div>

                <a asp-controller="Sales"
                   asp-action="Index"
                   class="btn btn-outline-primary btn-sm">
                    View All
                </a>
            </div>

            <div class="hb-card-body">

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Receipt</th>
                                <th>Customer</th>
                                <th>Cashier</th>
                                <th>Total</th>
                                <th>Date</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (recentSales != null && recentSales.Any())
                            {
                                foreach (var sale in recentSales)
                                {
                                    <tr>
                                        <td>
                                            <strong>@sale.SalesNumber</strong>
                                        </td>

                                        <td>
                                            @(sale.Customer?.CustomerName ?? "Walk-in Customer")
                                        </td>

                                        <td>
                                            @(sale.CashierName ?? "Unknown")
                                        </td>

                                        <td>
                                            <strong>@(ViewBag.CurrencySymbol)@sale.TotalAmount.ToString("N2")</strong>
                                        </td>

                                        <td>
                                            @sale.SalesDate.ToString("MMM dd, yyyy")
                                            <div class="text-muted small">
                                                @sale.SalesDate.ToString("hh:mm tt")
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <div class="text-muted">
                                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                            No sales yet.
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>

        </div>

    </div>

    <div class="col-xl-5">

        <div class="hb-card h-100">

            <div class="hb-card-header">
                <div>
                    <h2 class="hb-section-title">
                        <i class="bi bi-exclamation-triangle text-warning me-1"></i>
                        Low Stock Alerts
                        @if (lowStockCount > 0)
                        {
                            <span class="badge bg-warning text-dark ms-1">@lowStockCount</span>
                        }
                        @if (outOfStockCount > 0)
                        {
                            <span class="badge bg-danger ms-1">@outOfStockCount Out</span>
                        }
                    </h2>
                    <div class="hb-section-subtitle">
                        @if (currentBranch != null)
                        {
                            <span>Branch: <strong>@currentBranch.Name</strong></span>
                        }
                        else
                        {
                            <span>All branches � items below reorder level</span>
                        }
                    </div>
                </div>
                <div class="d-flex gap-1">
                    <a asp-controller="PurchaseOrders" asp-action="GenerateFromLowStock"
                       class="btn btn-outline-danger btn-sm" title="Generate a PO for all low-stock items">
                        <i class="bi bi-lightbulb me-1"></i>Generate PO
                    </a>
                    <a asp-controller="StockAdjustment" asp-action="Index"
                       class="btn btn-outline-warning btn-sm" title="Go to Stock Adjustment">
                        <i class="bi bi-sliders me-1"></i>Adjust
                    </a>
                    <a asp-controller="Inventory" asp-action="Index"
                       class="btn btn-outline-primary btn-sm">
                        Inventory
                    </a>
                </div>
            </div>

            <div class="hb-card-body p-0">

                @if (lowStockItems != null && lowStockItems.Any())
                {
                    <div class="list-group list-group-flush">
                    @foreach (var item in lowStockItems)
                    {
                        var isCritical = item.CurrentStock <= 0;
                        <div class="list-group-item d-flex justify-content-between align-items-center px-3 py-2 @(isCritical ? "bg-danger bg-opacity-10" : "")">
                            <div>
                                <div class="fw-semibold @(isCritical ? "text-danger" : "")">@item.ItemName</div>
                                <div class="text-muted small">
                                    <code>@item.ItemCode</code>
                                    @if (item.Category != null)
                                    {
                                        <span class="ms-1">� @item.Category.CategoryName</span>
                                    }
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold @(isCritical ? "text-danger" : "text-warning")">
                                    @item.CurrentStock.ToString("0.###")
                                    <span class="text-muted fw-normal small">@(item.Unit?.ShortName ?? "")</span>
                                </div>
                                @if (isCritical)
                                {
                                    <span class="badge bg-danger">CRITICAL</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-warning">Low</span>
                                }
                            </div>
                        </div>
                    }
                    </div>
                    @if (lowStockCount > lowStockItems.Count)
                    {
                        <div class="text-center py-2 text-muted small border-top">
                            + @(lowStockCount - lowStockItems.Count) more items below reorder level
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-check-circle fs-1 d-block mb-2 text-success"></i>
                        All items are well-stocked.
                    </div>
                }

            </div>

        </div>

    </div>

</div>

@* -- INVENTORY INTELLIGENCE SECTION -------------------------------- *@
<div class="row g-3 mt-2">

    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="mb-0 fw-bold"><i class="bi bi-bar-chart-steps me-2 text-primary"></i>Inventory Intelligence</h4>
            <a asp-controller="Reports" asp-action="InventoryValuationReport" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-currency-exchange me-1"></i>Full Valuation
            </a>
        </div>
        <hr class="mt-2 mb-0" />
    </div>

    <div class="col-xl-2 col-md-4">
        <a asp-controller="Reports" asp-action="InventoryValuationReport" class="text-decoration-none">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(37,99,235,.12);color:#2563eb;"><i class="bi bi-currency-exchange"></i></div>
                <div class="kpi-label">Inventory Value</div>
                <div class="kpi-value fs-6">@(ViewBag.CurrencySymbol)@totalInventoryValue.ToString("N0")</div>
                <div class="kpi-trend">Total &#64; cost</div>
            </div>
        </a>
    </div>
    <div class="col-xl-2 col-md-4">
        <a asp-controller="Reports" asp-action="FastMovingItems" class="text-decoration-none">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(22,163,74,.12);color:#16a34a;"><i class="bi bi-graph-up-arrow"></i></div>
                <div class="kpi-label">Fast Moving</div>
                <div class="kpi-value fs-6 text-success">@fastMovingCount</div>
                <div class="kpi-trend">Items sold last 30 days</div>
            </div>
        </a>
    </div>
    <div class="col-xl-2 col-md-4">
        <a asp-controller="Reports" asp-action="SlowMovingItems" class="text-decoration-none">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(234,179,8,.12);color:#ca8a04;"><i class="bi bi-graph-down"></i></div>
                <div class="kpi-label">Slow Moving</div>
                <div class="kpi-value fs-6 @(slowMovingCount > 0 ? "text-warning" : "")">@slowMovingCount</div>
                <div class="kpi-trend">No activity 90+ days</div>
            </div>
        </a>
    </div>
    <div class="col-xl-2 col-md-4">
        <a asp-controller="Reports" asp-action="DeadStock" class="text-decoration-none">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(239,68,68,.12);color:#dc2626;"><i class="bi bi-archive"></i></div>
                <div class="kpi-label">Dead Stock</div>
                <div class="kpi-value fs-6 @(deadStockCount > 0 ? "text-danger" : "")">@deadStockCount</div>
                <div class="kpi-trend">0 sales in 90 days</div>
            </div>
        </a>
    </div>
    <div class="col-xl-2 col-md-4">
        <a asp-controller="Reports" asp-action="ReorderSuggestions" class="text-decoration-none">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(239,68,68,.12);color:#ef4444;"><i class="bi bi-cart-plus"></i></div>
                <div class="kpi-label">Needs Reorder</div>
                <div class="kpi-value fs-6 @(criticalStockCount + reorderStockCount > 0 ? "text-danger" : "")">@(criticalStockCount + reorderStockCount)</div>
                <div class="kpi-trend">At or below reorder level</div>
            </div>
        </a>
    </div>
    <div class="col-xl-2 col-md-4">
        <a asp-controller="Reports" asp-action="ABCAnalysis" class="text-decoration-none">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(139,92,246,.12);color:#7c3aed;"><i class="bi bi-bar-chart-steps"></i></div>
                <div class="kpi-label">ABC Analysis</div>
                <div class="kpi-value fs-6">Revenue</div>
                <div class="kpi-trend">Classify A/B/C items ?</div>
            </div>
        </a>
    </div>

    <div class="col-xl-4 col-lg-5">
        <div class="hb-card h-100">
            <div class="hb-card-header">
                <h2 class="hb-section-title"><i class="bi bi-heart-pulse me-2 text-danger"></i>Inventory Health Score</h2>
            </div>
            <div class="hb-card-body d-flex flex-column align-items-center justify-content-center gap-3 py-4">
                @if (healthScore != null)
                {
                    <div class="position-relative d-flex align-items-center justify-content-center"
                         style="width:120px;height:120px;border-radius:50%;background:conic-gradient(var(--bs-@healthScore.StatusColor) @(healthScore.Score * 3.6)deg, #e5e7eb 0);box-shadow:0 2px 16px rgba(0,0,0,.1);">
                        <div class="bg-white d-flex flex-column align-items-center justify-content-center rounded-circle" style="width:90px;height:90px;">
                            <div class="fw-bold fs-3 text-@healthScore.StatusColor">@healthScore.Score</div>
                            <div class="small text-muted">/100</div>
                        </div>
                    </div>
                    <div class="text-center">
                        <span class="badge bg-@healthScore.StatusColor fs-6 mb-1">@healthScore.Status</span>
                        <p class="small text-muted mb-0">@healthScore.Recommendation</p>
                    </div>
                    <div class="row g-2 w-100 text-center mt-1 small">
                        <div class="col-6"><span class="text-warning fw-semibold">@healthScore.LowStockCount</span> Low Stock</div>
                        <div class="col-6"><span class="text-danger fw-semibold">@healthScore.CriticalCount</span> Critical</div>
                        <div class="col-6"><span class="text-danger fw-semibold">@healthScore.DeadStockCount</span> Dead Stock</div>
                        <div class="col-6"><span class="text-warning fw-semibold">@healthScore.OverstockCount</span> Overstock</div>
                    </div>
                }
                else
                {
                    <div class="text-muted small">Health data unavailable</div>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-lg-7">
        <div class="hb-card h-100">
            <div class="hb-card-header">
                <h2 class="hb-section-title"><i class="bi bi-graph-up-arrow me-2 text-success"></i>Top 10 Fast Moving</h2>
                <a asp-controller="Reports" asp-action="FastMovingItems" class="btn btn-outline-success btn-sm">View All</a>
            </div>
            <div class="hb-card-body p-0">
                <div class="list-group list-group-flush">
                    @if (top10Fast != null)
                    {
                        int i = 1;
                        foreach (var item in top10Fast)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-3 py-2">
                                <div class="d-flex gap-2 align-items-center">
                                    <span class="badge bg-success rounded-pill">@i++</span>
                                    <div>
                                        <div class="fw-semibold small">@item.ItemName</div>
                                        <div class="text-muted" style="font-size:.75rem;"><code>@item.ItemCode</code></div>
                                    </div>
                                </div>
                                <span class="badge badge-soft-success">@((object)item.QtySold) sold</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-lg-6">
        <div class="hb-card h-100">
            <div class="hb-card-header">
                <h2 class="hb-section-title"><i class="bi bi-currency-exchange me-2 text-primary"></i>Top 10 High Value</h2>
                <a asp-controller="Reports" asp-action="InventoryValuationReport" class="btn btn-outline-primary btn-sm">Valuation</a>
            </div>
            <div class="hb-card-body p-0">
                <div class="list-group list-group-flush">
                    @if (top10HighValue != null)
                    {
                        int j = 1;
                        foreach (var item in top10HighValue)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-3 py-2">
                                <div class="d-flex gap-2 align-items-center">
                                    <span class="badge bg-primary rounded-pill">@j++</span>
                                    <div>
                                        <div class="fw-semibold small">@item.ItemName</div>
                                        <div class="text-muted" style="font-size:.75rem;"><code>@item.ItemCode</code></div>
                                    </div>
                                </div>
                                <span class="badge badge-soft-primary">@(ViewBag.CurrencySymbol)@((decimal)item.Value).ToString("N0")</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

</div>