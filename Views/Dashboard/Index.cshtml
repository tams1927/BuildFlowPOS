@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4 dashboard-page">

    <div class="dashboard-hero mb-4">
        <div>
            <div class="text-uppercase small fw-bold text-primary mb-2">
                Hardware Supply POS
            </div>
            <h1 class="fw-bold mb-2">Welcome back, Admin</h1>
            <p class="text-muted mb-0">
                Monitor sales, inventory, low stocks, and store activity in one place.
            </p>
        </div>

        <div class="hero-actions">
            <a href="#" class="btn btn-light shadow-sm rounded-pill px-4">
                + New Sale
            </a>
            <a href="#" class="btn btn-primary shadow-sm rounded-pill px-4">
                Stock In
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="premium-card kpi-card">
                <div class="kpi-icon bg-blue-soft text-primary">₱</div>
                <div>
                    <div class="kpi-label">Today's Sales</div>
                    <div class="kpi-value">₱0.00</div>
                    <div class="kpi-sub text-success">Ready for POS data</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="premium-card kpi-card">
                <div class="kpi-icon bg-green-soft text-success">📦</div>
                <div>
                    <div class="kpi-label">Inventory Items</div>
                    <div class="kpi-value">0</div>
                    <div class="kpi-sub">Products registered</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="premium-card kpi-card">
                <div class="kpi-icon bg-red-soft text-danger">⚠</div>
                <div>
                    <div class="kpi-label">Low Stocks</div>
                    <div class="kpi-value">0</div>
                    <div class="kpi-sub text-danger">Needs attention</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="premium-card kpi-card">
                <div class="kpi-icon bg-yellow-soft text-warning">🚚</div>
                <div>
                    <div class="kpi-label">Suppliers</div>
                    <div class="kpi-value">0</div>
                    <div class="kpi-sub">Active partners</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="premium-card h-100">
                <div class="card-head">
                    <div>
                        <h5 class="fw-bold mb-1">Sales Overview</h5>
                        <p class="text-muted small mb-0">Daily sales summary will appear here.</p>
                    </div>
                    <button class="btn btn-sm btn-outline-primary rounded-pill">View Reports</button>
                </div>

                <div class="empty-chart">
                    <div class="empty-chart-box">
                        <div class="empty-icon">📊</div>
                        <h6 class="fw-bold mb-1">No sales data yet</h6>
                        <p class="text-muted small mb-0">
                            Once POS transactions are added, your sales chart will be displayed here.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="premium-card h-100">
                <div class="card-head">
                    <div>
                        <h5 class="fw-bold mb-1">Quick Actions</h5>
                        <p class="text-muted small mb-0">Common store operations.</p>
                    </div>
                </div>

                <div class="quick-actions">
                    <a href="#" class="quick-action">
                        <span>🧾</span>
                        <div>
                            <strong>Open POS</strong>
                            <small>Start new transaction</small>
                        </div>
                    </a>

                    <a href="#" class="quick-action">
                        <span>📦</span>
                        <div>
                            <strong>Add Product</strong>
                            <small>Create inventory item</small>
                        </div>
                    </a>

                    <a href="#" class="quick-action">
                        <span>➕</span>
                        <div>
                            <strong>Stock In</strong>
                            <small>Add supplier delivery</small>
                        </div>
                    </a>

                    <a href="#" class="quick-action">
                        <span>📈</span>
                        <div>
                            <strong>Reports</strong>
                            <small>View sales and inventory</small>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-xl-7">
            <div class="premium-card">
                <div class="card-head">
                    <div>
                        <h5 class="fw-bold mb-1">Recent Transactions</h5>
                        <p class="text-muted small mb-0">Latest sales activity.</p>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 premium-table">
                        <thead>
                            <tr>
                                <th>Receipt</th>
                                <th>Customer</th>
                                <th>Payment</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    No transactions yet.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="premium-card">
                <div class="card-head">
                    <div>
                        <h5 class="fw-bold mb-1">Low Stock Watchlist</h5>
                        <p class="text-muted small mb-0">Items below reorder level.</p>
                    </div>
                </div>

                <div class="stock-empty">
                    <div class="stock-badge">✓</div>
                    <div>
                        <strong>No low stock items</strong>
                        <p class="text-muted small mb-0">
                            Inventory alerts will appear here once products are added.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>