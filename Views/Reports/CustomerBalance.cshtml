@model HardwareManagementSystem.ViewModels.PagedResult<HardwareManagementSystem.ViewModels.CustomerBalanceReportViewModel>
@using HardwareManagementSystem.ViewModels

@{
    ViewData["Title"] = "Customer Balance Report";

    var customerType = ViewBag.CustomerType as string;

    var totalOutstanding = Model.Items.Sum(x => x.OutstandingBalance);
    var totalCharges = Model.Items.Sum(x => x.TotalCharges);
    var totalPayments = Model.Items.Sum(x => x.TotalPayments);
}

<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">

        <div class="kpi-card">

            <div class="kpi-icon">
                <i class="bi bi-people"></i>
            </div>

            <div class="kpi-label">
                Customers Shown
            </div>

            <div class="kpi-value">
                @Model.Items.Count()
            </div>

            <div class="kpi-trend">
                Current page records
            </div>

        </div>

    </div>

    <div class="col-xl-3 col-md-6">

        <div class="kpi-card">

            <div class="kpi-icon">
                <i class="bi bi-journal-plus"></i>
            </div>

            <div class="kpi-label">
                Total Charges
            </div>

            <div class="kpi-value">
                ₱@totalCharges.ToString("N2")
            </div>

            <div class="kpi-trend">
                Customer charge sales
            </div>

        </div>

    </div>

    <div class="col-xl-3 col-md-6">

        <div class="kpi-card">

            <div class="kpi-icon">
                <i class="bi bi-cash-coin"></i>
            </div>

            <div class="kpi-label">
                Total Payments
            </div>

            <div class="kpi-value text-success">
                ₱@totalPayments.ToString("N2")
            </div>

            <div class="kpi-trend">
                Customer collections
            </div>

        </div>

    </div>

    <div class="col-xl-3 col-md-6">

        <div class="kpi-card">

            <div class="kpi-icon">
                <i class="bi bi-wallet2"></i>
            </div>

            <div class="kpi-label">
                Outstanding Balance
            </div>

            <div class="kpi-value text-danger">
                ₱@totalOutstanding.ToString("N2")
            </div>

            <div class="kpi-trend">
                Total collectible amount
            </div>

        </div>

    </div>

</div>

<div class="hb-card">

    <div class="hb-card-header">

        <div>

            <h2 class="hb-section-title">
                Customer Balance Report
            </h2>

            <div class="hb-section-subtitle">
                Outstanding customer balances, charges, and payment tracking
            </div>

        </div>

        <a asp-controller="Reports"
           asp-action="Index"
           class="btn btn-outline-primary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Reports

        </a>

    </div>

    <div class="hb-card-body">

        <form method="get"
              asp-controller="Reports"
              asp-action="CustomerBalance"
              class="row g-3 mb-4">

            <div class="col-lg-5">

                <label class="form-label fw-semibold">
                    Search
                </label>

                <input type="text"
                       name="searchTerm"
                       value="@Model.SearchTerm"
                       class="form-control"
                       placeholder="Customer name or contact..." />

            </div>

            <div class="col-lg-3">

                <label class="form-label fw-semibold">
                    Customer Type
                </label>

                <select name="customerType"
                        class="form-select">

                    <option value="">
                        All Types
                    </option>

                    <option value="Walk-in"
                            selected="@(customerType == "Walk-in")">
                        Walk-in
                    </option>

                    <option value="Contractor"
                            selected="@(customerType == "Contractor")">
                        Contractor
                    </option>

                    <option value="Company"
                            selected="@(customerType == "Company")">
                        Company
                    </option>

                </select>

            </div>

            <input type="hidden"
                   name="pageSize"
                   value="@Model.PageSize" />

            <input type="hidden"
                   name="pageNumber"
                   value="1" />

            <div class="col-lg-2 d-flex align-items-end">

                <button type="submit"
                        class="btn btn-primary w-100">

                    <i class="bi bi-funnel me-1"></i>
                    Filter

                </button>

            </div>

        </form>

        <div class="table-responsive">

            <table class="table align-middle">

                <thead>

                    <tr>

                        <th>Customer</th>
                        <th>Type</th>
                        <th>Contact</th>
                        <th>Total Charges</th>
                        <th>Total Payments</th>
                        <th>Outstanding Balance</th>
                        <th>Last Transaction</th>
                        <th width="120">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Items.Any())
                    {
                        foreach (var row in Model.Items)
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @row.CustomerName
                                    </strong>

                                </td>

                                <td>

                                    <span class="badge badge-soft-primary">
                                        @row.CustomerType
                                    </span>

                                </td>

                                <td>
                                    @(row.ContactNumber ?? "N/A")
                                </td>

                                <td>

                                    ₱@row.TotalCharges.ToString("N2")

                                </td>

                                <td>

                                    <span class="text-success fw-bold">
                                        ₱@row.TotalPayments.ToString("N2")
                                    </span>

                                </td>

                                <td>

                                    <span class="text-danger fw-bold">
                                        ₱@row.OutstandingBalance.ToString("N2")
                                    </span>

                                </td>

                                <td>

                                    @if (row.LastTransactionDate.HasValue)
                                    {
                                        @row.LastTransactionDate.Value.ToString("MMM dd, yyyy")

                                        <div class="text-muted small">
                                            @row.LastTransactionDate.Value.ToString("hh:mm tt")
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No transactions
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="d-flex gap-1">

                                        <a asp-controller="CustomerCollections"
                                           asp-action="Index"
                                           asp-route-customerId="@row.CustomerId"
                                           class="btn btn-sm btn-outline-primary"
                                           title="View Ledger">

                                            <i class="bi bi-journal-text"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center py-5">

                                <div class="text-muted">

                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>

                                    No customer balances found.

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        @await Html.PartialAsync(
        "_Pagination",
                PaginationMeta.From(
                Model,
                "Reports",
                "CustomerBalance",
                new Dictionary<string, string?>
                {
                    ["searchTerm"] = Model.SearchTerm,
                    ["customerType"] = customerType
                }))

    </div>

</div>