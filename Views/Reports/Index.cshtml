@model HardwareManagementSystem.ViewModels.ReportsDashboardViewModel

@{
    ViewData["Title"] = "Reports Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="hb-section-title mb-1">
            Reports Dashboard
        </h2>

        <div class="hb-section-subtitle">
            Sales, collections, inventory, and business analytics overview
        </div>
    </div>

    <form method="get"
          asp-controller="Reports"
          asp-action="Index"
          class="row g-2 align-items-end">

        <div class="col-auto">

            <label class="form-label fw-semibold">
                Date From
            </label>

            <input type="date"
                   name="dateFrom"
                   value="@Model.DateFrom.ToString("yyyy-MM-dd")"
                   class="form-control" />

        </div>

        <div class="col-auto">

            <label class="form-label fw-semibold">
                Date To
            </label>

            <input type="date"
                   name="dateTo"
                   value="@Model.DateTo.ToString("yyyy-MM-dd")"
                   class="form-control" />

        </div>

        <div class="col-auto">

            <label class="form-label fw-semibold">
                Report Type
            </label>

            <select name="reportType"
                    id="reportType"
                    class="form-select">

                <option value="All">
                    All Summary
                </option>

                <option value="Sales">
                    Sales Report
                </option>

                <option value="Payments">
                    Payment Summary
                </option>

                <option value="TopSelling">
                    Top Selling Items
                </option>

                <option value="CustomerBalances">
                    Customer Balances
                </option>

                <option value="Collections">
                    Collections
                </option>

                <option value="Returns">
                    Returns
                </option>

                <option value="Inventory">
                    Inventory Status
                </option>

            </select>

        </div>

        <div class="col-auto">

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-funnel me-1"></i>
                Apply Filter

            </button>

        </div>


        <div class="col-auto">
            <a asp-controller="Reports"
               asp-action="Print"
               asp-route-dateFrom="@Model.DateFrom.ToString("yyyy-MM-dd")"
               asp-route-dateTo="@Model.DateTo.ToString("yyyy-MM-dd")"
               target="_blank"
               class="btn btn-info text-dark fw-semibold border-0">

                <i class="bi bi-printer me-1"></i>
                Print

            </a>
            <button type="submit"
                    formaction="@Url.Action("ExportExcel", "Reports")"
                    formmethod="get"
                    class="btn btn-success">

                <i class="bi bi-file-earmark-excel me-1"></i>
                Export Excel

            </button>

        </div>

    </form>

</div>

<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-cash-stack"></i>
            </div>

            <div class="kpi-label">
                Gross Sales
            </div>

            <div class="kpi-value">
                ₱@Model.GrossSales.ToString("N2")
            </div>

            <div class="kpi-trend">
                Before discounts
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-wallet2"></i>
            </div>

            <div class="kpi-label">
                Net Sales
            </div>

            <div class="kpi-value">
                ₱@Model.NetSales.ToString("N2")
            </div>

            <div class="kpi-trend">
                Final completed sales
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-percent"></i>
            </div>

            <div class="kpi-label">
                Discounts
            </div>

            <div class="kpi-value text-warning">
                ₱@Model.TotalDiscounts.ToString("N2")
            </div>

            <div class="kpi-trend">
                Total discount amount
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-receipt"></i>
            </div>

            <div class="kpi-label">
                Transactions
            </div>

            <div class="kpi-value">
                @Model.TransactionCount
            </div>

            <div class="kpi-trend">
                Completed transactions
            </div>
        </div>
    </div>

</div>

<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">

            <div class="kpi-icon">
                <i class="bi bi-cash"></i>
            </div>

            <div class="kpi-label">
                Cash Sales
            </div>

            <div class="kpi-value">
                ₱@Model.CashSales.ToString("N2")
            </div>

            <div class="kpi-trend">
                Cash payments
            </div>

        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">

            <div class="kpi-icon">
                <i class="bi bi-phone"></i>
            </div>

            <div class="kpi-label">
                GCash Sales
            </div>

            <div class="kpi-value">
                ₱@Model.GCashSales.ToString("N2")
            </div>

            <div class="kpi-trend">
                Digital collections
            </div>

        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">

            <div class="kpi-icon">
                <i class="bi bi-journal-plus"></i>
            </div>

            <div class="kpi-label">
                Credit Sales
            </div>

            <div class="kpi-value text-warning">
                ₱@Model.CreditSales.ToString("N2")
            </div>

            <div class="kpi-trend">
                Charged to customers
            </div>

        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">

            <div class="kpi-icon">
                <i class="bi bi-cash-coin"></i>
            </div>

            <div class="kpi-label">
                Collections
            </div>

            <div class="kpi-value text-success">
                ₱@Model.Collections.ToString("N2")
            </div>

            <div class="kpi-trend">
                Customer payments
            </div>

        </div>
    </div>

</div>

<div class="row g-3 mb-4">

    <div class="col-xl-4">
        <div class="hb-card h-100">

            <div class="hb-card-header">
                <h5 class="mb-0">
                    Inventory Status
                </h5>
            </div>

            <div class="hb-card-body">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <div class="text-muted small">
                            Low Stock
                        </div>

                        <div class="fs-3 fw-bold text-warning">
                            @Model.LowStockCount
                        </div>
                    </div>

                    <i class="bi bi-exclamation-triangle fs-1 text-warning"></i>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">
                            Out of Stock
                        </div>

                        <div class="fs-3 fw-bold text-danger">
                            @Model.OutOfStockCount
                        </div>
                    </div>

                    <i class="bi bi-x-circle fs-1 text-danger"></i>
                </div>

            </div>

        </div>
    </div>

    <div class="col-xl-4">
        <div class="hb-card h-100">

            <div class="hb-card-header">
                <h5 class="mb-0">
                    Returns & Voids
                </h5>
            </div>

            <div class="hb-card-body">

                <div class="mb-3">
                    <div class="text-muted small">
                        Sales Returns
                    </div>

                    <div class="fs-4 fw-bold text-danger">
                        ₱@Model.Returns.ToString("N2")
                    </div>
                </div>

                <div>
                    <div class="text-muted small">
                        Voided Sales
                    </div>

                    <div class="fs-4 fw-bold text-warning">
                        ₱@Model.VoidedSales.ToString("N2")
                    </div>
                </div>

            </div>

        </div>
    </div>

    <div class="col-xl-4">
        <div class="hb-card h-100">

            <div class="hb-card-header">
                <h5 class="mb-0">
                    Customer Credit
                </h5>
            </div>

            <div class="hb-card-body">

                <div class="text-muted small mb-2">
                    Outstanding Balance
                </div>

                <div class="fs-2 fw-bold text-primary">
                    ₱@Model.OutstandingCustomerBalance.ToString("N2")
                </div>

                <div class="text-muted small mt-2">
                    Total collectible amount
                </div>

            </div>

        </div>
    </div>

</div>

<div class="row g-3">

    <div class="col-xl-6">

        <div class="hb-card">

            <div class="hb-card-header">
                <h5 class="mb-0">
                    Top Selling Items
                </h5>
            </div>

            <div class="hb-card-body">

                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Qty Sold</th>
                                <th>Sales Amount</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.TopSellingItems.Any())
                            {
                                foreach (var item in Model.TopSellingItems)
                                {
                                    <tr>

                                        <td>
                                            @item.ItemName
                                        </td>

                                        <td>
                                            @item.QuantitySold.ToString("N2")
                                        </td>

                                        <td class="fw-bold">
                                            ₱@item.SalesAmount.ToString("N2")
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3"
                                        class="text-center text-muted py-4">

                                        No sales data found.

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

    <div class="col-xl-6">

        <div class="hb-card mb-3">

            <div class="hb-card-header">
                <h5 class="mb-0">
                    Payment Summary
                </h5>
            </div>

            <div class="hb-card-body">

                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>Payment Method</th>
                                <th>Transactions</th>
                                <th>Total</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.PaymentSummary.Any())
                            {
                                foreach (var payment in Model.PaymentSummary)
                                {
                                    <tr>

                                        <td>
                                            @payment.PaymentMethod
                                        </td>

                                        <td>
                                            @payment.TransactionCount
                                        </td>

                                        <td class="fw-bold">
                                            ₱@payment.TotalAmount.ToString("N2")
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3"
                                        class="text-center text-muted py-4">

                                        No payment data found.

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <div class="hb-card">

            <div class="hb-card-header">
                <h5 class="mb-0">
                    Customers With Balance
                </h5>
            </div>

            <div class="hb-card-body">

                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Balance</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.CustomerBalances.Any())
                            {
                                foreach (var customer in Model.CustomerBalances)
                                {
                                    <tr>

                                        <td>
                                            @customer.CustomerName
                                        </td>

                                        <td class="fw-bold text-danger">
                                            ₱@customer.Balance.ToString("N2")
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2"
                                        class="text-center text-muted py-4">

                                        No customer balances found.

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>