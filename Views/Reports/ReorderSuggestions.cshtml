@model HardwareManagementSystem.ViewModels.ReorderSuggestionsViewModel
@{
    ViewData["Title"] = "Reorder Suggestions";
    var categories = ViewBag.AllCategories as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var allBranches = ViewBag.AllBranches as IEnumerable<HardwareManagementSystem.Models.Branch> ?? Enumerable.Empty<HardwareManagementSystem.Models.Branch>();
    bool isGlobal = ViewBag.IsGlobalUser == true;
}

<div class="hb-card">
    <div class="hb-card-header">
        <div>
            <h2 class="hb-section-title"><i class="bi bi-cart-plus me-2 text-primary"></i>Reorder Suggestions</h2>
            <div class="hb-section-subtitle">Items at or below reorder level — @Model.Rows.Count items need restocking</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ReorderSuggestionsPdf" asp-route-branchId="@Model.BranchId" asp-route-categoryId="@Model.CategoryId"
               class="btn btn-outline-secondary btn-sm"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>
        </div>
    </div>
    <div class="hb-card-body">

        <form method="get" asp-action="ReorderSuggestions" class="mb-4">
            <div class="row g-2 align-items-end">
                @if (isGlobal)
                {
                    <div class="col-md-2"><label class="form-label small fw-semibold">Branch</label>
                        <select name="branchId" class="form-select form-select-sm">
                            <option value="">All Branches</option>
                            @foreach (var b in allBranches) { <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option> }
                        </select></div>
                }
                <div class="col-md-2"><label class="form-label small fw-semibold">Category</label>
                    <select name="categoryId" class="form-select form-select-sm">
                        <option value="">All Categories</option>
                        @foreach (var c in categories) { <option value="@c.Id" selected="@(Model.CategoryId == (int)c.Id)">@c.CategoryName</option> }
                    </select></div>
                <div class="col-md-1"><button type="submit" class="btn btn-primary btn-sm" data-no-disable="true"><i class="bi bi-funnel"></i></button></div>
            </div>
        </form>

        @if (Model.Rows.Any())
        {
            <div class="alert alert-info d-flex gap-2 align-items-center mb-4">
                <i class="bi bi-info-circle-fill"></i>
                <span>Select items below and click <strong>Generate Purchase Order</strong> to create a pre-filled PO.</span>
            </div>

            <form asp-action="GeneratePOFromReorder" method="post" id="reorderPOForm">
                @Html.AntiForgeryToken()
                @if (Model.BranchId.HasValue)
                { <input type="hidden" name="branchId" value="@Model.BranchId" /> }

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex gap-2">
                        <button type="button" id="selectAllBtn" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-check-all me-1"></i>Select All
                        </button>
                        <button type="button" id="clearAllBtn" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-x-square me-1"></i>Clear
                        </button>
                    </div>
                    <button type="button" id="generatePOBtn" class="btn btn-success">
                        <i class="bi bi-cart-plus me-1"></i>Generate Purchase Order
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead><tr>
                            <th width="40"><input type="checkbox" id="checkAll" class="form-check-input" /></th>
                            <th>SKU</th><th>Item Name</th><th>Category</th>
                            <th class="text-end">Current Stock</th>
                            <th class="text-end">Reorder Level</th>
                            <th class="text-end">Suggested Qty</th>
                            <th class="text-end">Avg/Month</th>
                            <th>Preferred Supplier</th>
                            <th class="text-end">Est. Cost</th>
                        </tr></thead>
                        <tbody>
                            @foreach (var r in Model.Rows)
                            {
                                var urgency = r.CurrentStock <= 0 ? "table-danger" : r.CurrentStock < r.ReorderLevel * 0.5m ? "table-warning" : "";
                                <tr class="@urgency">
                                    <td><input type="checkbox" class="form-check-input item-check"
                                               name="selectedItems" value="@r.ItemId" /></td>
                                    <td class="small text-muted">@r.ItemCode</td>
                                    <td><strong>@r.ItemName</strong></td>
                                    <td class="small">@r.Category</td>
                                    <td class="text-end @(r.CurrentStock <= 0 ? "text-danger fw-bold" : "")">@r.CurrentStock.ToString("N3")</td>
                                    <td class="text-end text-warning">@r.ReorderLevel.ToString("N3")</td>
                                    <td class="text-end fw-bold text-primary">@r.SuggestedQty.ToString("N0")</td>
                                    <td class="text-end text-muted small">@r.AvgMonthlySales.ToString("N1")</td>
                                    <td class="small">
                                        @if (r.PreferredSupplier != null) {
                                            <span class="badge badge-soft-primary">@r.PreferredSupplier</span>
                                        } else { <span class="text-muted">—</span> }
                                    </td>
                                    <td class="text-end">₱@((r.SuggestedQty * r.CostPrice).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="9" class="text-end fw-bold">Total Estimated Cost:</td>
                                <td class="text-end fw-bold">₱@Model.Rows.Sum(r => r.SuggestedQty * r.CostPrice).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </form>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-check-circle fs-1 d-block mb-2 text-success"></i>
                All items are above reorder levels. No restocking needed.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('checkAll')?.addEventListener('change', function () {
            document.querySelectorAll('.item-check').forEach(cb => cb.checked = this.checked);
        });
        document.getElementById('selectAllBtn')?.addEventListener('click', function () {
            document.querySelectorAll('.item-check').forEach(cb => cb.checked = true);
            const ca = document.getElementById('checkAll');
            if (ca) ca.checked = true;
        });
        document.getElementById('clearAllBtn')?.addEventListener('click', function () {
            document.querySelectorAll('.item-check').forEach(cb => cb.checked = false);
            const ca = document.getElementById('checkAll');
            if (ca) ca.checked = false;
        });
        document.getElementById('generatePOBtn')?.addEventListener('click', function () {
            const checked = document.querySelectorAll('.item-check:checked');
            if (checked.length === 0) {
                Swal.fire({ icon: 'warning', title: 'No Items Selected', text: 'Please select at least one item.', confirmButtonColor: '#2563eb' });
                return;
            }
            Swal.fire({
                title: 'Generate Purchase Order?',
                html: `Create a purchase order for <strong>${checked.length}</strong> selected item(s)?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Generate PO',
                confirmButtonColor: '#16a34a',
                cancelButtonColor: '#64748b'
            }).then(r => { if (r.isConfirmed) document.getElementById('reorderPOForm').requestSubmit(); });
        });
    </script>
}
