@model HardwareManagementSystem.ViewModels.PagedResult<HardwareManagementSystem.ViewModels.SupplierPaymentHistoryReportViewModel>
@using HardwareManagementSystem.ViewModels

@{
    ViewData["Title"] = "Supplier Payment History";

    var dateFrom = ViewBag.DateFrom as DateTime? ?? DateTime.Today.AddMonths(-1);
    var dateTo = ViewBag.DateTo as DateTime? ?? DateTime.Today;
    var paymentMethod = ViewBag.PaymentMethod as string;
    var totalPaid = ViewBag.TotalPaid ?? 0;
}

<div class="row g-3 mb-4">

    <div class="col-xl-4 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-cash-coin"></i>
            </div>
            <div class="kpi-label">Total Paid</div>
            <div class="kpi-value text-success">₱@Convert.ToDecimal(totalPaid).ToString("N2")</div>
            <div class="kpi-trend">Supplier payments within selected period</div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-receipt"></i>
            </div>
            <div class="kpi-label">Records Shown</div>
            <div class="kpi-value">@Model.Items.Count()</div>
            <div class="kpi-trend">Current page payments</div>
        </div>
    </div>

</div>

<div class="hb-card">

    <div class="hb-card-header">
        <div>
            <h2 class="hb-section-title">Supplier Payment History</h2>
            <div class="hb-section-subtitle">
                Review all supplier payments posted against stock-in invoices
            </div>
        </div>

        <a asp-controller="Reports"
           asp-action="SupplierPayables"
           class="btn btn-outline-primary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Payables
        </a>
    </div>

    <div class="hb-card-body">

        <form method="get"
              asp-controller="Reports"
              asp-action="SupplierPaymentHistory"
              class="row g-3 mb-4">

            <div class="col-lg-2">
                <label class="form-label fw-semibold">Date From</label>
                <input type="date"
                       name="dateFrom"
                       value="@dateFrom.ToString("yyyy-MM-dd")"
                       class="form-control" />
            </div>

            <div class="col-lg-2">
                <label class="form-label fw-semibold">Date To</label>
                <input type="date"
                       name="dateTo"
                       value="@dateTo.ToString("yyyy-MM-dd")"
                       class="form-control" />
            </div>

            <div class="col-lg-3">
                <label class="form-label fw-semibold">Search</label>
                <input type="text"
                       name="searchTerm"
                       value="@Model.SearchTerm"
                       class="form-control"
                       placeholder="Stock-in #, supplier, reference, user..." />
            </div>

            <div class="col-lg-3">
                <label class="form-label fw-semibold">Payment Method</label>
                <select name="paymentMethod"
                        class="form-select">
                    <option value="">All Methods</option>
                    <option value="Cash" selected="@(paymentMethod == "Cash")">Cash</option>
                    <option value="GCash" selected="@(paymentMethod == "GCash")">GCash</option>
                    <option value="Bank Transfer" selected="@(paymentMethod == "Bank Transfer")">Bank Transfer</option>
                    <option value="Check" selected="@(paymentMethod == "Check")">Check</option>
                </select>
            </div>

            <input type="hidden"
                   name="pageSize"
                   value="@Model.PageSize" />

            <input type="hidden"
                   name="pageNumber"
                   value="1" />

            <div class="col-lg-2 d-flex align-items-end">
                <button type="submit"
                        class="btn btn-primary w-100" data-no-disable="true">
                    <i class="bi bi-funnel me-1"></i>
                    Filter
                </button>
            </div>

            <div class="col-lg-2 d-flex align-items-end">
                <button type="button"
                        id="exportSupplierPaymentHistoryPdfBtn"
                        class="btn btn-danger w-100" data-no-disable="true">
                    <i class="bi bi-file-earmark-pdf me-1"></i>
                    Export PDF
                </button>
            </div>

        </form>

        <div class="table-responsive">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Stock-In #</th>
                        <th>Supplier</th>
                        <th>Amount Paid</th>
                        <th>Method</th>
                        <th>Reference #</th>
                        <th>Remarks</th>
                        <th>Posted By</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Items.Any())
                    {
                        foreach (var row in Model.Items)
                        {
                            <tr>
                                <td>
                                    @row.PaymentDate.ToString("MMM dd, yyyy")
                                    <div class="text-muted small">
                                        @row.PaymentDate.ToString("hh:mm tt")
                                    </div>
                                </td>

                                <td>
                                    <strong>@row.StockInNumber</strong>
                                </td>

                                <td>
                                    @row.SupplierName
                                </td>

                                <td>
                                    <strong class="text-success">
                                        ₱@row.AmountPaid.ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    @if (row.PaymentMethod == "Cash")
                                    {
                                        <span class="badge badge-soft-success">Cash</span>
                                    }
                                    else if (row.PaymentMethod == "GCash")
                                    {
                                        <span class="badge badge-soft-primary">GCash</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-warning">@row.PaymentMethod</span>
                                    }
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(row.ReferenceNumber)
                                                        ? "-"
                                                        : row.ReferenceNumber)
                                                                          </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(row.Remarks)
                                                        ? "-"
                                                        : row.Remarks)
                        </td>

                                <td>
                                    @row.CreatedBy
                                </td>
                            </tr>
                                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8"
                                class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No supplier payment history found.
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        @await Html.PartialAsync(
        "_Pagination",
                PaginationMeta.From(
                Model,
                "Reports",
                "SupplierPaymentHistory",
                new Dictionary<string, string?>
                {
                    ["dateFrom"] = dateFrom.ToString("yyyy-MM-dd"),
                    ["dateTo"] = dateTo.ToString("yyyy-MM-dd"),
                    ["searchTerm"] = Model.SearchTerm,
                    ["paymentMethod"] = paymentMethod
                }))

    </div>

</div>

@section Scripts {

    <script>
        document
            .getElementById('exportSupplierPaymentHistoryPdfBtn')
            .addEventListener('click', function () {

                const dateFrom =
                    document.querySelector('[name="dateFrom"]').value;

                const dateTo =
                    document.querySelector('[name="dateTo"]').value;

                const searchTerm =
                    document.querySelector('[name="searchTerm"]').value;

                const paymentMethod =
                    document.querySelector('[name="paymentMethod"]').value;

                const url =
                    `/Reports/ExportSupplierPaymentHistoryPdf` +
                    `?dateFrom=${encodeURIComponent(dateFrom)}` +
                    `&dateTo=${encodeURIComponent(dateTo)}` +
                    `&searchTerm=${encodeURIComponent(searchTerm)}` +
                    `&paymentMethod=${encodeURIComponent(paymentMethod)}`;

                window.location.href = url;
            });
    </script>

}