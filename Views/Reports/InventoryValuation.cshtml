@model HardwareManagementSystem.ViewModels.PagedResult<HardwareManagementSystem.ViewModels.InventoryValuationViewModel>
@using HardwareManagementSystem.ViewModels
@using HardwareManagementSystem.Models

@{
    ViewData["Title"] = "Inventory Valuation";

    var allBranches = ViewBag.AllBranches as List<Branch>;
    var isGlobal = (bool)(ViewBag.IsGlobalUser ?? false);
    var branchId = ViewBag.BranchId as int?;
    var stockStatus = ViewBag.StockStatus as string;
    decimal totalCostValue = ViewBag.TotalCostValue ?? 0m;
    decimal totalSellingValue = ViewBag.TotalSellingValue ?? 0m;
}

<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon"><i class="bi bi-box-seam"></i></div>
            <div class="kpi-label">Total Products</div>
            <div class="kpi-value">@Model.TotalRecords</div>
            <div class="kpi-trend">Active inventory items</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon"><i class="bi bi-currency-dollar"></i></div>
            <div class="kpi-label">Total Cost Value</div>
            <div class="kpi-value">?@totalCostValue.ToString("N2")</div>
            <div class="kpi-trend">At cost price</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon"><i class="bi bi-tags"></i></div>
            <div class="kpi-label">Total Selling Value</div>
            <div class="kpi-value">?@totalSellingValue.ToString("N2")</div>
            <div class="kpi-trend">At selling price</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon"><i class="bi bi-graph-up"></i></div>
            <div class="kpi-label">Potential Margin</div>
            <div class="kpi-value text-success">?@((totalSellingValue - totalCostValue).ToString("N2"))</div>
            <div class="kpi-trend">Selling - Cost value</div>
        </div>
    </div>

</div>

<div class="hb-card">

    <div class="hb-card-header">
        <div>
            <h2 class="hb-section-title">Inventory Valuation Report</h2>
            <div class="hb-section-subtitle">
                Branch-aware inventory value at cost and selling price
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Reports"
               asp-action="ExportInventoryValuationExcel"
               asp-route-stockStatus="@stockStatus"
               asp-route-branchId="@branchId"
               class="btn btn-success">
                <i class="bi bi-file-earmark-excel me-1"></i>
                Export Excel
            </a>

            <a asp-controller="Reports"
               asp-action="Index"
               class="btn btn-outline-primary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Reports
            </a>
        </div>
    </div>

    <div class="hb-card-body">

        <form method="get" asp-controller="Reports" asp-action="InventoryValuation" class="row g-3 mb-4">

            @if (isGlobal && allBranches != null)
            {
                <div class="col-lg-3">
                    <label class="form-label fw-semibold">Branch</label>
                    <select name="branchId" class="form-select">
                        <option value="0">All Branches</option>
                        @foreach (var b in allBranches)
                        {
                            <option value="@b.Id" selected="@(branchId == b.Id)">@b.Name</option>
                        }
                    </select>
                </div>
            }
            else if (branchId.HasValue)
            {
                <input type="hidden" name="branchId" value="@branchId" />
            }

            <div class="col-lg-3">
                <label class="form-label fw-semibold">Search</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchTerm" class="form-control border-start-0"
                           value="@Model.SearchTerm" placeholder="Code, name, category..." />
                </div>
            </div>

            <div class="col-lg-2">
                <label class="form-label fw-semibold">Stock Status</label>
                <select name="stockStatus" class="form-select">
                    <option value="">All</option>
                    <option value="normal" selected="@(stockStatus == "normal")">Normal</option>
                    <option value="low" selected="@(stockStatus == "low")">Low Stock</option>
                    <option value="out" selected="@(stockStatus == "out")">Out of Stock</option>
                </select>
            </div>

            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <input type="hidden" name="pageNumber" value="1" />

            <div class="col-lg-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100" data-no-disable="true">
                    <i class="bi bi-funnel me-1"></i>
                    Filter
                </button>
            </div>

        </form>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Unit</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Cost Price</th>
                        <th class="text-end">Cost Value</th>
                        <th class="text-end">Selling Value</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><code class="text-primary fw-semibold">@item.ItemCode</code></td>
                                <td><strong>@item.ItemName</strong></td>
                                <td>@item.CategoryName</td>
                                <td>@item.UnitName</td>
                                <td class="text-end">@item.Quantity.ToString("0.###")</td>
                                <td class="text-end">?@item.CostPrice.ToString("N2")</td>
                                <td class="text-end fw-semibold">?@item.CostValue.ToString("N2")</td>
                                <td class="text-end">?@item.SellingValue.ToString("N2")</td>
                                <td>
                                    @if (item.StockStatus == "Out of Stock")
                                    {
                                        <span class="badge badge-soft-danger">Out of Stock</span>
                                    }
                                    else if (item.StockStatus == "Low Stock")
                                    {
                                        <span class="badge badge-soft-warning">Low Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-success">Normal</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No inventory records found.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Pagination", PaginationMeta.From(Model, "Reports", "InventoryValuation",
            new Dictionary<string, string?>
            {
                ["searchTerm"] = Model.SearchTerm,
                ["stockStatus"] = stockStatus,
                ["branchId"] = branchId?.ToString()
            }))

    </div>

</div>
