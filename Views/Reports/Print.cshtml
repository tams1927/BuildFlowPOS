@model HardwareManagementSystem.ViewModels.ReportsDashboardViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <title>
        Reports Print View
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <style>

        body {
            font-family: Arial, sans-serif;
            padding: 30px;
            color: #111827;
        }

        .report-title {
            font-size: 28px;
            font-weight: 700;
        }

        .report-subtitle {
            color: #6b7280;
            margin-bottom: 30px;
        }

        .summary-card {
            border: 1px solid #d1d5db;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .summary-label {
            font-size: 14px;
            color: #6b7280;
        }

        .summary-value {
            font-size: 28px;
            font-weight: 700;
        }

        .section-title {
            font-size: 20px;
            font-weight: 700;
            margin-top: 40px;
            margin-bottom: 15px;
        }

        @@media print {

            .no-print {
                display: none !important;
            }

            body {
                padding: 0;
            }
        }

    </style>

</head>

<body>

    <div class="no-print mb-4">

        <button class="btn btn-primary"
                onclick="window.print()">

            Print Report

        </button>

        <button class="btn btn-secondary"
                onclick="window.close()">

            Close

        </button>

    </div>

    <div class="text-center mb-4">

        <div class="report-title">
            Hardware Supply POS
        </div>

        <div class="report-subtitle">
            Business Summary Report
        </div>

        <div>
            @Model.DateFrom.ToString("MMM dd, yyyy")
            -
            @Model.DateTo.ToString("MMM dd, yyyy")
        </div>

    </div>

    <div class="row">

        <div class="col-4">
            <div class="summary-card">

                <div class="summary-label">
                    Gross Sales
                </div>

                <div class="summary-value">
                    ₱@Model.GrossSales.ToString("N2")
                </div>

            </div>
        </div>

        <div class="col-4">
            <div class="summary-card">

                <div class="summary-label">
                    Net Sales
                </div>

                <div class="summary-value">
                    ₱@Model.NetSales.ToString("N2")
                </div>

            </div>
        </div>

        <div class="col-4">
            <div class="summary-card">

                <div class="summary-label">
                    Collections
                </div>

                <div class="summary-value">
                    ₱@Model.Collections.ToString("N2")
                </div>

            </div>
        </div>

    </div>

    <div class="section-title">
        Financial Summary
    </div>

    <table class="table table-bordered">

        <tbody>

            <tr>
                <th width="40%">
                    Gross Sales
                </th>

                <td>
                    ₱@Model.GrossSales.ToString("N2")
                </td>
            </tr>

            <tr>
                <th>
                    Discounts
                </th>

                <td>
                    ₱@Model.TotalDiscounts.ToString("N2")
                </td>
            </tr>

            <tr>
                <th>
                    Net Sales
                </th>

                <td>
                    ₱@Model.NetSales.ToString("N2")
                </td>
            </tr>

            <tr>
                <th>
                    Transactions
                </th>

                <td>
                    @Model.TransactionCount
                </td>
            </tr>

            <tr>
                <th>
                    Collections
                </th>

                <td>
                    ₱@Model.Collections.ToString("N2")
                </td>
            </tr>

            <tr>
                <th>
                    Returns
                </th>

                <td>
                    ₱@Model.Returns.ToString("N2")
                </td>
            </tr>

            <tr>
                <th>
                    Voided Sales
                </th>

                <td>
                    ₱@Model.VoidedSales.ToString("N2")
                </td>
            </tr>

        </tbody>

    </table>

</body>
</html>