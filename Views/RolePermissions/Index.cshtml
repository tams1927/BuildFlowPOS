@model HardwareManagementSystem.ViewModels.PagedResult<HardwareManagementSystem.Models.RolePermission>
@using HardwareManagementSystem.ViewModels

@{
    ViewData["Title"] = "Role Permissions";

    var roles = ViewBag.Roles as List<string> ?? new();
    var selectedRole = ViewBag.SelectedRole as string ?? "TenantAdmin";
    var permissionList = Model.Items.ToList();
}

<div class="hb-card mb-4">

    <div class="hb-card-header">
        <div>
            <h2 class="hb-section-title">Role Permissions</h2>
            <div class="hb-section-subtitle">
                Control module access per user role
            </div>
        </div>
    </div>

    <div class="hb-card-body">

        <form asp-controller="RolePermissions"
              asp-action="Index"
              method="get"
              class="row g-3 align-items-end">

            <div class="col-md-4">
                <label class="form-label fw-semibold">Select Role</label>

                <select name="role"
                        class="form-select"
                        onchange="this.form.submit()">

                    @foreach (var r in roles)
                    {
                        <option value="@r" selected="@(r == selectedRole ? "selected" : null)">
                            @r
                        </option>
                    }

                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Search Module</label>

                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search"></i>
                    </span>

                    <input type="text"
                           name="searchTerm"
                           class="form-control border-start-0"
                           value="@Model.SearchTerm"
                           placeholder="Search module name..." />
                </div>
            </div>

            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <input type="hidden" name="pageNumber" value="1" />

            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100" data-no-disable="true">
                    <i class="bi bi-funnel me-1"></i>
                    Filter
                </button>
            </div>

        </form>

    </div>

</div>

<div class="hb-card">

    <div class="hb-card-header">
        <div>
            <h2 class="hb-section-title">@selectedRole Access Matrix</h2>
            <div class="hb-section-subtitle">
                Toggle access for each module and action
            </div>
        </div>
    </div>

    <div class="hb-card-body">

        <form asp-controller="RolePermissions"
              asp-action="Update"
              method="post"
              class="confirm-submit">

            @Html.AntiForgeryToken()

            <input type="hidden" name="selectedRole" value="@selectedRole" />
            <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
            <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Module</th>
                            <th>View</th>
                            <th>Create</th>
                            <th>Edit</th>
                            <th>Delete</th>
                            <th>Print</th>
                            <th>Export</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (permissionList.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                        No permissions found.
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            for (int i = 0; i < permissionList.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <strong>@permissionList[i].ModuleName</strong>

                                        <input type="hidden"
                                               name="permissions[@i].Id"
                                               value="@permissionList[i].Id" />

                                        <input type="hidden"
                                               name="permissions[@i].RoleName"
                                               value="@permissionList[i].RoleName" />

                                        <input type="hidden"
                                               name="permissions[@i].ModuleName"
                                               value="@permissionList[i].ModuleName" />
                                    </td>

                                    <td>
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="permissions[@i].CanView"
                                               value="true"
                                               @(permissionList[i].CanView ? "checked" : "") />

                                        <input type="hidden"
                                               name="permissions[@i].CanView"
                                               value="false" />
                                    </td>

                                    <td>
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="permissions[@i].CanCreate"
                                               value="true"
                                               @(permissionList[i].CanCreate ? "checked" : "") />

                                        <input type="hidden"
                                               name="permissions[@i].CanCreate"
                                               value="false" />
                                    </td>

                                    <td>
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="permissions[@i].CanEdit"
                                               value="true"
                                               @(permissionList[i].CanEdit ? "checked" : "") />

                                        <input type="hidden"
                                               name="permissions[@i].CanEdit"
                                               value="false" />
                                    </td>

                                    <td>
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="permissions[@i].CanDelete"
                                               value="true"
                                               @(permissionList[i].CanDelete ? "checked" : "") />

                                        <input type="hidden"
                                               name="permissions[@i].CanDelete"
                                               value="false" />
                                    </td>

                                    <td>
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="permissions[@i].CanPrint"
                                               value="true"
                                               @(permissionList[i].CanPrint ? "checked" : "") />

                                        <input type="hidden"
                                               name="permissions[@i].CanPrint"
                                               value="false" />
                                    </td>

                                    <td>
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="permissions[@i].CanExport"
                                               value="true"
                                               @(permissionList[i].CanExport ? "checked" : "") />

                                        <input type="hidden"
                                               name="permissions[@i].CanExport"
                                               value="false" />
                                    </td>
                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

            <div class="d-flex justify-content-end mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i>
                    Save Permissions
                </button>
            </div>

        </form>

        @await Html.PartialAsync(
        "_Pagination",
                PaginationMeta.From(
                Model,
                "RolePermissions",
                "Index",
                new Dictionary<string, string?>
                {
                    ["role"] = selectedRole,
                    ["searchTerm"] = Model.SearchTerm
                }))

    </div>

</div>

@section Scripts {
    <script>
        document.querySelectorAll('.confirm-submit').forEach(form => {
            form.addEventListener('submit', function (e) {
                e.preventDefault();

                Swal.fire({
                    title: 'Save role permissions?',
                    text: 'This will update access for the selected role.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, save changes',
                    cancelButtonText: 'No, cancel',
                    confirmButtonColor: '#2563eb',
                    cancelButtonColor: '#64748b'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.requestSubmit();
                    }
                });
            });
        });
    </script>
}