@model List<HardwareManagementSystem.Models.SubscriptionPlan>
@{
    ViewData["Title"] = "Subscription Plans";
}

<div class="page-header-row mb-4">
    <div>
        <h2 class="page-section-title">Subscription Plans</h2>
        <p class="text-muted mb-0">Define available SaaS plans for hardware store tenants.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="SubscriptionPlans" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> New Plan
        </a>
        <a asp-controller="SuperAdmin" asp-action="Dashboard" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
{
    @* Success/error toasts handled by layout SweetAlert system *@
}

<div class="hb-card">
    <div class="hb-card-body p-0">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Sort</th>
                    <th>Plan Name</th>
                    <th>Description</th>
                    <th class="text-end">Monthly Price</th>
                    <th class="text-center">Max Branches</th>
                    <th class="text-center">Max Users</th>
                    <th class="text-center">Max Products</th>
                    <th class="text-center">Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="text-muted small">@p.SortOrder</td>
                        <td class="fw-semibold">@p.Name</td>
                        <td class="text-muted small">@(p.Description ?? "—")</td>
                        <td class="text-end fw-semibold">₱@p.MonthlyPrice.ToString("N2")</td>
                        <td class="text-center">@p.MaxBranches</td>
                        <td class="text-center">@p.MaxUsers</td>
                        <td class="text-center">@p.MaxProducts</td>
                        <td class="text-center">
                            @if (p.IsActive)
                            {
                                <span class="badge badge-soft-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-soft-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end">
                                <!-- Edit -->
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <!-- Activate / Deactivate -->
                                @if (p.IsActive)
                                {
                                    <form asp-action="Deactivate" asp-route-id="@p.Id" method="post" class="d-inline plan-toggle-form">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-toggle-plan"
                                                data-plan-name="@p.Name" data-action="deactivate" title="Deactivate">
                                            <i class="bi bi-toggle-on"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activate" asp-route-id="@p.Id" method="post" class="d-inline plan-toggle-form">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="btn btn-sm btn-outline-success btn-toggle-plan"
                                                data-plan-name="@p.Name" data-action="activate" title="Activate">
                                            <i class="bi bi-toggle-off"></i>
                                        </button>
                                    </form>
                                }

                                <!-- Delete -->
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline plan-delete-form">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-delete-plan"
                                            data-plan-name="@p.Name" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">No plans configured yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
(function () {
    // Activate / Deactivate
    document.querySelectorAll('.btn-toggle-plan').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var form   = this.closest('form');
            var name   = this.dataset.planName || 'this plan';
            var action = this.dataset.action;
            var isActivate = action === 'activate';
            Swal.fire({
                title: (isActivate ? 'Activate' : 'Deactivate') + ' plan?',
                html: (isActivate ? 'Activate' : 'Deactivate') + ' plan <strong>' + name + '</strong>?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: isActivate ? '#198754' : '#6c757d',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, ' + action,
                cancelButtonText: 'Cancel'
            }).then(function (r) { if (r.isConfirmed) form.submit(); });
        });
    });

    // Delete
    document.querySelectorAll('.btn-delete-plan').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var form = this.closest('form');
            var name = this.dataset.planName || 'this plan';
            Swal.fire({
                title: 'Delete plan?',
                html: 'Delete plan <strong>' + name + '</strong>? This cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete',
                cancelButtonText: 'Cancel'
            }).then(function (r) { if (r.isConfirmed) form.submit(); });
        });
    });
})();
</script>
}
