@model HardwareManagementSystem.Models.SubscriptionPlan
@{
    ViewData["Title"] = "New Plan";
}

<div class="page-header-row mb-3">
    <h2 class="page-section-title">New Subscription Plan</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" class="confirm-submit">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Name" class="form-label fw-semibold">Plan Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Starter, Business, Enterprise" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MonthlyPrice" class="form-label fw-semibold">Monthly Price (₱)</label>
                    <input asp-for="MonthlyPrice" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="MonthlyPrice" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="SortOrder" class="form-label fw-semibold">Sort Order</label>
                    <input asp-for="SortOrder" class="form-control" type="number" min="0" />
                    <span asp-validation-for="SortOrder" class="text-danger small"></span>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active</label>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold">Description</label>
                    <input asp-for="Description" class="form-control" placeholder="Brief plan summary..." maxlength="300" />
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MaxBranches" class="form-label fw-semibold">Max Branches</label>
                    <input asp-for="MaxBranches" class="form-control" type="number" min="1" />
                    <span asp-validation-for="MaxBranches" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MaxUsers" class="form-label fw-semibold">Max Users</label>
                    <input asp-for="MaxUsers" class="form-control" type="number" min="1" />
                    <span asp-validation-for="MaxUsers" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MaxProducts" class="form-label fw-semibold">Max Products</label>
                    <input asp-for="MaxProducts" class="form-control" type="number" min="1" />
                    <span asp-validation-for="MaxProducts" class="text-danger small"></span>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create Plan</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
