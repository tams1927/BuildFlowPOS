@model HardwareManagementSystem.ViewModels.ImportMappingViewModel
@using HardwareManagementSystem.Services

@{
    ViewData["Title"] = "Column Mapping";
}

<div class="hb-card mb-4">

    <div class="hb-card-header">
        <div>
            <h2 class="hb-section-title">Column Mapping</h2>
            <div class="hb-section-subtitle">
                Map your Excel columns to system fields for <strong>@Model.ImportType</strong> import (Batch #@Model.BatchId)
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Start Over
        </a>
    </div>

    <div class="hb-card-body">

        <!-- STEP INDICATOR -->
        <div class="d-flex align-items-center gap-2 mb-4">
            <span class="badge bg-success px-3 py-2"><i class="bi bi-check"></i> Upload</span>
            <i class="bi bi-chevron-right text-muted"></i>
            <span class="badge bg-primary px-3 py-2">2 Mapping</span>
            <i class="bi bi-chevron-right text-muted"></i>
            <span class="badge bg-secondary px-3 py-2">3 Preview</span>
            <i class="bi bi-chevron-right text-muted"></i>
            <span class="badge bg-secondary px-3 py-2">4 Confirm</span>
            <i class="bi bi-chevron-right text-muted"></i>
            <span class="badge bg-secondary px-3 py-2">5 Result</span>
        </div>

        <form asp-action="Mapping" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="batchId" value="@Model.BatchId" />

            <div class="alert alert-warning border-0 rounded-3 mb-4 small">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Please re-upload the same Excel file, then map each system field to its corresponding Excel column below.
                Fields marked <span class="text-danger fw-bold">*</span> are required.
            </div>

            <!-- RE-UPLOAD FILE -->
            <div class="mb-4">
                <label class="form-label fw-semibold">Re-upload Excel File <span class="text-danger">*</span></label>
                <input type="file" name="previewFile" class="form-control" accept=".xlsx,.xls" required />
            </div>

            <!-- MAPPING TABLE -->
            <div class="table-responsive mb-4">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width:40%">System Field</th>
                            <th>Map to Excel Column</th>
                            <th style="width:80px">Required</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var required = HardwareManagementSystem.Services.ExcelImportService.RequiredFields
                                .TryGetValue(Model.ImportType, out var req) ? req : new List<string>();
                        }
                        @foreach (var field in Model.Mapping)
                        {
                            var isRequired = required.Contains(field.Key);
                            <tr>
                            <td>
                                    <span class="fw-semibold">@ExcelImportService.GetDisplayName(field.Key)</span>
                                    @if (isRequired)
                                    {
                                        <span class="text-danger ms-1">*</span>
                                    }
                                    <div class="text-muted small">Field: <code>@field.Key</code></div>
                                </td>
                                <td>
                                    <select name="mapping_@field.Key" class="form-select form-select-sm">
                                        <option value="">-- Skip / Not Mapped --</option>
                                        @foreach (var header in Model.ExcelHeaders)
                                        {
                                            <option value="@header" selected="@(field.Value == header)">@header</option>
                                        }
                                    </select>
                                </td>
                                <td class="text-center">
                                    @if (isRequired)
                                    {
                                        <span class="badge badge-soft-danger">Required</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-secondary">Optional</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Cancel
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-eye me-1"></i>
                    Preview Rows
                </button>
            </div>

        </form>

    </div>

</div>
