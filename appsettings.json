{
  "ConnectionStrings": {
    "DefaultConnection": "#{DB_CONNECTION_STRING}#"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "SeedSettings": {
    "InitialSuperAdminPassword": ""
  },

  "BackupSettings": {
    "RootPath": "C:\\HardBuildBackups\\",
    "RetentionDays": 14,
    "EnableScheduledBackups": false,
    "ScheduledBackupHour": 2,
    "AllowTenantBackupRequest": true,
    "RestoreDataPath": "",
    "RestoreLogPath": ""
  }
}
